import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Trareon Acquire";
    preferred-width: 780px;
    preferred-height: 640px;

    in-out property <int> mode-index: 0;
    in-out property <string> mode-guidance: "";
    in-out property <bool> show-path-editors: false;
    in-out property <string> case-identity: "";
    in-out property <string> source-path: "";
    in-out property <string> output-dir: "";
    in-out property <bool> confirmed-synthetic: false;
    in-out property <string> status-line: "Ready — Lab Use Only (Engineering Alpha)";
    in-out property <string> last-package: "(none)";
    in-out property <string> evidence-sha256: "(none)";
    in-out property <string> evidence-size: "(none)";
    in-out property <string> preflight-hint: "";
    in-out property <bool> busy: false;
    property <bool> can-run: root.confirmed-synthetic && root.source-path != "" && root.output-dir != "" && !root.busy;

    callback browse-source-clicked();
    callback browse-output-clicked();
    callback run-clicked();
    callback cancel-clicked();
    callback clear-clicked();
    callback fill-synthetic-clicked();
    callback export-coc-clicked();
    callback mode-changed(int);

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Trareon Acquire — Foundation Demo";
            font-size: 22px;
            font-weight: 700;
        }

        Text {
            text: "Engineering Alpha — Lab Use Only. Not validated for production evidence.";
            font-size: 13px;
            wrap: word-wrap;
        }

        Text { text: "Mode"; font-size: 12px; }
        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Guided";
                enabled: !root.busy;
                primary: root.mode-index == 0;
                clicked => { root.mode-changed(0); }
            }
            Button {
                text: "Standard";
                enabled: !root.busy;
                primary: root.mode-index == 1;
                clicked => { root.mode-changed(1); }
            }
            Button {
                text: "Expert";
                enabled: !root.busy;
                primary: root.mode-index == 2;
                clicked => { root.mode-changed(2); }
            }
        }
        Text {
            text: root.mode-guidance;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: "Case identity (operator note only — not in audit/verify)";
            font-size: 12px;
        }
        LineEdit {
            text <=> root.case-identity;
            enabled: !root.busy;
            placeholder-text: "e.g. TRN-2026-0001";
        }

        if root.show-path-editors: VerticalBox {
            spacing: 10px;
            Text { text: "Source path"; font-size: 12px; }
            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.source-path;
                    enabled: !root.busy;
                    placeholder-text: "/path/to/synthetic-source.img";
                }
                Button {
                    text: "Browse…";
                    enabled: !root.busy;
                    clicked => { root.browse-source-clicked(); }
                }
            }
            Text { text: "Output directory"; font-size: 12px; }
            HorizontalBox {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.output-dir;
                    enabled: !root.busy;
                    placeholder-text: "/path/to/output";
                }
                Button {
                    text: "Browse…";
                    enabled: !root.busy;
                    clicked => { root.browse-output-clicked(); }
                }
            }
        }

        CheckBox {
            text: "I confirm the source is a synthetic or training file, not real evidence.";
            checked <=> root.confirmed-synthetic;
            enabled: !root.busy;
        }

        Text {
            text: root.preflight-hint;
            font-size: 12px;
            wrap: word-wrap;
            visible: root.preflight-hint != "";
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: root.busy ? "Running…" : "Run";
                primary: true;
                enabled: root.can-run;
                clicked => { root.run-clicked(); }
            }
            Button {
                text: "Cancel";
                enabled: root.busy;
                clicked => { root.cancel-clicked(); }
            }
            Button {
                text: "Fill synthetic demo paths";
                enabled: !root.busy;
                clicked => { root.fill-synthetic-clicked(); }
            }
            Button {
                text: "Export CoC JSON";
                enabled: !root.busy && root.last-package != "(none)";
                clicked => { root.export-coc-clicked(); }
            }
            Button {
                text: "Clear";
                enabled: !root.busy;
                clicked => { root.clear-clicked(); }
            }
        }

        Text {
            text: "Status: " + root.status-line;
            font-size: 14px;
            wrap: word-wrap;
        }
        Text {
            text: "Package: " + root.last-package;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: "SHA-256: " + root.evidence-sha256;
            font-size: 12px;
            wrap: word-wrap;
        }
        Text {
            text: "Size: " + root.evidence-size + " bytes";
            font-size: 12px;
        }

        Text {
            text: "About: Trareon Acquire — Engineering Alpha / Lab Use Only. GPLv3. Unsigned Founder builds until Gate 3. Not court-admissible. UI cancel arms core cancel_flag; success only after independent verify.";
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
