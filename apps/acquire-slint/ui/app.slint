// Trareon Acquire — Acquisition Bench
// Operator job: Prepare → Acquire → Seal. One primary CTA at a time.
// Design: .cursor/skills/frontend-design/DESIGN-TRAREON-ACQUIRE.md

import { LineEdit, CheckBox, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
    horizontal-stretch: 1;
}

component Eyebrow inherits Text {
    in property <string> label;
    text: root.label;
    color: Theme.faint;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    font-family: "Avenir Next";
}

// Quiet prefs chip — filled copper reserved for primary actions only
component PrefChip inherits Rectangle {
    callback clicked;
    in property <string> label;
    in property <bool> active;
    height: 26px;
    min-width: 40px;
    background: root.active ? Theme.raised : transparent;
    border-radius: 4px;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.focus-ring : Theme.copper-dim;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.readout : Theme.faint;
            font-size: 11px;
            font-weight: root.active ? 700 : 500;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StepBadge inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> done;
    height: 28px;
    border-radius: 4px;
    background: root.done ? Theme.ok-mist : root.active ? Theme.raised : transparent;
    border-width: 1px;
    border-color: root.done ? Theme.ok-glow : root.active ? Theme.copper-dim : Theme.hairline;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.done ? Theme.ok-glow : root.active ? Theme.readout : Theme.faint;
            font-size: 11px;
            font-weight: 600;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
}

component ModeRailItem inherits Rectangle {
    callback clicked;
    in property <string> label;
    in property <string> hint;
    in property <bool> active;
    in property <bool> enabled: true;
    height: 50px;
    background: root.active ? Theme.rail-active : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        alignment: center;
        Rectangle {
            width: 3px;
            height: 26px;
            border-radius: 1.5px;
            background: root.active ? Theme.copper : transparent;
            vertical-stretch: 0;
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.label;
                color: root.active ? Theme.readout : Theme.mute;
                font-size: 13px;
                font-weight: root.active ? 600 : 500;
                font-family: "Avenir Next";
            }
            Text {
                text: root.hint;
                color: root.active ? Theme.copper-dim : Theme.faint;
                font-size: 11px;
                font-family: "Avenir Next";
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FieldShell inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    height: 40px;
    background: Theme.raised;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 4px;
        padding-bottom: 4px;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.text;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
        }
    }
}

component ActionButton inherits Rectangle {
    callback clicked;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> ghost: false;
    height: 42px;
    min-width: 108px;
    border-radius: 5px;
    background: root.primary && root.enabled ? Theme.copper
        : root.primary && !root.enabled ? Theme.primary-disabled
        : root.ghost ? transparent
        : Theme.raised;
    border-width: root.primary && root.enabled ? 0px
        : root.ghost ? 0px
        : 1px;
    border-color: root.primary ? Theme.copper-dim
        : root.danger && root.enabled ? Theme.deny
        : Theme.hairline;
    opacity: root.enabled || root.primary ? 1.0 : 0.4;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.label;
            color: root.primary && root.enabled ? Theme.on-copper
                : root.primary && !root.enabled ? Theme.copper-dim
                : root.danger && root.enabled ? Theme.deny
                : !root.enabled ? Theme.faint
                : Theme.readout;
            font-size: 13px;
            font-weight: root.primary ? 700 : 500;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Panel inherits Rectangle {
    background: Theme.seal-well;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;
    @children
}

export component AppWindow inherits Window {
    title: "Trareon Acquire";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 780px;
    min-height: 620px;
    background: Theme.void;

    in-out property <int> mode-index: 0;
    in-out property <string> mode-guidance: "";
    in-out property <bool> show-path-editors: false;
    in-out property <string> case-identity: "";
    in-out property <string> case-id: "";
    in-out property <string> source-path: "";
    in-out property <string> output-dir: "";
    in-out property <bool> confirmed-synthetic: false;
    in-out property <string> status-line: "";
    in-out property <string> last-package: "(none)";
    in-out property <string> evidence-sha256: "(none)";
    in-out property <string> evidence-size: "(none)";
    in-out property <string> preflight-hint: "";
    in-out property <bool> preflight-is-deny: false;
    in-out property <bool> busy: false;
    in-out property <bool> dark-mode: false;
    in-out property <string> locale: "en";
    // Navigation: 0 = Acquire bench; 1–7 = wired workflow surfaces.
    in-out property <int> nav-index: 0;
    in-out property <string> about-text: "";
    in-out property <float> progress-fraction: 0.0;
    in-out property <string> progress-label: "";
    in-out property <string> progress-phase: "";
    // Instrument strip (FTK Imager / Guymager / Autopsy status pattern)
    in-out property <string> write-blocker-line: "Write-blocker: —";
    in-out property <bool> write-blocker-ready: true;
    in-out property <bool> wb-confirmed: false;
    in-out property <bool> blockish-source: false;
    // Wave 0–2 telemetry / format / CoC
    in-out property <string> panel-detail: "";
    in-out property <string> disk-list: "";
    in-out property <string> custody-timeline-text: "";
    in-out property <string> throughput-label: "— MiB/s";
    in-out property <string> eta-label: "ETA —";
    in-out property <float> coverage-ok: 0.0;
    in-out property <float> coverage-err: 0.0;
    in-out property <int> format-index: 0;
    in-out property <string> format-caption: "RAW + .fsnap (court path A)";
    in-out property <bool> write-sha512: true;
    in-out property <string> segment-mib: "64";
    in-out property <string> evidence-sha512: "(none)";
    in-out property <bool> id-power: false;
    in-out property <bool> id-network: false;
    in-out property <bool> id-encryption: false;
    in-out property <bool> id-anti: false;
    in-out property <bool> id-oov: false;
    in-out property <string> case-title: "";
    in-out property <string> boot-image-path: "";
    in-out property <int> profile-index: 1;
    in-out property <string> profile-caption: "Standard — full file/disk acquire";
    in-out property <int> source-kind-index: 0;
    in-out property <string> source-kind-caption: "Disk — host enumerator / PhysicalDrive";
    in-out property <int> retry-index: 0;
    in-out property <string> retry-caption: "imaging_policy=skip & log (lab default)";
    in-out property <string> coc-device: "";
    in-out property <string> coc-media: "1";
    in-out property <string> coc-seq: "1";
    in-out property <string> coc-description: "";
    in-out property <string> compare-package-b: "";
    in-out property <string> multisource-b: "";
    in-out property <float> phase-opacity: 1.0;

    property <bool> can-run: root.confirmed-synthetic && root.source-path != "" && root.output-dir != "" && !root.busy && (root.mode-index == 0 || root.case-id != "");
    property <bool> has-package: root.last-package != "(none)";
    property <bool> has-hash: root.evidence-sha256 != "(none)";
    property <bool> prepared: root.source-path != "" && root.output-dir != "" && root.confirmed-synthetic;
    property <bool> guided: root.mode-index == 0;
    // In Guided with nothing ready, "Load demo" is the one primary action.
    property <bool> demo-is-primary: root.guided && !root.can-run && !root.busy;
    property <string> display-package: root.has-package ? root.last-package : Strings.none-label;
    property <string> display-hash: root.has-hash ? root.evidence-sha256 : Strings.none-label;
    property <string> display-size: root.evidence-size == "(none)" ? "—" : root.evidence-size + " B";
    property <string> session-state: root.busy ? Strings.state-running : root.has-hash ? Strings.state-sealed : Strings.state-standby;
    property <string> integrity-chip: root.busy ? Strings.integrity-running
        : root.has-hash ? Strings.integrity-sealed
        : root.prepared ? Strings.integrity-ready
        : Strings.integrity-standby;
    property <string> case-chip: root.case-id == "" ? "—" : root.case-id;
    property <string> panel-title:
        root.nav-index == 1 ? Strings.shell-cases-title
        : root.nav-index == 2 ? Strings.shell-identify-title
        : root.nav-index == 3 ? Strings.shell-triage-title
        : root.nav-index == 4 ? Strings.shell-tools-title
        : root.nav-index == 5 ? Strings.shell-qms-title
        : root.nav-index == 6 ? Strings.shell-boot-title
        : root.nav-index == 7 ? Strings.shell-help-title
        : Strings.about-build;
    property <string> panel-body:
        root.nav-index == 1 ? Strings.shell-cases-body
        : root.nav-index == 2 ? Strings.shell-identify-body
        : root.nav-index == 3 ? Strings.shell-triage-body
        : root.nav-index == 4 ? Strings.shell-tools-body
        : root.nav-index == 5 ? Strings.shell-qms-body
        : root.nav-index == 6 ? Strings.shell-boot-body
        : root.nav-index == 7 ? Strings.shell-help-body
        : root.about-text;
    property <int> wizard-step: !root.prepared && root.case-id == "" ? 0
        : !root.prepared && root.source-path == "" ? 1
        : root.blockish-source && !root.write-blocker-ready ? 2
        : !root.confirmed-synthetic ? 3
        : root.has-hash ? 5
        : 4;

    callback browse-source-clicked();
    callback browse-output-clicked();
    callback run-clicked();
    callback cancel-clicked();
    callback clear-clicked();
    callback fill-synthetic-clicked();
    callback export-coc-clicked();
    callback mode-changed(int);
    callback theme-toggled(bool);
    callback locale-toggled(string);
    callback instrument-refresh();
    callback refresh-disks-clicked();
    callback use-first-disk-clicked();
    callback refresh-cases-clicked();
    callback create-case-clicked();
    callback save-identify-clicked();
    callback probe-encryption-clicked();
    callback verify-package-clicked();
    callback hash-only-clicked();
    callback run-qms-clicked();
    callback run-triage-clicked();
    callback boot-plan-clicked();
    callback analysis-lite-clicked();
    callback format-changed(int);
    callback browse-package-clicked();
    callback profile-changed(int);
    callback source-kind-changed(int);
    callback retry-changed(int);
    callback export-full-coc-clicked();
    callback compare-packages-clicked();
    callback export-report-clicked();
    callback run-profile-clicked();
    callback multisource-clicked();
    callback browse-compare-clicked();

    init => {
        Theme.apply(root.dark-mode);
        Strings.locale = root.locale;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Theme.apply(root.dark-mode);
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed locale => { Strings.locale = root.locale; }
    changed source-path => { root.instrument-refresh(); }
    changed wb-confirmed => { root.instrument-refresh(); }

    HorizontalLayout {
        spacing: 0;

        // Mode rail — pick once, then work
        Rectangle {
            width: 168px;
            background: Theme.ink;
            VerticalLayout {
                padding-top: 22px;
                padding-bottom: 16px;
                spacing: 0;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 4px;
                    Text {
                        text: "TRAREON";
                        color: Theme.readout;
                        font-family: "Avenir Next";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 2.8px;
                    }
                    Text {
                        text: Strings.brand-product;
                        color: Theme.copper;
                        font-family: "Avenir Next";
                        font-size: 22px;
                        font-weight: 600;
                    }
                    Text {
                        text: Strings.evidence-station;
                        color: Theme.faint;
                        font-size: 11px;
                        font-family: "Avenir Next";
                    }
                }

                Rectangle { height: 16px; background: transparent; }
                VerticalLayout {
                    padding-left: 14px;
                    Eyebrow { label: Strings.rail-workflow; }
                }
                Rectangle { height: 4px; background: transparent; }

                // ISO/IEC 27037-aligned order: Cases → Identify → Acquire → Triage
                ModeRailItem {
                    label: Strings.nav-cases;
                    hint: Strings.hint-cases;
                    active: root.nav-index == 1;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 1; }
                }
                ModeRailItem {
                    label: Strings.nav-identify;
                    hint: Strings.hint-identify;
                    active: root.nav-index == 2;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 2; }
                }
                ModeRailItem {
                    label: Strings.nav-acquire;
                    hint: Strings.hint-acquire;
                    active: root.nav-index == 0;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 0; }
                }
                ModeRailItem {
                    label: Strings.nav-triage;
                    hint: Strings.hint-triage;
                    active: root.nav-index == 3;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 3; }
                }

                if root.nav-index == 0: VerticalLayout {
                    spacing: 0;
                    Rectangle { height: 12px; background: transparent; }
                    VerticalLayout {
                        padding-left: 14px;
                        Eyebrow { label: Strings.operator-mode; }
                    }
                    Rectangle { height: 4px; background: transparent; }
                    ModeRailItem {
                        label: Strings.mode-guided;
                        hint: Strings.hint-guided;
                        active: root.mode-index == 0;
                        enabled: !root.busy;
                        clicked => { root.mode-changed(0); }
                    }
                    ModeRailItem {
                        label: Strings.mode-standard;
                        hint: Strings.hint-standard;
                        active: root.mode-index == 1;
                        enabled: !root.busy;
                        clicked => { root.mode-changed(1); }
                    }
                    ModeRailItem {
                        label: Strings.mode-expert;
                        hint: Strings.hint-expert;
                        active: root.mode-index == 2;
                        enabled: !root.busy;
                        clicked => { root.mode-changed(2); }
                    }
                }

                Rectangle { height: 12px; background: transparent; }
                VerticalLayout {
                    padding-left: 14px;
                    Eyebrow { label: Strings.rail-lab; }
                }
                Rectangle { height: 4px; background: transparent; }
                ModeRailItem {
                    label: Strings.nav-tools;
                    hint: Strings.hint-tools;
                    active: root.nav-index == 4;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 4; }
                }
                ModeRailItem {
                    label: Strings.nav-qms;
                    hint: Strings.hint-qms;
                    active: root.nav-index == 5;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 5; }
                }
                ModeRailItem {
                    label: Strings.nav-boot;
                    hint: Strings.hint-boot;
                    active: root.nav-index == 6;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 6; }
                }

                Rectangle { height: 12px; background: transparent; }
                VerticalLayout {
                    padding-left: 14px;
                    Eyebrow { label: Strings.rail-support; }
                }
                Rectangle { height: 4px; background: transparent; }
                ModeRailItem {
                    label: Strings.nav-help;
                    hint: Strings.hint-help;
                    active: root.nav-index == 7;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 7; }
                }
                ModeRailItem {
                    label: Strings.nav-about;
                    hint: Strings.hint-about;
                    active: root.nav-index == 8;
                    enabled: !root.busy;
                    clicked => { root.nav-index = 8; }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 6px;
                    Hairline {}
                    Text {
                        text: Strings.lab-only;
                        color: Theme.copper-dim;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                        font-family: "Avenir Next";
                    }
                    Text {
                        text: Strings.alpha-line;
                        color: Theme.faint;
                        font-size: 11px;
                        font-family: "Avenir Next";
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.hairline; }

        // Bench
        Rectangle {
            background: Theme.panel;
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0;

                // Thin chrome: status + quiet prefs
                Rectangle {
                    background: Theme.panel;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 14px;
                        padding-bottom: 12px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: root.session-state;
                                color: root.busy ? Theme.copper-hot : root.has-hash ? Theme.ok-glow : Theme.mute;
                                font-size: 12px;
                                font-weight: 700;
                                font-family: "Avenir Next";
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "·";
                                color: Theme.faint;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.status-line;
                                color: Theme.mute;
                                font-size: 12px;
                                font-family: "Avenir Next";
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                background: Theme.badge-bg;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    Text {
                                        text: Strings.founder-badge;
                                        color: Theme.faint;
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        font-family: "Avenir Next";
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.raised;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                HorizontalLayout {
                                    padding: 2px;
                                    PrefChip {
                                        label: Strings.lang-en;
                                        active: root.locale == "en";
                                        clicked => { root.locale-toggled("en"); }
                                    }
                                    PrefChip {
                                        label: Strings.lang-id;
                                        active: root.locale == "id";
                                        clicked => { root.locale-toggled("id"); }
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.raised;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                HorizontalLayout {
                                    padding: 2px;
                                    PrefChip {
                                        label: Strings.theme-dark;
                                        active: root.dark-mode;
                                        clicked => { root.theme-toggled(true); }
                                    }
                                    PrefChip {
                                        label: Strings.theme-light;
                                        active: !root.dark-mode;
                                        clicked => { root.theme-toggled(false); }
                                    }
                                }
                            }
                        }

                        if root.nav-index == 0: HorizontalLayout {
                            spacing: 8px;
                            StepBadge {
                                label: Strings.step-prepare;
                                active: !root.prepared && !root.has-hash;
                                done: root.prepared || root.has-hash;
                            }
                            StepBadge {
                                label: Strings.step-run;
                                active: root.can-run || root.busy;
                                done: root.has-hash;
                            }
                            StepBadge {
                                label: Strings.step-seal;
                                active: root.has-hash;
                                done: root.has-hash;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }

                        // Instrument strip — always visible (peer status area pattern)
                        Rectangle {
                            background: Theme.pipeline-bg;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.hairline;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 16px;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: Strings.chip-case;
                                        color: Theme.faint;
                                        font-size: 9px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        font-family: "Avenir Next";
                                    }
                                    Text {
                                        text: root.case-chip;
                                        color: root.case-id == "" ? Theme.faint : Theme.readout;
                                        font-size: 12px;
                                        font-family: "Menlo";
                                        font-weight: 500;
                                    }
                                }
                                Rectangle { width: 1px; background: Theme.hairline; }
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: Strings.chip-wb;
                                        color: Theme.faint;
                                        font-size: 9px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        font-family: "Avenir Next";
                                    }
                                    Text {
                                        text: root.write-blocker-line;
                                        color: root.write-blocker-ready ? Theme.ok-glow : Theme.deny;
                                        font-size: 12px;
                                        font-family: "Avenir Next";
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle { width: 1px; background: Theme.hairline; }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: Strings.chip-integrity;
                                        color: Theme.faint;
                                        font-size: 9px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        font-family: "Avenir Next";
                                    }
                                    Text {
                                        text: root.integrity-chip;
                                        color: root.busy ? Theme.copper-hot
                                            : root.has-hash ? Theme.ok-glow
                                            : root.prepared ? Theme.readout
                                            : Theme.mute;
                                        font-size: 12px;
                                        font-weight: 700;
                                        font-family: "Avenir Next";
                                    }
                                }
                            }
                        }
                    }
                }

                Hairline {}

                Rectangle {
                    background: Theme.warning;
                    border-width: 1px;
                    border-color: Theme.focus-ring;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        Text {
                            text: Strings.unsigned-banner;
                            color: Theme.on-copper;
                            font-size: 11px;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: parent.width;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 14px;

                        if root.nav-index != 0: Panel {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Text {
                                    text: root.panel-title;
                                    color: Theme.copper;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                    font-family: "Avenir Next";
                                }
                                Text {
                                    text: root.panel-body;
                                    color: Theme.readout;
                                    font-size: 14px;
                                    font-family: "Avenir Next";
                                    wrap: word-wrap;
                                }
                                if root.nav-index == 1: VerticalLayout {
                                    spacing: 8px;
                                    FieldShell { text <=> root.case-title; placeholder: "Case title"; enabled: !root.busy; }
                                    FieldShell { text <=> root.case-identity; placeholder: Strings.case-placeholder; enabled: !root.busy; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.create-case; primary: true; enabled: !root.busy; clicked => { root.create-case-clicked(); } }
                                        ActionButton { label: Strings.refresh-cases; enabled: !root.busy; clicked => { root.refresh-cases-clicked(); } }
                                    }
                                }
                                if root.nav-index == 2: VerticalLayout {
                                    spacing: 6px;
                                    CheckBox { text: "Power documented"; checked <=> root.id-power; enabled: !root.busy; }
                                    CheckBox { text: "Network isolated"; checked <=> root.id-network; enabled: !root.busy; }
                                    CheckBox { text: "Encryption probed"; checked <=> root.id-encryption; enabled: !root.busy; }
                                    CheckBox { text: "Anti-forensics reviewed"; checked <=> root.id-anti; enabled: !root.busy; }
                                    CheckBox { text: "Out-of-view acknowledged"; checked <=> root.id-oov; enabled: !root.busy; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.probe-encryption; enabled: !root.busy; clicked => { root.probe-encryption-clicked(); } }
                                        ActionButton { label: Strings.save-identify; primary: true; enabled: !root.busy; clicked => { root.save-identify-clicked(); } }
                                    }
                                }
                                if root.nav-index == 3: HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton { label: Strings.run-triage; primary: true; enabled: !root.busy; clicked => { root.run-triage-clicked(); } }
                                    ActionButton { label: Strings.analysis-lite; enabled: !root.busy; clicked => { root.analysis-lite-clicked(); } }
                                }
                                if root.nav-index == 4: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.run-verify; primary: true; enabled: !root.busy; clicked => { root.verify-package-clicked(); } }
                                        ActionButton { label: Strings.run-hash; enabled: !root.busy; clicked => { root.hash-only-clicked(); } }
                                        ActionButton { label: "Browse .fsnap"; enabled: !root.busy; clicked => { root.browse-package-clicked(); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.compare-packages; enabled: !root.busy; clicked => { root.compare-packages-clicked(); } }
                                        ActionButton { label: Strings.browse-compare; enabled: !root.busy; clicked => { root.browse-compare-clicked(); } }
                                        ActionButton { label: Strings.export-report; enabled: !root.busy; clicked => { root.export-report-clicked(); } }
                                    }
                                    Text {
                                        text: root.compare-package-b == "" ? Strings.compare-hint : root.compare-package-b;
                                        color: Theme.mute;
                                        font-size: 11px;
                                        font-family: "Menlo";
                                        wrap: word-wrap;
                                    }
                                }
                                if root.nav-index == 5: ActionButton {
                                    label: Strings.run-qms; primary: true; enabled: !root.busy; clicked => { root.run-qms-clicked(); }
                                }
                                if root.nav-index == 6: VerticalLayout {
                                    spacing: 8px;
                                    FieldShell { text <=> root.boot-image-path; placeholder: "Boot image path"; enabled: !root.busy; }
                                    ActionButton { label: Strings.boot-plan; primary: true; enabled: !root.busy; clicked => { root.boot-plan-clicked(); } }
                                }
                                if root.nav-index == 7: VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.nav-cases; enabled: !root.busy; clicked => { root.nav-index = 1; } }
                                        ActionButton { label: Strings.nav-identify; primary: true; enabled: !root.busy; clicked => { root.nav-index = 2; } }
                                        ActionButton { label: Strings.nav-acquire; enabled: !root.busy; clicked => { root.nav-index = 0; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.nav-tools; enabled: !root.busy; clicked => { root.nav-index = 4; } }
                                        ActionButton { label: Strings.nav-triage; enabled: !root.busy; clicked => { root.nav-index = 3; } }
                                        ActionButton { label: Strings.nav-qms; enabled: !root.busy; clicked => { root.nav-index = 5; } }
                                    }
                                    Text { text: Strings.help_wb; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    Text { text: Strings.help_oov; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    Text { text: Strings.help_seal_vs_sig; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    Text { text: Strings.help_formats; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    Text { text: Strings.help_shortcuts; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                }
                                if root.panel-detail != "": Text {
                                    text: root.panel-detail;
                                    color: Theme.readout;
                                    font-size: 12px;
                                    font-family: "Menlo";
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Strings.nav-acquire;
                                    primary: root.nav-index != 4;
                                    enabled: !root.busy;
                                    clicked => { root.nav-index = 0; }
                                }
                            }
                        }

                        // Wave 0 guided wizard (IMF 2011 Q&A)
                        if root.nav-index == 0: HorizontalLayout {
                            spacing: 6px;
                            StepBadge { label: Strings.wizard-case; active: root.wizard-step == 0; done: root.wizard-step > 0; }
                            StepBadge { label: Strings.wizard-source; active: root.wizard-step == 1; done: root.wizard-step > 1; }
                            StepBadge { label: Strings.wizard-wb; active: root.wizard-step == 2; done: root.wizard-step > 2; }
                            StepBadge { label: Strings.wizard-confirm; active: root.wizard-step == 3; done: root.wizard-step > 3; }
                            StepBadge { label: Strings.wizard-start; active: root.wizard-step == 4; done: root.wizard-step >= 5; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }

                        // STEP 1 — Prepare (Acquire bench only)
                        if root.nav-index == 0: Panel {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                HorizontalLayout {
                                    Text {
                                        text: Strings.step-prepare;
                                        color: Theme.copper;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1.2px;
                                        font-family: "Avenir Next";
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text {
                                        text: root.prepared ? Strings.ready-hint : Strings.need-confirm;
                                        color: root.prepared ? Theme.ok-glow : Theme.faint;
                                        font-size: 11px;
                                        font-weight: 600;
                                        font-family: "Avenir Next";
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.disks-label; }
                                    Text {
                                        text: root.disk-list == "" ? "Refresh host disks to pick a PhysicalDrive /dev path." : root.disk-list;
                                        color: Theme.mute;
                                        font-size: 11px;
                                        font-family: "Menlo";
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ActionButton { label: Strings.refresh-disks; enabled: !root.busy; clicked => { root.refresh-disks-clicked(); } }
                                        ActionButton { label: Strings.use-selected-disk; enabled: !root.busy; clicked => { root.use-first-disk-clicked(); } }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.source-kind-label; }
                                    Text { text: root.source-kind-caption; color: Theme.readout; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        PrefChip { label: Strings.kind-disk; active: root.source-kind-index == 0; clicked => { root.source-kind-changed(0); } }
                                        PrefChip { label: Strings.kind-file; active: root.source-kind-index == 1; clicked => { root.source-kind-changed(1); } }
                                        PrefChip { label: Strings.kind-ram; active: root.source-kind-index == 2; clicked => { root.source-kind-changed(2); } }
                                        PrefChip { label: Strings.kind-snap; active: root.source-kind-index == 3; clicked => { root.source-kind-changed(3); } }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.profile-label; }
                                    Text { text: root.profile-caption; color: Theme.readout; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        PrefChip { label: Strings.profile-quick; active: root.profile-index == 0; clicked => { root.profile-changed(0); } }
                                        PrefChip { label: Strings.profile-standard; active: root.profile-index == 1; clicked => { root.profile-changed(1); } }
                                        PrefChip { label: Strings.profile-deep; active: root.profile-index == 2; clicked => { root.profile-changed(2); } }
                                        PrefChip { label: Strings.profile-custom; active: root.profile-index == 3; clicked => { root.profile-changed(3); } }
                                    }
                                    if root.profile-index == 0: ActionButton {
                                        label: Strings.run-quick-profile;
                                        enabled: !root.busy;
                                        clicked => { root.run-profile-clicked(); }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.format-label; }
                                    Text { text: root.format-caption; color: Theme.readout; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        PrefChip { label: "fsnap"; active: root.format-index == 0; clicked => { root.format-changed(0); } }
                                        PrefChip { label: "E01-lite"; active: root.format-index == 1; clicked => { root.format-changed(1); } }
                                        PrefChip { label: "AFF4"; active: root.format-index == 2; clicked => { root.format-changed(2); } }
                                        PrefChip { label: "split"; active: root.format-index == 7; clicked => { root.format-changed(7); } }
                                    }
                                    CheckBox { text: Strings.write-sha512; checked <=> root.write-sha512; enabled: !root.busy; }
                                    if root.format-index == 7: FieldShell {
                                        text <=> root.segment-mib;
                                        placeholder: Strings.segment-mib;
                                        enabled: !root.busy;
                                    }
                                    Eyebrow { label: Strings.retry-label; }
                                    Text { text: root.retry-caption; color: Theme.faint; font-size: 11px; font-family: "Avenir Next"; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        PrefChip { label: Strings.retry-skip; active: root.retry-index == 0; clicked => { root.retry-changed(0); } }
                                        PrefChip { label: Strings.retry-n; active: root.retry-index == 1; clicked => { root.retry-changed(1); } }
                                        PrefChip { label: Strings.retry-fail; active: root.retry-index == 2; clicked => { root.retry-changed(2); } }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.coc-form-label; }
                                    FieldShell { text <=> root.coc-device; placeholder: Strings.coc-device; enabled: !root.busy; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        FieldShell { text <=> root.coc-media; placeholder: Strings.coc-media; enabled: !root.busy; }
                                        FieldShell { text <=> root.coc-seq; placeholder: Strings.coc-seq; enabled: !root.busy; }
                                    }
                                    FieldShell { text <=> root.coc-description; placeholder: Strings.coc-description; enabled: !root.busy; }
                                    ActionButton {
                                        label: Strings.export-full-coc;
                                        enabled: !root.busy && root.has-package;
                                        clicked => { root.export-full-coc-clicked(); }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.multisource-label; }
                                    FieldShell { text <=> root.multisource-b; placeholder: Strings.multisource-b; enabled: !root.busy; }
                                    ActionButton {
                                        label: Strings.run-multisource;
                                        enabled: !root.busy;
                                        clicked => { root.multisource-clicked(); }
                                    }
                                }

                                Text {
                                    text: root.show-path-editors ? Strings.prepare-paths-title : Strings.prepare-guided-title;
                                    color: Theme.readout;
                                    font-size: 16px;
                                    font-weight: 600;
                                    font-family: "Avenir Next";
                                }
                                Text {
                                    text: root.show-path-editors ? Strings.prepare-paths-body : Strings.prepare-guided-body;
                                    color: Theme.mute;
                                    font-size: 12px;
                                    font-family: "Avenir Next";
                                    wrap: word-wrap;
                                }

                                if root.guided: ActionButton {
                                    label: Strings.fill-demo;
                                    primary: root.demo-is-primary;
                                    enabled: !root.busy;
                                    clicked => { root.fill-synthetic-clicked(); }
                                }

                                if root.show-path-editors: VerticalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text { text: Strings.source; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            FieldShell {
                                                horizontal-stretch: 1;
                                                text <=> root.source-path;
                                                placeholder: Strings.source-placeholder;
                                                enabled: !root.busy;
                                            }
                                            ActionButton {
                                                label: Strings.browse;
                                                enabled: !root.busy;
                                                clicked => { root.browse-source-clicked(); }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text { text: Strings.output; color: Theme.mute; font-size: 12px; font-family: "Avenir Next"; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            FieldShell {
                                                horizontal-stretch: 1;
                                                text <=> root.output-dir;
                                                placeholder: Strings.output-placeholder;
                                                enabled: !root.busy;
                                            }
                                            ActionButton {
                                                label: Strings.browse;
                                                enabled: !root.busy;
                                                clicked => { root.browse-output-clicked(); }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.case-id-label; }
                                    FieldShell {
                                        text <=> root.case-id;
                                        placeholder: root.guided ? "Optional for Guided" : "Required for Standard / Expert";
                                        enabled: !root.busy;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Eyebrow { label: Strings.examiner-label; }
                                    FieldShell {
                                        text <=> root.case-identity;
                                        placeholder: Strings.case-placeholder;
                                        enabled: !root.busy;
                                    }
                                }

                                CheckBox {
                                    text: Strings.confirm-synthetic;
                                    checked <=> root.confirmed-synthetic;
                                    enabled: !root.busy;
                                }
                                if root.blockish-source: CheckBox {
                                    text: Strings.confirm-wb;
                                    checked <=> root.wb-confirmed;
                                    enabled: !root.busy;
                                }
                                if root.preflight-hint != "" && !root.preflight-is-deny: Text {
                                    text: root.preflight-hint;
                                    color: Theme.copper;
                                    font-size: 12px;
                                    font-weight: 500;
                                    font-family: "Avenir Next";
                                    wrap: word-wrap;
                                }
                                if root.preflight-is-deny: Rectangle {
                                    background: Theme.deny-mist;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.deny;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        Text {
                                            text: Strings.deny-title;
                                            color: Theme.deny;
                                            font-size: 13px;
                                            font-weight: 700;
                                            font-family: "Avenir Next";
                                        }
                                        Text {
                                            text: root.preflight-hint;
                                            color: Theme.readout;
                                            font-size: 12px;
                                            font-family: "Avenir Next";
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: Strings.deny-body;
                                            color: Theme.mute;
                                            font-size: 11px;
                                            font-family: "Avenir Next";
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // STEP 2 — Acquire
                        if root.nav-index == 0: Panel {
                            opacity: root.busy ? 1.0 : root.has-hash ? 0.92 : 1.0;
                            animate opacity { duration: 220ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Text {
                                    text: Strings.step-run;
                                    color: Theme.copper;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                    font-family: "Avenir Next";
                                }
                                Text {
                                    text: root.mode-guidance;
                                    color: Theme.mute;
                                    font-size: 12px;
                                    font-family: "Avenir Next";
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: root.busy ? Strings.working : Strings.acquire;
                                        primary: !root.demo-is-primary;
                                        enabled: root.can-run;
                                        clicked => { root.run-clicked(); }
                                    }
                                    ActionButton {
                                        label: Strings.cancel;
                                        danger: true;
                                        enabled: root.busy;
                                        clicked => { root.cancel-clicked(); }
                                    }
                                    if !root.guided: ActionButton {
                                        label: Strings.fill-demo;
                                        enabled: !root.busy;
                                        clicked => { root.fill-synthetic-clicked(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    ActionButton {
                                        label: Strings.export-coc;
                                        enabled: !root.busy && root.has-package;
                                        clicked => { root.export-coc-clicked(); }
                                    }
                                    ActionButton {
                                        label: Strings.clear;
                                        ghost: true;
                                        enabled: !root.busy && (root.has-hash || root.status-line != "");
                                        clicked => { root.clear-clicked(); }
                                    }
                                }

                                if root.busy || root.progress-label != "": VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text {
                                            text: root.progress-phase;
                                            color: Theme.copper-dim;
                                            font-size: 11px;
                                            font-weight: 700;
                                            font-family: "Avenir Next";
                                            letter-spacing: 0.8px;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text {
                                            text: root.throughput-label;
                                            color: Theme.readout;
                                            font-size: 11px;
                                            font-family: "Menlo";
                                        }
                                        Text {
                                            text: root.eta-label;
                                            color: Theme.mute;
                                            font-size: 11px;
                                            font-family: "Menlo";
                                        }
                                        Text {
                                            text: root.progress-label;
                                            color: Theme.mute;
                                            font-size: 11px;
                                            font-family: "Avenir Next";
                                        }
                                    }
                                    Rectangle {
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.raised;
                                        border-width: 1px;
                                        border-color: Theme.hairline;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: parent.height;
                                            width: parent.width * root.progress-fraction;
                                            border-radius: 3px;
                                            background: Theme.copper;
                                        }
                                    }
                                    Eyebrow { label: Strings.coverage-map; }
                                    Rectangle {
                                        height: 10px;
                                        border-radius: 2px;
                                        background: Theme.raised;
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * root.coverage-ok;
                                            height: parent.height;
                                            background: Theme.ok-glow;
                                            border-radius: 2px;
                                        }
                                        Rectangle {
                                            x: parent.width * root.coverage-ok;
                                            width: parent.width * root.coverage-err;
                                            height: parent.height;
                                            background: Theme.deny;
                                            border-radius: 2px;
                                        }
                                    }
                                }
                            }
                        }

                        // STEP 3 — Seal (result product)
                        if root.nav-index == 0: Rectangle {
                            background: root.has-hash ? Theme.seal-ok : Theme.seal-well;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.has-hash ? Theme.ok-mist : Theme.hairline;
                            min-height: root.has-hash ? 168px : 120px;

                            if root.has-hash: Rectangle {
                                height: 2px;
                                width: parent.width;
                                background: Theme.ok-glow;
                                border-top-left-radius: 6px;
                                border-top-right-radius: 6px;
                            }

                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: Strings.evidence-seal;
                                        color: Theme.copper;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1.6px;
                                        font-family: "Avenir Next";
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        background: root.has-hash ? Theme.ok-mist : Theme.raised;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: root.has-hash ? Theme.ok-mist : Theme.hairline;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            Text {
                                                text: root.has-hash ? Strings.verified : Strings.awaiting;
                                                color: root.has-hash ? Theme.ok-glow : Theme.faint;
                                                font-size: 10px;
                                                font-weight: 700;
                                                letter-spacing: 1px;
                                                font-family: "Avenir Next";
                                            }
                                        }
                                    }
                                }

                                if !root.has-hash: VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: Strings.seal-empty-title;
                                        color: Theme.readout;
                                        font-size: 15px;
                                        font-weight: 600;
                                        font-family: "Avenir Next";
                                    }
                                    Text {
                                        text: Strings.seal-empty-body;
                                        color: Theme.mute;
                                        font-size: 12px;
                                        font-family: "Avenir Next";
                                        wrap: word-wrap;
                                    }
                                }

                                if root.has-hash: VerticalLayout {
                                    spacing: 8px;
                                    Eyebrow { label: Strings.custody-timeline; }
                                    Text {
                                        text: root.custody-timeline-text;
                                        color: Theme.mute;
                                        font-size: 11px;
                                        font-family: "Avenir Next";
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: Strings.sha-label;
                                        color: Theme.faint;
                                        font-size: 10px;
                                        font-weight: 600;
                                        letter-spacing: 1.2px;
                                        font-family: "Avenir Next";
                                    }
                                    Text {
                                        text: root.display-hash;
                                        color: Theme.readout;
                                        font-family: "Menlo";
                                        font-size: 15px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                    }
                                    if root.evidence-sha512 != "(none)": VerticalLayout {
                                        spacing: 3px;
                                        Text { text: Strings.sha512-label; color: Theme.faint; font-size: 10px; font-weight: 600; font-family: "Avenir Next"; }
                                        Text { text: root.evidence-sha512; color: Theme.mute; font-family: "Menlo"; font-size: 12px; wrap: word-wrap; }
                                    }
                                    Hairline { background: Theme.ok-mist; }
                                    HorizontalLayout {
                                        spacing: 24px;
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: Strings.status; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                            Text { text: root.status-line; color: Theme.readout; font-size: 12px; font-family: "Avenir Next"; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text { text: Strings.size; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                            Text { text: root.display-size; color: Theme.readout; font-family: "Menlo"; font-size: 12px; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text { text: Strings.package; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                            Text { text: root.display-package; color: Theme.mute; font-family: "Menlo"; font-size: 11px; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }
                        }

                        if root.nav-index == 0: Text {
                            text: Strings.footer;
                            color: Theme.faint;
                            font-size: 10px;
                            font-family: "Avenir Next";
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
