// Remounted ASCII shell — banner + header + rail + safety + zones + status + about.
// Responsive: >=1100px shows 3 zones side-by-side; <1100px stacks in a ScrollView with icon rail.
// All in-out properties and callbacks below are consumed by Rust (src/main.rs) — do not rename.

import { LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import {
    PageHeader, ZoneCaption, PrimaryBtn, GhostBtn, StatusBadge, LabCheck, CheckRow, MetaRow,
    EmptyHint, HelpTopic, CaseRow, ResultRow, LogLineRow, CoverageBar, DraftBanner,
} from "widgets.slint";

export struct DiskLine {
    path: string,
    device: string,
    model: string,
    serial: string,
    size: string,
    bus: string,
}

export struct CaseLine {
    id: string,
    title: string,
    examiner: string,
    state: string,
    updated: string,
}

export struct ResultLine {
    name: string,
    ok: bool,
    detail: string,
}

export struct LogLine {
    level: string,
    text: string,
}

export struct TimelineLine {
    when: string,
    what: string,
}

export struct ListingLine {
    path: string,
    size: string,
    kind: string,
}

export struct RecentLine {
    case-id: string,
    package-path: string,
    completed-at: string,
}

// -------------------------------------------------------------------- primitives

// Geometric rail marks — always render (no emoji / icon font).
component NavMark inherits Rectangle {
    in-out property <string> kind;
    in-out property <bool> active;
    width: Theme.icon-box;
    height: Theme.icon-box;
    border-radius: 8px;
    background: root.active ? Theme.unsigned-well : Theme.icon-well;
    border-width: 1px;
    border-color: root.active ? Theme.unsigned-border : Theme.hairline;
    // cases — stacked rows
    if root.kind == "cases": VerticalLayout {
        padding: 7px;
        spacing: 3px;
        alignment: center;
        Rectangle { height: 3px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        Rectangle { height: 3px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        Rectangle { height: 3px; width: 70%; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
    }
    // identify — ring
    if root.kind == "identify": Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        border-width: 2px;
        border-color: root.active ? Theme.copper : Theme.icon-soft;
        background: transparent;
    }
    // acquire — down chevron bars
    if root.kind == "acquire": VerticalLayout {
        padding: 8px;
        spacing: 3px;
        alignment: center;
        Rectangle { height: 3px; width: 70%; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        Rectangle { height: 3px; width: 50%; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        Rectangle { height: 3px; width: 30%; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
    }
    // triage — 2×2 grid
    if root.kind == "triage": GridLayout {
        padding: 8px;
        spacing: 3px;
        Row {
            Rectangle { width: 6px; height: 6px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
            Rectangle { width: 6px; height: 6px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        }
        Row {
            Rectangle { width: 6px; height: 6px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
            Rectangle { width: 6px; height: 6px; border-radius: 1.5px; background: root.active ? Theme.copper : Theme.icon-soft; }
        }
    }
    // tools — cross
    if root.kind == "tools": Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Rectangle {
            width: 14px; height: 3px; y: 5.5px; border-radius: 1.5px;
            background: root.active ? Theme.copper : Theme.icon-soft;
        }
        Rectangle {
            width: 3px; height: 14px; x: 5.5px; border-radius: 1.5px;
            background: root.active ? Theme.copper : Theme.icon-soft;
        }
    }
    // qms — diamond-ish square
    if root.kind == "qms": Rectangle {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        border-width: 2px;
        border-color: root.active ? Theme.copper : Theme.icon-soft;
        background: transparent;
    }
    // boot — media stick
    if root.kind == "boot": VerticalLayout {
        padding: 7px;
        spacing: 2px;
        alignment: center;
        Rectangle {
            height: 4px; width: 40%; border-radius: 1px;
            background: root.active ? Theme.copper : Theme.icon-soft;
        }
        Rectangle {
            height: 12px; border-radius: 2px;
            background: root.active ? Theme.copper : Theme.icon-soft;
        }
    }
    // help / about — letter (ASCII always available)
    if root.kind == "help" || root.kind == "about": Text {
        text: root.kind == "help" ? "?" : "i";
        color: root.active ? Theme.copper : Theme.icon-soft;
        font-size: Theme.font-label;
        font-weight: 800;
        font-family: "Menlo";
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component NavItem inherits Rectangle {
    in-out property <string> kind: "cases";
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> enabled: true;
    in-out property <bool> compact: false;
    callback clicked;
    height: Theme.nav-item-h;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.active ? Theme.rail-active : ta.has-hover && root.enabled ? Theme.raised : transparent;
    border-radius: Theme.radius-sm;
    if !root.compact: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            background: root.active ? Theme.copper : transparent;
            border-radius: 1.5px;
        }
        NavMark {
            kind: root.kind;
            active: root.active;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.copper : Theme.readout;
            font-size: Theme.font-ui;
            font-weight: root.active ? 700 : 500;
            font-family: "Avenir Next";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if root.compact: HorizontalLayout {
        alignment: center;
        NavMark { kind: root.kind; active: root.active; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ModeSeg inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> locked: false;
    callback clicked;
    horizontal-stretch: 1;
    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : (ta.has-hover && !root.locked ? Theme.unsigned-well : transparent);
    HorizontalLayout {
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: Theme.font-label;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FormatOpt inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> locked: false;
    callback clicked;
    horizontal-stretch: 1;
    height: 38px;
    min-width: 72px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : (ta.has-hover && !root.locked ? Theme.unsigned-well : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: Theme.font-label;
            font-weight: 600;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FormatChip inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> locked: false;
    callback clicked;
    height: 34px;
    min-width: 68px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : Theme.raised;
    border-width: 1px;
    border-color: root.active ? Theme.copper : Theme.hairline;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: Theme.font-label;
            font-weight: 600;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LocaleChip inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    callback clicked;
    height: 34px;
    min-width: 48px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : (ta.has-hover ? Theme.unsigned-well : Theme.panel);
    border-width: 1px;
    border-color: root.active ? Theme.copper : (ta.has-hover ? Theme.unsigned-border : Theme.hairline);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: Theme.font-label;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component StageTab inherits Rectangle {
    in-out property <string> glyph;
    in-out property <string> label;
    in-out property <bool> done;
    in-out property <bool> current;
    height: 38px;
    min-width: 110px;
    border-radius: Theme.radius-sm;
    background: root.current ? Theme.unsigned-well : transparent;
    border-width: root.current ? 1px : 0;
    border-color: Theme.unsigned-border;
    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            alignment: center;
            vertical-stretch: 1;
            Text {
                text: root.glyph;
                color: root.current ? Theme.copper : (root.done ? Theme.ok-glow : Theme.mute);
                font-size: Theme.font-label;
                font-weight: 800;
                font-family: "Menlo";
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                color: root.current ? Theme.copper : (root.done ? Theme.ok-glow : Theme.mute);
                font-size: Theme.font-label;
                font-weight: root.current ? 800 : 600;
                font-family: "Avenir Next";
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 2.5px;
            background: root.current ? Theme.copper : transparent;
            border-radius: 1.5px;
        }
    }
}

component SafetyChip inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <bool> ok: false;
    in-out property <bool> warn: false;
    in-out property <bool> clickable: true;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.warn ? Theme.unsigned-well : (root.ok ? Theme.ok-mist : transparent);
    border-width: root.warn || root.ok ? 1px : 0;
    border-color: root.warn ? Theme.unsigned-border : (root.ok ? Theme.ok-glow : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.caption + ":";
            color: Theme.faint;
            font-size: Theme.font-caption;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.readout);
            font-size: Theme.font-mono;
            font-weight: 600;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component DetailTile inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <bool> ok: false;
    horizontal-stretch: 1;
    min-height: 56px;
    background: Theme.raised;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 4px;
            background: root.ok ? Theme.ok-glow
                : (root.value == "—" || root.value == "-" || root.value == "" ? Theme.hairline : Theme.copper-dim);
            border-top-left-radius: Theme.radius-sm;
            border-bottom-left-radius: Theme.radius-sm;
        }
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.caption;
                color: Theme.faint;
                font-size: Theme.font-caption;
                font-weight: 800;
                font-family: "Avenir Next";
                letter-spacing: 0.4px;
            }
            Text {
                text: root.value;
                color: root.ok ? Theme.ok-glow
                    : (root.value == "—" || root.value == "-" || root.value == "" ? Theme.faint : Theme.readout);
                font-size: Theme.font-mono;
                font-weight: 600;
                font-family: "Menlo";
                overflow: elide;
            }
        }
    }
}

component PathField inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <string> placeholder;
    in-out property <bool> enabled: true;
    callback browse-clicked;
    VerticalLayout {
        spacing: 6px;
        ZoneCaption { caption: root.caption; }
        Rectangle {
            height: Theme.btn-h;
            border-radius: Theme.radius-sm;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                LineEdit {
                    text <=> root.value;
                    placeholder-text: root.placeholder;
                    enabled: root.enabled;
                    horizontal-stretch: 1;
                    font-family: "Menlo";
                    font-size: Theme.font-mono;
                }
                Rectangle {
                    min-width: 108px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: browse.has-hover && root.enabled ? Theme.unsigned-well : Theme.panel;
                    border-width: 1px;
                    border-color: browse.has-hover && root.enabled ? Theme.unsigned-border : Theme.hairline;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;
                        Text {
                            text: Strings.browse;
                            color: Theme.copper;
                            font-size: Theme.font-label;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            vertical-alignment: center;
                        }
                    }
                    browse := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { root.browse-clicked(); }
                    }
                }
            }
        }
    }
}

component HwStatus inherits Rectangle {
    in-out property <string> glyph;
    in-out property <string> label;
    in-out property <bool> ok: false;
    in-out property <bool> warn: false;
    HorizontalLayout {
        spacing: 8px;
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.faint);
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.glyph;
            color: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.mute);
            font-size: Theme.font-ui;
            font-weight: 800;
            font-family: "Menlo";
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.ok ? Theme.readout : (root.warn ? Theme.copper : Theme.mute);
            font-size: Theme.font-mono;
            font-family: "Menlo";
            vertical-alignment: center;
        }
    }
}

// -------------------------------------------------------------------- zones

component EmptyDisksPlaceholder inherits Rectangle {
    vertical-stretch: 1;
    min-height: 160px;
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 4px;
            background: Theme.copper-dim;
            border-top-left-radius: Theme.radius;
            border-bottom-left-radius: Theme.radius;
        }
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 14px;
        alignment: center;
        horizontal-stretch: 1;
        // Outline illustration: empty disk bay
        Rectangle {
            height: 72px;
            HorizontalLayout {
                spacing: 14px;
                alignment: center;
                for bay in [1, 2, 3]: Rectangle {
                    width: 44px;
                    height: 58px;
                    border-radius: 6px;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: Theme.placeholder-line;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            border-width: 1.5px;
                            border-color: Theme.placeholder-line;
                            background: transparent;
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.placeholder-line;
                        }
                        Rectangle {
                            height: 3px;
                            width: 60%;
                            border-radius: 1.5px;
                            background: Theme.placeholder-line;
                        }
                    }
                }
            }
        }
        Text {
            text: Strings.empty-disks-title;
            color: Theme.readout;
            font-size: Theme.font-ui;
            font-weight: 700;
            font-family: "Avenir Next";
            horizontal-alignment: center;
        }
        Text {
            text: Strings.empty-disks-body;
            color: Theme.mute;
            font-size: Theme.font-body;
            font-family: "Avenir Next";
            horizontal-alignment: center;
        }
    }
    }
}

component SourceZone inherits Rectangle {
    in-out property <bool> is-guided;
    in-out property <bool> is-expert;
    in-out property <bool> busy;
    in-out property <[DiskLine]> disk-rows;
    in-out property <int> selected-disk;
    in-out property <string> detail-interface: "—";
    in-out property <string> detail-sectors: "—";
    in-out property <string> detail-sector-size: "—";
    in-out property <string> detail-partitions: "—";
    in-out property <string> detail-type: "—";
    in-out property <string> detail-readonly: "—";
    in-out property <bool> detail-readonly-ok: false;
    in-out property <bool> blockish-source;
    in-out property <bool> wb-confirmed;
    in-out property <int> wizard-focus;
    callback refresh-clicked;
    callback browse-source-clicked;
    callback fill-synthetic-clicked;
    callback use-first-disk-clicked;
    callback disk-selected(int);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        ZoneCaption { caption: Strings.zone-source-caption; }

        if root.is-guided: Rectangle {
            background: Theme.unsigned-well;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.unsigned-border;
            VerticalLayout {
                padding: Theme.space-md;
                spacing: 6px;
                Text {
                    text: Strings.prepare-guided-title;
                    color: Theme.unsigned-text;
                    font-size: 13px;
                    font-weight: 700;
                    font-family: "Avenir Next";
                }
                Text {
                    text: Strings.prepare-guided-body;
                    color: Theme.readout;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
            }
        }
        if root.is-guided: HorizontalLayout {
            spacing: Theme.space-sm;
            PrimaryBtn {
                label: Strings.fill-demo;
                enabled: !root.busy;
                horizontal-stretch: 1;
                clicked => { root.fill-synthetic-clicked(); }
            }
            GhostBtn {
                label: Strings.use-selected-disk;
                enabled: !root.busy;
                horizontal-stretch: 1;
                clicked => { root.use-first-disk-clicked(); root.wizard-focus = 2; }
            }
        }

        if !root.is-guided: HorizontalLayout {
            GhostBtn {
                label: Strings.refresh-disks;
                enabled: !root.busy;
                horizontal-stretch: 0;
                min-width: 160px;
                clicked => { root.refresh-clicked(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if !root.is-guided && root.disk-rows.length == 0: EmptyDisksPlaceholder { }

        if !root.is-guided && root.disk-rows.length == 0: HorizontalLayout {
            spacing: Theme.space-sm;
            GhostBtn {
                label: Strings.browse;
                enabled: !root.busy;
                horizontal-stretch: 1;
                min-width: Theme.btn-min-w;
                clicked => { root.browse-source-clicked(); }
            }
            PrimaryBtn {
                label: Strings.fill-demo;
                enabled: !root.busy;
                horizontal-stretch: 2;
                clicked => { root.fill-synthetic-clicked(); }
            }
        }

        if !root.is-guided && root.disk-rows.length > 0: Rectangle {
            height: 32px;
            background: Theme.table-head;
            border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                Text { text: ""; width: 22px; }
                Text { text: Strings.col-dev; width: 64px; color: Theme.faint; font-size: Theme.font-caption; font-weight: 700; font-family: "Avenir Next"; vertical-alignment: center; }
                Text { text: Strings.col-model; horizontal-stretch: 1; color: Theme.faint; font-size: Theme.font-caption; font-weight: 700; font-family: "Avenir Next"; vertical-alignment: center; }
                Text { text: Strings.col-size; width: 72px; color: Theme.faint; font-size: Theme.font-caption; font-weight: 700; font-family: "Avenir Next"; vertical-alignment: center; }
                Text { text: Strings.col-bus; width: 52px; color: Theme.faint; font-size: Theme.font-caption; font-weight: 700; font-family: "Avenir Next"; vertical-alignment: center; }
            }
        }
        if !root.is-guided && root.disk-rows.length > 0: VerticalLayout {
            spacing: 3px;
            vertical-stretch: 1;
            for row[idx] in root.disk-rows: Rectangle {
                height: 42px;
                border-radius: Theme.radius-sm;
                background: root.selected-disk == idx ? Theme.rail-active : transparent;
                border-width: root.selected-disk == idx ? 1px : 0;
                border-color: Theme.unsigned-border;
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    Text {
                        text: root.selected-disk == idx ? "*" : "-";
                        width: 22px;
                        color: Theme.copper;
                        font-size: Theme.font-ui;
                        font-weight: 800;
                        font-family: "Menlo";
                        vertical-alignment: center;
                    }
                    Text { text: row.device; width: 60px; color: Theme.readout; font-size: Theme.font-body; font-family: "Menlo"; vertical-alignment: center; }
                    Text { text: row.model; horizontal-stretch: 1; color: Theme.readout; font-size: Theme.font-body; font-family: "Avenir Next"; vertical-alignment: center; overflow: elide; }
                    Text { text: row.size; width: 68px; color: Theme.mute; font-size: Theme.font-body; font-family: "Menlo"; vertical-alignment: center; }
                    Text { text: row.bus; width: 48px; color: Theme.mute; font-size: Theme.font-body; font-family: "Menlo"; vertical-alignment: center; }
                }
                TouchArea {
                    enabled: !root.busy;
                    mouse-cursor: pointer;
                    clicked => { root.disk-selected(idx); root.wizard-focus = 2; }
                }
            }
        }

        ZoneCaption { caption: Strings.device-details; }
        GridLayout {
            spacing: Theme.space-sm;
            Row {
                DetailTile { caption: Strings.detail-interface; value: root.detail-interface; }
                DetailTile { caption: Strings.detail-partitions; value: root.detail-partitions; }
            }
            Row {
                DetailTile { caption: Strings.detail-sectors; value: root.detail-sectors; }
                DetailTile { caption: Strings.detail-type; value: root.detail-type; }
            }
            Row {
                DetailTile { caption: Strings.detail-sector-size; value: root.detail-sector-size; }
                DetailTile { caption: Strings.detail-readonly; value: root.detail-readonly; ok: root.detail-readonly-ok; }
            }
        }
        if root.blockish-source || root.is-expert: LabCheck {
            label: Strings.confirm-wb;
            checked <=> root.wb-confirmed;
            enabled: !root.busy;
            toggled => { root.wizard-focus = 3; }
        }
    }
}

component PrepareZone inherits Rectangle {
    in-out property <bool> is-guided;
    in-out property <int> mode-index;
    in-out property <bool> busy;
    in-out property <bool> show-advanced;
    in-out property <int> format-index;
    in-out property <string> format-caption;
    in-out property <int> profile-index;
    in-out property <int> source-kind-index;
    in-out property <int> retry-index;
    in-out property <string> segment-mib;
    in-out property <string> multisource-b;
    in-out property <bool> write-sha512;
    in-out property <bool> show-path-editors;
    in-out property <string> source-path;
    in-out property <string> output-dir;
    in-out property <string> case-id;
    in-out property <string> case-verify;
    in-out property <bool> case-verify-ok;
    in-out property <bool> confirmed-synthetic;
    in-out property <int> wizard-focus;
    in-out property <bool> preflight-is-deny;
    in-out property <string> preflight-hint;
    in-out property <bool> free-space-ok: true;
    callback mode-changed(int);
    callback format-changed(int);
    callback profile-changed(int);
    callback source-kind-changed(int);
    callback retry-changed(int);
    callback run-profile-clicked;
    callback multisource-clicked;
    callback browse-source-clicked;
    callback browse-output-clicked;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        ZoneCaption { caption: Strings.zone-prepare-caption; }
        ZoneCaption { caption: Strings.operator-mode; }
        // Compact mode switcher
        Rectangle {
            height: 40px;
            border-radius: Theme.radius-sm;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            HorizontalLayout {
                padding: 3px;
                spacing: 3px;
                ModeSeg { label: Strings.mode-guided; active: root.mode-index == 0; locked: root.busy; clicked => { root.mode-index = 0; root.mode-changed(0); } }
                ModeSeg { label: Strings.mode-standard; active: root.mode-index == 1; locked: root.busy; clicked => { root.mode-index = 1; root.mode-changed(1); } }
                ModeSeg { label: Strings.mode-expert; active: root.mode-index == 2; locked: root.busy; clicked => { root.mode-index = 2; root.mode-changed(2); } }
            }
        }

        ZoneCaption { caption: Strings.format-label; }
        // Multi-option format selector
        Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            VerticalLayout {
                padding: 4px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 2px;
                    FormatOpt { label: "fsnap"; active: root.format-index == 0; locked: root.busy; clicked => { root.format-index = 0; root.format-changed(0); } }
                    FormatOpt { label: "E01"; active: root.format-index == 1; locked: root.busy; clicked => { root.format-index = 1; root.format-changed(1); } }
                    FormatOpt { label: "ZFF"; active: root.format-index == 2; locked: root.busy; clicked => { root.format-index = 2; root.format-changed(2); } }
                    FormatOpt { label: "Split"; active: root.format-index == 3; locked: root.busy; clicked => { root.format-index = 3; root.format-changed(3); } }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 8px;
                    Text {
                        text: root.format-index == 0 ? Strings.court-path-a : root.format-caption;
                        color: root.format-index == 0 ? Theme.copper : Theme.faint;
                        font-size: Theme.font-caption;
                        font-weight: root.format-index == 0 ? 700 : 500;
                        font-family: "Avenir Next";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if !root.is-guided: Rectangle {
                        height: 34px;
                        min-width: 118px;
                        border-radius: Theme.radius-sm;
                        background: root.show-advanced ? Theme.unsigned-well : Theme.panel;
                        border-width: 1px;
                        border-color: root.show-advanced ? Theme.unsigned-border : Theme.hairline;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: root.show-advanced ? "v" : ">";
                                color: Theme.copper;
                                font-size: Theme.font-label;
                                font-weight: 800;
                                font-family: "Menlo";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.show-advanced ? Strings.advanced-hide : Strings.advanced-toggle;
                                color: Theme.readout;
                                font-size: Theme.font-ui;
                                font-weight: 700;
                                font-family: "Avenir Next";
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            enabled: !root.busy;
                            mouse-cursor: pointer;
                            clicked => { root.show-advanced = !root.show-advanced; }
                        }
                    }
                }
            }
        }

        if root.show-advanced && !root.is-guided: VerticalLayout {
            spacing: Theme.space-sm;
            Text {
                text: Strings.experimental-not-applied;
                color: Theme.mute;
                font-size: Theme.font-caption;
                font-family: "Avenir Next";
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: Strings.segment-mib; color: Theme.mute; font-size: Theme.font-caption; font-family: "Avenir Next"; vertical-alignment: center; }
                LineEdit { text <=> root.segment-mib; enabled: !root.busy && root.format-index == 3; horizontal-stretch: 1; }
            }
            ZoneCaption { caption: Strings.profile-label; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.profile-quick; active: root.profile-index == 0; locked: root.busy; clicked => { root.profile-index = 0; root.profile-changed(0); } }
                FormatChip { label: Strings.profile-standard; active: root.profile-index == 1; locked: root.busy; clicked => { root.profile-index = 1; root.profile-changed(1); } }
                FormatChip { label: Strings.profile-deep; active: root.profile-index == 2; locked: root.busy; clicked => { root.profile-index = 2; root.profile-changed(2); } }
                FormatChip { label: Strings.profile-custom; active: root.profile-index == 3; locked: root.busy; clicked => { root.profile-index = 3; root.profile-changed(3); } }
            }
            GhostBtn {
                label: Strings.run-quick-profile;
                enabled: !root.busy;
                horizontal-stretch: 0;
                min-width: 160px;
                clicked => { root.run-profile-clicked(); }
            }
            ZoneCaption { caption: Strings.source-kind-label; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.kind-disk; active: root.source-kind-index == 0; locked: root.busy; clicked => { root.source-kind-index = 0; root.source-kind-changed(0); } }
                FormatChip { label: Strings.kind-file; active: root.source-kind-index == 1; locked: root.busy; clicked => { root.source-kind-index = 1; root.source-kind-changed(1); } }
                FormatChip { label: Strings.kind-ram; active: root.source-kind-index == 2; locked: root.busy; clicked => { root.source-kind-index = 2; root.source-kind-changed(2); } }
                FormatChip { label: Strings.kind-snap; active: root.source-kind-index == 3; locked: root.busy; clicked => { root.source-kind-index = 3; root.source-kind-changed(3); } }
            }
            ZoneCaption { caption: Strings.retry-label; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.retry-skip; active: root.retry-index == 0; locked: root.busy; clicked => { root.retry-index = 0; root.retry-changed(0); } }
                FormatChip { label: Strings.retry-n; active: root.retry-index == 1; locked: root.busy; clicked => { root.retry-index = 1; root.retry-changed(1); } }
                FormatChip { label: Strings.retry-fail; active: root.retry-index == 2; locked: root.busy; clicked => { root.retry-index = 2; root.retry-changed(2); } }
            }
            ZoneCaption { caption: Strings.multisource-label; }
            LineEdit { placeholder-text: Strings.multisource-b; text <=> root.multisource-b; enabled: !root.busy; horizontal-stretch: 1; }
            GhostBtn {
                label: Strings.run-multisource;
                enabled: !root.busy;
                horizontal-stretch: 0;
                min-width: 160px;
                clicked => { root.multisource-clicked(); }
            }
        }

        LabCheck {
            label: Strings.write-sha512;
            checked <=> root.write-sha512;
            enabled: !root.busy;
        }

        Rectangle { height: 1px; background: Theme.hairline; }

        if root.show-path-editors: PathField {
            caption: Strings.path-source;
            value <=> root.source-path;
            placeholder: Strings.source-placeholder;
            enabled: !root.busy;
            browse-clicked => { root.browse-source-clicked(); }
        }
        if root.show-path-editors: PathField {
            caption: Strings.path-output;
            value <=> root.output-dir;
            placeholder: Strings.output-placeholder;
            enabled: !root.busy;
            browse-clicked => { root.browse-output-clicked(); }
        }

        VerticalLayout {
            spacing: Theme.space-sm;
            Text {
                text: Strings.case-verify-label;
                color: Theme.faint;
                font-size: Theme.font-caption;
                font-weight: 700;
                font-family: "Avenir Next";
            }
            Rectangle {
                height: 36px;
                border-radius: Theme.radius-sm;
                background: Theme.raised;
                border-width: 1px;
                border-color: root.case-verify-ok ? Theme.hairline : Theme.deny;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    LineEdit {
                        text <=> root.case-verify;
                        enabled: !root.busy && !root.is-guided;
                        placeholder-text: root.case-id == "" ? Strings.case-verify-placeholder : root.case-id;
                        horizontal-stretch: 1;
                        font-family: "Menlo";
                        font-size: Theme.font-body;
                    }
                }
            }
            if !root.case-verify-ok: Text {
                text: Strings.case-verify-mismatch;
                color: Theme.deny;
                font-size: Theme.font-caption;
                font-weight: 600;
                font-family: "Avenir Next";
            }
            LabCheck {
                label: Strings.confirm-synthetic;
                checked <=> root.confirmed-synthetic;
                enabled: !root.busy;
                toggled => { root.wizard-focus = 4; }
            }
        }

        if !root.free-space-ok: Rectangle {
            background: Theme.unsigned-well;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.unsigned-border;
            HorizontalLayout {
                spacing: 0;
                Rectangle { width: 4px; background: Theme.copper; border-top-left-radius: Theme.radius-sm; border-bottom-left-radius: Theme.radius-sm; }
                HorizontalLayout {
                    padding: 12px;
                    Text { text: Strings.freespace-warn; color: Theme.unsigned-text; font-size: Theme.font-body; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
                }
            }
        }

        if root.preflight-is-deny: Rectangle {
            background: Theme.deny-mist;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: #E8C4C4;
            HorizontalLayout {
                spacing: 0;
                Rectangle { width: 4px; background: Theme.deny; border-top-left-radius: Theme.radius-sm; border-bottom-left-radius: Theme.radius-sm; }
                HorizontalLayout {
                    padding: 12px;
                    Text { text: root.preflight-hint; color: Theme.deny; font-size: Theme.font-body; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; }
                }
            }
        }
    }
}

component PackagePlaceholder inherits Rectangle {
    vertical-stretch: 1;
    min-height: 140px;
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 4px;
            background: Theme.copper-dim;
            border-top-left-radius: Theme.radius;
            border-bottom-left-radius: Theme.radius;
        }
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 12px;
        alignment: center;
        horizontal-stretch: 1;
        // Package outline icon
        Rectangle {
            width: 52px;
            height: 58px;
            border-radius: 6px;
            background: transparent;
            border-width: 1.5px;
            border-color: Theme.placeholder-line;
            VerticalLayout {
                padding: 10px;
                spacing: 5px;
                alignment: center;
                Rectangle {
                    height: 4px;
                    width: 70%;
                    border-radius: 2px;
                    background: Theme.placeholder-line;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.placeholder-line;
                }
                Rectangle {
                    height: 4px;
                    width: 55%;
                    border-radius: 2px;
                    background: Theme.placeholder-line;
                }
                Text {
                    text: "PKG";
                    color: Theme.placeholder-line;
                    font-size: Theme.font-caption;
                    font-weight: 800;
                    font-family: "Menlo";
                    horizontal-alignment: center;
                }
            }
        }
        Text {
            text: Strings.seal-empty-title;
            color: Theme.readout;
            font-size: Theme.font-ui;
            font-weight: 700;
            font-family: "Avenir Next";
            horizontal-alignment: center;
        }
        Text {
            text: Strings.seal-empty-body;
            color: Theme.mute;
            font-size: Theme.font-body;
            font-family: "Avenir Next";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    }
}

component RunZone inherits Rectangle {
    in-out property <bool> busy;
    in-out property <bool> can-run;
    in-out property <bool> show-post-run;
    in-out property <bool> has-package;
    in-out property <bool> is-guided;
    in-out property <string> start-reason;
    in-out property <string> last-package;
    in-out property <string> evidence-sha256;
    in-out property <string> evidence-sha512;
    in-out property <string> evidence-size;
    in-out property <float> progress-fraction;
    in-out property <string> progress-label;
    in-out property <string> progress-phase;
    in-out property <string> throughput-label;
    in-out property <string> eta-label;
    in-out property <int> wizard-focus;
    in-out property <int> nav-index;
    in-out property <float> coverage-ok: 0.0;
    in-out property <float> coverage-err: 0.0;
    callback run-clicked;
    callback cancel-clicked;
    callback pause-clicked;
    callback fill-synthetic-clicked;
    callback verify-package-clicked;
    callback export-coc-clicked;
    callback clear-clicked;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    drop-shadow-blur: 12px;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        ZoneCaption { caption: Strings.zone-run-caption; }

        // Warning above START — click opens Cases when case ID is missing
        if !root.busy && !root.show-post-run && root.start-reason != "": Rectangle {
            background: Theme.deny-mist;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: #E8C4C4;
            HorizontalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "!";
                    color: Theme.deny;
                    font-size: 18px;
                    font-weight: 800;
                    font-family: "Menlo";
                    vertical-alignment: center;
                }
                Text {
                    text: root.start-reason;
                    color: Theme.deny;
                    font-size: Theme.font-ui;
                    font-weight: 700;
                    font-family: "Avenir Next";
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "→";
                    color: Theme.deny;
                    font-size: Theme.font-ui;
                    font-weight: 800;
                    font-family: "Menlo";
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-index = 1; }
            }
        }

        if !root.busy && !root.show-post-run: Rectangle {
            height: 56px;
            border-radius: Theme.radius-lg;
            background: root.can-run
                ? (cta.has-hover ? Theme.copper-hover : Theme.copper-deep)
                : Theme.raised;
            border-width: root.can-run ? 0 : 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: root.can-run ? 8px : 0px;
            drop-shadow-color: #AF622E33;
            drop-shadow-offset-y: root.can-run ? 2px : 0px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: Strings.start-acquire;
                    color: root.can-run ? Theme.on-copper : Theme.mute;
                    font-size: 16px;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }
            }
            cta := TouchArea {
                enabled: root.can-run;
                mouse-cursor: root.can-run ? pointer : default;
                clicked => { root.wizard-focus = 5; root.run-clicked(); }
            }
        }
        if root.busy: Text {
            text: root.progress-phase + " · " + root.progress-label;
            color: Theme.readout;
            font-size: Theme.font-body;
            font-weight: 600;
            font-family: "Avenir Next";
        }
        if root.busy: Rectangle {
            height: 12px;
            border-radius: 6px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            Rectangle {
                x: 0;
                y: 0;
                height: 100%;
                width: parent.width * root.progress-fraction;
                background: Theme.copper;
                border-radius: 6px;
            }
        }
        if root.busy: CoverageBar { ok-frac: root.coverage-ok; err-frac: root.coverage-err; }
        if root.busy: HorizontalLayout {
            Text { text: root.throughput-label; color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; horizontal-stretch: 1; }
            Text { text: root.eta-label; color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; }
        }
        if root.busy: HorizontalLayout {
            spacing: Theme.space-sm;
            GhostBtn {
                label: Strings.pause-acquire;
                horizontal-stretch: 1;
                clicked => { root.pause-clicked(); }
            }
            GhostBtn {
                label: Strings.cancel;
                horizontal-stretch: 1;
                clicked => { root.cancel-clicked(); }
            }
        }

        if !root.busy && !root.show-post-run: Text {
            text: Strings.run-ready-hint;
            color: Theme.faint;
            font-size: Theme.font-caption;
            font-family: "Avenir Next";
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; min-height: 8px; }

        ZoneCaption { caption: Strings.evidence-seal; }

        if root.show-post-run: Rectangle {
            background: Theme.seal-ok;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.ok-glow;
            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-sm;
                Text { text: Strings.verified; color: Theme.ok-glow; font-size: 12px; font-weight: 800; font-family: "Avenir Next"; }
                Text { text: Strings.package + ": " + root.last-package; color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; wrap: word-wrap; }
                Text { text: Strings.sha-label + ": " + root.evidence-sha256; color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; wrap: word-wrap; }
                if root.evidence-sha512 != "(none)" && root.evidence-sha512 != "": Text {
                    text: Strings.sha512-label + ": " + root.evidence-sha512;
                    color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; wrap: word-wrap;
                }
                Text { text: Strings.size + ": " + root.evidence-size; color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    PrimaryBtn {
                        label: Strings.run-verify;
                        horizontal-stretch: 1;
                        clicked => { root.nav-index = 4; root.verify-package-clicked(); }
                    }
                    GhostBtn {
                        label: Strings.export-coc;
                        horizontal-stretch: 1;
                        clicked => { root.export-coc-clicked(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    GhostBtn {
                        label: Strings.nav-triage;
                        horizontal-stretch: 1;
                        clicked => { root.nav-index = 3; }
                    }
                    GhostBtn {
                        label: Strings.clear;
                        horizontal-stretch: 1;
                        clicked => { root.clear-clicked(); }
                    }
                }
            }
        }

        if !root.show-post-run && !root.busy: PackagePlaceholder { }
    }
}

// -------------------------------------------------------------------- window

export component AppWindow inherits Window {
    title: "Trareon Acquire";
    preferred-width: 1320px;
    preferred-height: 900px;
    min-width: Theme.window-min-w;
    min-height: Theme.window-min-h;
    background: Theme.void;

    // ============ Rust wiring surface (do not rename — main.rs depends on these) ============
    in-out property <int> mode-index: 1;
    in-out property <string> mode-guidance: "";
    in-out property <bool> show-path-editors: true;
    in-out property <string> case-identity: "";
    in-out property <string> case-id: "";
    in-out property <string> case-verify: "";
    in-out property <string> source-path: "";
    in-out property <string> output-dir: "";
    in-out property <bool> confirmed-synthetic: false;
    in-out property <string> status-line: "";
    in-out property <string> last-package: "(none)";
    in-out property <string> evidence-sha256: "(none)";
    in-out property <string> evidence-size: "(none)";
    in-out property <string> preflight-hint: "";
    in-out property <bool> preflight-is-deny: false;
    in-out property <bool> busy: false;
    in-out property <bool> dark-mode: false;
    in-out property <string> locale: "en";
    in-out property <int> nav-index: 0;
    in-out property <string> about-text: "";
    in-out property <float> progress-fraction: 0.0;
    in-out property <string> progress-label: "";
    in-out property <string> progress-phase: "";
    in-out property <string> write-blocker-line: "Write-blocker: —";
    in-out property <string> write-blocker-secondary: "";
    in-out property <bool> write-blocker-ready: true;
    in-out property <bool> wb-confirmed: false;
    in-out property <bool> blockish-source: false;
    in-out property <string> panel-detail: "";
    in-out property <string> disk-list: "";
    in-out property <[DiskLine]> disk-rows: [];
    in-out property <int> selected-disk: -1;
    in-out property <string> custody-timeline-text: "";
    in-out property <string> throughput-label: "— MiB/s";
    in-out property <string> eta-label: "ETA —";
    in-out property <float> coverage-ok: 0.0;
    in-out property <float> coverage-err: 0.0;
    in-out property <int> format-index: 0;
    in-out property <string> format-caption: "RAW + .fsnap (Path A candidate)";
    in-out property <bool> write-sha512: true;
    in-out property <string> segment-mib: "4096";
    in-out property <string> evidence-sha512: "(none)";
    in-out property <bool> id-power: false;
    in-out property <bool> id-network: false;
    in-out property <bool> id-encryption: false;
    in-out property <bool> id-anti: false;
    in-out property <bool> id-oov: false;
    in-out property <string> emergency-override: "";
    in-out property <string> case-title: "";
    in-out property <string> boot-image-path: "";
    in-out property <int> profile-index: 1;
    in-out property <string> profile-caption: "";
    in-out property <int> source-kind-index: 0;
    in-out property <string> source-kind-caption: "";
    in-out property <int> retry-index: 0;
    in-out property <string> retry-caption: "";
    in-out property <string> coc-device: "";
    in-out property <string> coc-media: "1";
    in-out property <string> coc-seq: "1";
    in-out property <string> coc-description: "";
    in-out property <string> compare-package-b: "";
    in-out property <string> multisource-b: "";
    in-out property <float> phase-opacity: 1.0;
    in-out property <string> footer-time: "";
    in-out property <string> footer-user: "";
    in-out property <string> footer-host: "";
    in-out property <string> detail-interface: "—";
    in-out property <string> detail-sectors: "—";
    in-out property <string> detail-sector-size: "—";
    in-out property <string> detail-partitions: "—";
    in-out property <string> detail-type: "—";
    in-out property <string> detail-readonly: "—";
    in-out property <bool> detail-readonly-ok: false;
    in-out property <string> case-subtitle: "";
    in-out property <string> app-version: "Version 0.1.0";
    in-out property <string> app-build: "";
    in-out property <bool> show-advanced: false;
    in-out property <int> wizard-focus: 1;

    // ============ New properties for the remounted shell ============
    in-out property <string> search-query: "";
    in-out property <string> status-evidence-text: "0";
    in-out property <string> status-coverage-text: "—";
    in-out property <string> status-mode-text: "Standard";
    in-out property <[CaseLine]> case-rows: [];
    in-out property <int> selected-case: -1;
    in-out property <string> case-filter: "";
    in-out property <bool> case-sort-by-id: false;
    in-out property <[ResultLine]> result-rows: [];
    in-out property <[LogLine]> log-rows: [];
    in-out property <[TimelineLine]> timeline-rows: [];
    in-out property <[ListingLine]> listing-rows: [];
    in-out property <[RecentLine]> recent-rows: [];
    in-out property <[ResultLine]> compare-rows: [];
    in-out property <bool> free-space-ok: true;
    in-out property <bool> show-draft-banner: false;
    in-out property <string> draft-summary: "";
    in-out property <string> toast-text: "";
    in-out property <bool> show-toast: false;
    in-out property <bool> show-confirm: false;
    in-out property <string> confirm-message: "";
    in-out property <string> confirm-action: "";
    in-out property <string> qr-image-path: "";
    in-out property <bool> reduce-motion: false;
    in-out property <bool> paused: false;

    // ============ Derived UX ============
    // is-compact is set imperatively from init/changed-width to avoid a reactive
    // binding loop between root.width and child min-widths.
    property <bool> is-compact: false;
    property <bool> is-guided: root.mode-index == 0;
    property <bool> is-expert: root.mode-index == 2;
    property <bool> has-package: root.last-package != "(none)" && root.last-package != "";
    property <bool> case-verify-ok: root.is-guided || root.case-id == "" || root.case-verify == root.case-id;
    property <bool> identify-complete: root.id-power && root.id-network && root.id-encryption && root.id-anti && root.id-oov;
    property <bool> identify-gate: (root.is-expert || root.blockish-source) && !root.identify-complete && root.emergency-override == "";
    property <bool> step-case-done: root.is-guided || root.case-id != "";
    property <bool> step-source-done: root.source-path != "";
    property <bool> step-wb-done: !root.blockish-source || root.wb-confirmed || root.write-blocker-ready;
    property <bool> step-confirm-done: root.confirmed-synthetic && root.case-verify-ok;
    property <bool> paths-ok: root.source-path != "" && root.output-dir != "";
    property <bool> can-start-guided: root.confirmed-synthetic && root.paths-ok && !root.busy;
    property <bool> can-start-std: root.can-start-guided && root.case-id != "" && root.case-verify-ok && root.step-wb-done && !root.preflight-is-deny && !root.identify-gate;
    property <bool> can-run: root.is-guided ? root.can-start-guided : root.can-start-std;
    property <bool> show-post-run: root.has-package && !root.busy;
    property <string> start-reason:
        root.busy ? Strings.reason-busy
        : root.preflight-is-deny ? root.preflight-hint
        : (!root.is-guided && root.case-id == "") ? Strings.reason-case
        : !root.case-verify-ok ? Strings.reason-verify
        : root.source-path == "" ? Strings.reason-source
        : root.output-dir == "" ? Strings.reason-output
        : !root.confirmed-synthetic ? Strings.reason-confirm
        : (root.blockish-source && !root.step-wb-done) ? Strings.reason-wb
        : root.identify-gate ? Strings.reason-identify
        : "";
    property <string> integrity-status:
        root.busy ? Strings.integrity-running
        : (root.evidence-sha256 != "(none)" ? Strings.integrity-sealed : Strings.integrity-ready);
    property <int> stage-current:
        (root.has-package && !root.busy) ? 3
        : (root.busy || root.step-confirm-done) ? 2
        : 1;

    // ============ Callbacks (do not rename) ============
    callback browse-source-clicked();
    callback browse-output-clicked();
    callback run-clicked();
    callback cancel-clicked();
    callback clear-clicked();
    callback fill-synthetic-clicked();
    callback export-coc-clicked();
    callback mode-changed(int);
    callback theme-toggled(bool);
    callback locale-toggled(string);
    callback instrument-refresh();
    callback refresh-disks-clicked();
    callback use-first-disk-clicked();
    callback disk-selected(int);
    callback refresh-cases-clicked();
    callback create-case-clicked();
    callback save-identify-clicked();
    callback probe-encryption-clicked();
    callback verify-package-clicked();
    callback hash-only-clicked();
    callback run-qms-clicked();
    callback run-triage-clicked();
    callback boot-plan-clicked();
    callback analysis-lite-clicked();
    callback format-changed(int);
    callback browse-package-clicked();
    callback profile-changed(int);
    callback source-kind-changed(int);
    callback retry-changed(int);
    callback export-full-coc-clicked();
    callback compare-packages-clicked();
    callback export-report-clicked();
    callback run-profile-clicked();
    callback multisource-clicked();
    callback browse-compare-clicked();
    callback search-submitted();
    callback case-selected(int);
    callback archive-case-clicked();
    callback refresh-case-rows();
    callback copy-text-clicked(string);
    callback pause-clicked();
    callback draft-resume-clicked();
    callback draft-discard-clicked();
    callback confirm-accepted();
    callback confirm-cancelled();
    callback open-user-guide-clicked();
    callback recent-selected(int);

    init => {
        Theme.apply(root.dark-mode);
        Strings.locale = root.locale;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.is-compact = root.width < 1100px;
    }
    changed dark-mode => {
        Theme.apply(root.dark-mode);
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed locale => { Strings.locale = root.locale; }
    changed width => { root.is-compact = root.width < 1100px; }

    VerticalLayout {
        // ============ Banner 26px ============
        Rectangle {
            height: Theme.banner-h;
            background: Theme.unsigned-well;
            border-color: Theme.unsigned-border;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: start;
                Text {
                    text: Strings.disclosure-banner;
                    color: Theme.unsigned-text;
                    font-size: Theme.font-body;
                    font-weight: 700;
                    font-family: "Avenir Next";
                    letter-spacing: 0.2px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // ============ Header 48px ============
        Rectangle {
            height: Theme.header-h;
            background: Theme.ink;
            border-color: Theme.hairline;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;
                // Brand
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 7px;
                    background: Theme.copper;
                    Text { text: "T"; color: Theme.on-copper; font-size: 16px; font-weight: 800; font-family: "Avenir Next"; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text {
                    text: "TRAREON";
                    color: Theme.readout;
                    font-size: Theme.font-ui;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    letter-spacing: 0.6px;
                    vertical-alignment: center;
                }
                Text { text: "|"; color: Theme.hairline; font-size: Theme.font-ui; vertical-alignment: center; }
                Text {
                    text: "ACQUIRE";
                    color: Theme.copper;
                    font-size: Theme.font-ui;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    vertical-alignment: center;
                }
                Text { text: "|"; color: Theme.hairline; font-size: Theme.font-ui; vertical-alignment: center; }
                // Case chip
                Rectangle {
                    height: 36px;
                    min-width: 128px;
                    border-radius: Theme.radius-sm;
                    background: root.case-id == "" ? Theme.unsigned-well : Theme.raised;
                    border-width: 1px;
                    border-color: root.case-id == "" ? Theme.copper : Theme.hairline;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 5px;
                        alignment: center;
                        if root.case-id == "": Text {
                            text: Strings.create-case;
                            color: Theme.copper;
                            font-size: Theme.font-body;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            vertical-alignment: center;
                        }
                        if root.case-id != "": Text {
                            text: Strings.chip-case + ":";
                            color: Theme.faint;
                            font-size: Theme.font-caption;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            vertical-alignment: center;
                        }
                        if root.case-id != "": Text {
                            text: root.case-id;
                            color: Theme.readout;
                            font-size: Theme.font-body;
                            font-weight: 700;
                            font-family: "Menlo";
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if !root.busy { root.nav-index = 1; } }
                    }
                }
                // Search
                Rectangle {
                    height: 36px;
                    min-width: root.is-compact ? 120px : 220px;
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "/";
                            color: Theme.faint;
                            font-size: Theme.font-label;
                            font-weight: 800;
                            font-family: "Menlo";
                            vertical-alignment: center;
                        }
                        LineEdit {
                            placeholder-text: Strings.search-placeholder;
                            text <=> root.search-query;
                            horizontal-stretch: 1;
                            accepted => { root.search-submitted(); }
                        }
                    }
                }
                // EN | ID
                HorizontalLayout {
                    spacing: 6px;
                    LocaleChip { label: Strings.lang-en; active: root.locale == "en"; clicked => { root.locale = "en"; root.locale-toggled("en"); } }
                    LocaleChip { label: Strings.lang-id; active: root.locale == "id"; clicked => { root.locale = "id"; root.locale-toggled("id"); } }
                }
                // Session time
                Text {
                    text: root.footer-time;
                    color: Theme.faint;
                    font-size: Theme.font-caption;
                    font-family: "Menlo";
                    vertical-alignment: center;
                }
                // Theme toggle
                Rectangle {
                    min-width: 64px;
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Text {
                            text: root.dark-mode ? Strings.theme-dark : Strings.theme-light;
                            color: Theme.readout;
                            font-size: Theme.font-label;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dark-mode = !root.dark-mode; root.theme-toggled(root.dark-mode); }
                    }
                }
            }
        }

        // ============ Rail + Main column ============
        HorizontalLayout {
            spacing: 0;

            // ---------- Rail ----------
            Rectangle {
                width: root.is-compact ? Theme.rail-w-compact : Theme.rail-w;
                background: Theme.ink;
                border-color: Theme.hairline;
                border-width: 1px;
                VerticalLayout {
                    padding-left: root.is-compact ? 8px : 14px;
                    padding-right: root.is-compact ? 8px : 14px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 6px;
                    if !root.is-compact: HorizontalLayout {
                        padding-left: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: Strings.rail-workflow;
                            color: Theme.faint;
                            font-size: Theme.font-caption;
                            font-weight: 800;
                            font-family: "Avenir Next";
                            letter-spacing: 0.8px;
                        }
                    }
                    NavItem { kind: "cases"; label: Strings.nav-cases; compact: root.is-compact; active: root.nav-index == 1; enabled: !root.busy; clicked => { root.nav-index = 1; } }
                    NavItem { kind: "identify"; label: Strings.nav-identify; compact: root.is-compact; active: root.nav-index == 2; enabled: !root.busy; clicked => { root.nav-index = 2; } }
                    NavItem { kind: "acquire"; label: Strings.nav-acquire; compact: root.is-compact; active: root.nav-index == 0; enabled: !root.busy; clicked => { root.nav-index = 0; } }
                    NavItem { kind: "triage"; label: Strings.nav-triage; compact: root.is-compact; active: root.nav-index == 3; enabled: !root.busy; clicked => { root.nav-index = 3; } }
                    Rectangle { height: 8px; }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    Rectangle { height: 6px; }
                    if !root.is-compact: HorizontalLayout {
                        padding-left: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: Strings.rail-lab;
                            color: Theme.faint;
                            font-size: Theme.font-caption;
                            font-weight: 800;
                            font-family: "Avenir Next";
                            letter-spacing: 0.8px;
                        }
                    }
                    NavItem { kind: "tools"; label: Strings.nav-tools; compact: root.is-compact; active: root.nav-index == 4; enabled: !root.busy; clicked => { root.nav-index = 4; } }
                    NavItem { kind: "qms"; label: Strings.nav-qms; compact: root.is-compact; active: root.nav-index == 5; enabled: !root.busy; clicked => { root.nav-index = 5; } }
                    NavItem { kind: "boot"; label: Strings.nav-boot; compact: root.is-compact; active: root.nav-index == 6; enabled: !root.busy; clicked => { root.nav-index = 6; } }
                    Rectangle { height: 8px; }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    Rectangle { height: 6px; }
                    if !root.is-compact: HorizontalLayout {
                        padding-left: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: Strings.rail-support;
                            color: Theme.faint;
                            font-size: Theme.font-caption;
                            font-weight: 800;
                            font-family: "Avenir Next";
                            letter-spacing: 0.8px;
                        }
                    }
                    NavItem { kind: "help"; label: Strings.nav-help; compact: root.is-compact; active: root.nav-index == 7; clicked => { root.nav-index = 7; } }
                    NavItem { kind: "about"; label: Strings.nav-about; compact: root.is-compact; active: root.nav-index == 8; clicked => { root.nav-index = 8; } }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ---------- Main column ----------
            VerticalLayout {
                // Safety strip 36px
                Rectangle {
                    height: Theme.safety-h;
                    background: Theme.panel;
                    border-color: Theme.hairline;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        SafetyChip {
                            caption: Strings.chip-case;
                            value: root.case-id == "" ? Strings.create-case : root.case-id;
                            warn: root.case-id == "";
                            clickable: !root.busy;
                            clicked => { if !root.busy { root.nav-index = 1; } }
                        }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        SafetyChip {
                            caption: Strings.chip-wb;
                            value: root.write-blocker-ready ? "OK" : (root.wb-confirmed ? "confirmed" : "confirm");
                            ok: root.write-blocker-ready;
                            warn: !root.write-blocker-ready && !root.wb-confirmed;
                            clickable: !root.busy;
                            clicked => { root.instrument-refresh(); root.wizard-focus = 3; if !root.busy { root.nav-index = 0; } }
                        }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        SafetyChip {
                            caption: Strings.chip-integrity;
                            value: root.integrity-status;
                            ok: root.integrity-status == Strings.integrity-sealed || root.integrity-status == Strings.integrity-ready;
                            clickable: root.has-package && !root.busy;
                            clicked => { if root.has-package && !root.busy { root.nav-index = 4; } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Compact stage tabs with icons
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            background: Theme.stage-track;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                StageTab { glyph: "1"; label: Strings.stage-prepare; done: root.stage-current >= 1; current: root.stage-current == 1; }
                                StageTab { glyph: "2"; label: Strings.stage-acquire; done: root.stage-current >= 2; current: root.stage-current == 2; }
                                StageTab { glyph: "3"; label: Strings.stage-seal; done: root.stage-current >= 3; current: root.stage-current == 3; }
                            }
                        }
                    }
                }

                // Identify-gate banner
                if root.identify-gate: Rectangle {
                    height: 52px;
                    background: Theme.unsigned-well;
                    border-color: Theme.unsigned-border;
                    border-width: 1px;
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle {
                            width: 4px;
                            background: Theme.copper;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            alignment: start;
                            horizontal-stretch: 1;
                            Text {
                                text: Strings.identify-gate-banner;
                                color: Theme.unsigned-text;
                                font-size: Theme.font-ui;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            GhostBtn {
                                label: Strings.open-identify;
                                horizontal-stretch: 0;
                                min-width: 140px;
                                clicked => { root.nav-index = 2; }
                            }
                        }
                    }
                }

                // Body
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.void;

                    // ===== ACQUIRE — wide (3 zones) =====
                    if root.nav-index == 0 && !root.is-compact: VerticalLayout {
                        padding: Theme.space-xl;
                        spacing: Theme.space-md;
                        if root.show-draft-banner: DraftBanner {
                            summary: root.draft-summary == "" ? Strings.draft-banner : root.draft-summary;
                            resume-clicked => { root.draft-resume-clicked(); }
                            discard-clicked => {
                                root.confirm-message = Strings.confirm-discard-draft;
                                root.confirm-action = "discard-draft";
                                root.show-confirm = true;
                            }
                        }
                    HorizontalLayout {
                        spacing: Theme.space-lg;
                        SourceZone {
                            horizontal-stretch: 42;
                            min-width: Theme.zone-source-min;
                            is-guided: root.is-guided;
                            is-expert: root.is-expert;
                            busy: root.busy;
                            disk-rows: root.disk-rows;
                            selected-disk: root.selected-disk;
                            detail-interface: root.detail-interface;
                            detail-sectors: root.detail-sectors;
                            detail-sector-size: root.detail-sector-size;
                            detail-partitions: root.detail-partitions;
                            detail-type: root.detail-type;
                            detail-readonly: root.detail-readonly;
                            detail-readonly-ok: root.detail-readonly-ok;
                            blockish-source: root.blockish-source;
                            wb-confirmed <=> root.wb-confirmed;
                            wizard-focus <=> root.wizard-focus;
                            refresh-clicked => { root.refresh-disks-clicked(); }
                            browse-source-clicked => { root.browse-source-clicked(); }
                            fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                            use-first-disk-clicked => { root.use-first-disk-clicked(); }
                            disk-selected(i) => { root.disk-selected(i); }
                        }
                        PrepareZone {
                            horizontal-stretch: 33;
                            min-width: Theme.zone-prepare-min;
                            is-guided: root.is-guided;
                            mode-index <=> root.mode-index;
                            busy: root.busy;
                            show-advanced <=> root.show-advanced;
                            format-index <=> root.format-index;
                            format-caption: root.format-caption;
                            profile-index <=> root.profile-index;
                            source-kind-index <=> root.source-kind-index;
                            retry-index <=> root.retry-index;
                            segment-mib <=> root.segment-mib;
                            multisource-b <=> root.multisource-b;
                            write-sha512 <=> root.write-sha512;
                            show-path-editors: root.show-path-editors;
                            source-path <=> root.source-path;
                            output-dir <=> root.output-dir;
                            case-id: root.case-id;
                            case-verify <=> root.case-verify;
                            case-verify-ok: root.case-verify-ok;
                            confirmed-synthetic <=> root.confirmed-synthetic;
                            wizard-focus <=> root.wizard-focus;
                            preflight-is-deny: root.preflight-is-deny;
                            preflight-hint: root.preflight-hint;
                            free-space-ok: root.free-space-ok;
                            mode-changed(i) => { root.mode-changed(i); }
                            format-changed(i) => { root.format-changed(i); }
                            profile-changed(i) => { root.profile-changed(i); }
                            source-kind-changed(i) => { root.source-kind-changed(i); }
                            retry-changed(i) => { root.retry-changed(i); }
                            run-profile-clicked => { root.run-profile-clicked(); }
                            multisource-clicked => { root.multisource-clicked(); }
                            browse-source-clicked => { root.browse-source-clicked(); }
                            browse-output-clicked => { root.browse-output-clicked(); }
                        }
                        RunZone {
                            horizontal-stretch: 25;
                            min-width: Theme.zone-run-min;
                            busy: root.busy;
                            can-run: root.can-run;
                            show-post-run: root.show-post-run;
                            has-package: root.has-package;
                            is-guided: root.is-guided;
                            start-reason: root.start-reason;
                            last-package: root.last-package;
                            evidence-sha256: root.evidence-sha256;
                            evidence-sha512: root.evidence-sha512;
                            evidence-size: root.evidence-size;
                            progress-fraction: root.progress-fraction;
                            progress-label: root.progress-label;
                            progress-phase: root.progress-phase;
                            throughput-label: root.throughput-label;
                            eta-label: root.eta-label;
                            coverage-ok: root.coverage-ok;
                            coverage-err: root.coverage-err;
                            wizard-focus <=> root.wizard-focus;
                            nav-index <=> root.nav-index;
                            run-clicked => { root.run-clicked(); }
                            cancel-clicked => { root.cancel-clicked(); }
                            pause-clicked => { root.pause-clicked(); }
                            fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                            verify-package-clicked => { root.verify-package-clicked(); }
                            export-coc-clicked => { root.export-coc-clicked(); }
                            clear-clicked => {
                                root.confirm-message = Strings.confirm-clear;
                                root.confirm-action = "clear";
                                root.show-confirm = true;
                            }
                        }
                    }
                    }

                    // ===== ACQUIRE — compact (stacked) =====
                    if root.nav-index == 0 && root.is-compact: ScrollView {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;
                            if root.show-draft-banner: DraftBanner {
                                summary: root.draft-summary == "" ? Strings.draft-banner : root.draft-summary;
                                resume-clicked => { root.draft-resume-clicked(); }
                                discard-clicked => {
                                    root.confirm-message = Strings.confirm-discard-draft;
                                    root.confirm-action = "discard-draft";
                                    root.show-confirm = true;
                                }
                            }
                            SourceZone {
                                is-guided: root.is-guided;
                                is-expert: root.is-expert;
                                busy: root.busy;
                                disk-rows: root.disk-rows;
                                selected-disk: root.selected-disk;
                                detail-interface: root.detail-interface;
                                detail-sectors: root.detail-sectors;
                                detail-sector-size: root.detail-sector-size;
                                detail-partitions: root.detail-partitions;
                                detail-type: root.detail-type;
                                detail-readonly: root.detail-readonly;
                                detail-readonly-ok: root.detail-readonly-ok;
                                blockish-source: root.blockish-source;
                                wb-confirmed <=> root.wb-confirmed;
                                wizard-focus <=> root.wizard-focus;
                                refresh-clicked => { root.refresh-disks-clicked(); }
                                browse-source-clicked => { root.browse-source-clicked(); }
                                fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                                use-first-disk-clicked => { root.use-first-disk-clicked(); }
                                disk-selected(i) => { root.disk-selected(i); }
                            }
                            PrepareZone {
                                is-guided: root.is-guided;
                                mode-index <=> root.mode-index;
                                busy: root.busy;
                                show-advanced <=> root.show-advanced;
                                format-index <=> root.format-index;
                                format-caption: root.format-caption;
                                profile-index <=> root.profile-index;
                                source-kind-index <=> root.source-kind-index;
                                retry-index <=> root.retry-index;
                                segment-mib <=> root.segment-mib;
                                multisource-b <=> root.multisource-b;
                                write-sha512 <=> root.write-sha512;
                                show-path-editors: root.show-path-editors;
                                source-path <=> root.source-path;
                                output-dir <=> root.output-dir;
                                case-id: root.case-id;
                                case-verify <=> root.case-verify;
                                case-verify-ok: root.case-verify-ok;
                                confirmed-synthetic <=> root.confirmed-synthetic;
                                wizard-focus <=> root.wizard-focus;
                                preflight-is-deny: root.preflight-is-deny;
                                preflight-hint: root.preflight-hint;
                                free-space-ok: root.free-space-ok;
                                mode-changed(i) => { root.mode-changed(i); }
                                format-changed(i) => { root.format-changed(i); }
                                profile-changed(i) => { root.profile-changed(i); }
                                source-kind-changed(i) => { root.source-kind-changed(i); }
                                retry-changed(i) => { root.retry-changed(i); }
                                run-profile-clicked => { root.run-profile-clicked(); }
                                multisource-clicked => { root.multisource-clicked(); }
                                browse-source-clicked => { root.browse-source-clicked(); }
                                browse-output-clicked => { root.browse-output-clicked(); }
                            }
                            RunZone {
                                busy: root.busy;
                                can-run: root.can-run;
                                show-post-run: root.show-post-run;
                                has-package: root.has-package;
                                is-guided: root.is-guided;
                                start-reason: root.start-reason;
                                last-package: root.last-package;
                                evidence-sha256: root.evidence-sha256;
                                evidence-sha512: root.evidence-sha512;
                                evidence-size: root.evidence-size;
                                progress-fraction: root.progress-fraction;
                                progress-label: root.progress-label;
                                progress-phase: root.progress-phase;
                                throughput-label: root.throughput-label;
                                eta-label: root.eta-label;
                                coverage-ok: root.coverage-ok;
                                coverage-err: root.coverage-err;
                                wizard-focus <=> root.wizard-focus;
                                nav-index <=> root.nav-index;
                                run-clicked => { root.run-clicked(); }
                                cancel-clicked => { root.cancel-clicked(); }
                                pause-clicked => { root.pause-clicked(); }
                                fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                                verify-package-clicked => { root.verify-package-clicked(); }
                                export-coc-clicked => { root.export-coc-clicked(); }
                                clear-clicked => {
                                    root.confirm-message = Strings.confirm-clear;
                                    root.confirm-action = "clear";
                                    root.show-confirm = true;
                                }
                            }
                        }
                    }

                    // ===== CASES =====
                    if root.nav-index == 1: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-cases-title; body: Strings.shell-cases-body; }
                            if root.case-id != "": HorizontalLayout {
                                spacing: 8px;
                                ZoneCaption { caption: Strings.active-case; }
                                StatusBadge { label: root.case-id; warn: true; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 8px;
                                        HorizontalLayout {
                                            ZoneCaption { caption: Strings.case-list; }
                                            Rectangle { horizontal-stretch: 1; }
                                            GhostBtn {
                                                label: root.case-sort-by-id ? Strings.sort-id : Strings.sort-updated;
                                                horizontal-stretch: 0;
                                                min-width: 140px;
                                                clicked => { root.case-sort-by-id = !root.case-sort-by-id; root.refresh-case-rows(); }
                                            }
                                        }
                                        LineEdit {
                                            placeholder-text: Strings.filter-cases;
                                            text <=> root.case-filter;
                                            horizontal-stretch: 1;
                                            accepted => { root.refresh-case-rows(); }
                                        }
                                        if root.case-rows.length == 0: EmptyHint { title: Strings.cases-empty-title; body: Strings.cases-empty-body; }
                                        if root.case-rows.length > 0: Rectangle {
                                            height: 40px; background: Theme.table-head; border-radius: Theme.radius-sm;
                                            HorizontalLayout {
                                                padding-left: 12px; spacing: 10px;
                                                Text { text: Strings.col-id; width: 140px; color: Theme.faint; font-size: Theme.font-label; font-weight: 700; vertical-alignment: center; }
                                                Text { text: Strings.col-title; horizontal-stretch: 1; color: Theme.faint; font-size: Theme.font-label; font-weight: 700; vertical-alignment: center; }
                                                Text { text: Strings.col-examiner; width: 100px; color: Theme.faint; font-size: Theme.font-label; font-weight: 700; vertical-alignment: center; }
                                                Text { text: Strings.col-state; width: 80px; color: Theme.faint; font-size: Theme.font-label; font-weight: 700; vertical-alignment: center; }
                                            }
                                        }
                                        for row[idx] in root.case-rows: CaseRow {
                                            id: row.id; title: row.title; examiner: row.examiner; state: row.state; updated: row.updated;
                                            active: root.selected-case == idx || root.case-id == row.id;
                                            clicked => { root.case-selected(idx); }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            GhostBtn { label: Strings.refresh-cases; clicked => { root.refresh-cases-clicked(); root.refresh-case-rows(); } }
                                            GhostBtn {
                                                label: Strings.archive-case;
                                                enabled: root.case-id != "";
                                                clicked => {
                                                    root.confirm-message = Strings.confirm-archive;
                                                    root.confirm-action = "archive";
                                                    root.show-confirm = true;
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 2;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 10px;
                                        ZoneCaption { caption: Strings.create-case-heading; }
                                        LineEdit { placeholder-text: Strings.case-title-ph; text <=> root.case-title; }
                                        LineEdit { placeholder-text: Strings.examiner-ph; text <=> root.case-identity; }
                                        PrimaryBtn { label: Strings.create-case; clicked => { root.create-case-clicked(); } }
                                        GhostBtn { label: Strings.continue-identify; clicked => { root.nav-index = 2; } }
                                        GhostBtn { label: Strings.open-acquire; clicked => { root.nav-index = 0; } }
                                    }
                                }
                            }
                        }
                    }

                    // ===== IDENTIFY =====
                    if root.nav-index == 2: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-identify-title; body: Strings.shell-identify-body; }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 8px;
                                        ZoneCaption { caption: Strings.checklist-heading; }
                                        Text {
                                            text: Strings.chip-case + ": " + (root.case-id == "" ? "—" : root.case-id);
                                            color: root.case-id == "" ? Theme.faint : Theme.readout;
                                            font-size: Theme.font-ui;
                                            font-weight: 700;
                                            font-family: "Avenir Next";
                                        }
                                        CheckRow { label: Strings.id-power; hint: Strings.id-power-hint; checked <=> root.id-power; }
                                        CheckRow { label: Strings.id-network; hint: Strings.id-network-hint; checked <=> root.id-network; }
                                        CheckRow { label: Strings.id-encryption; hint: Strings.id-encryption-hint; checked <=> root.id-encryption; }
                                        CheckRow { label: Strings.id-anti; hint: Strings.id-anti-hint; checked <=> root.id-anti; }
                                        CheckRow { label: Strings.id-oov; hint: Strings.id-oov-hint; checked <=> root.id-oov; }
                                        ZoneCaption { caption: Strings.emergency-override-label; }
                                        LineEdit { placeholder-text: Strings.emergency-override-ph; text <=> root.emergency-override; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            PrimaryBtn { label: Strings.save-identify; clicked => { root.save-identify-clicked(); } }
                                            GhostBtn { label: Strings.probe-encryption; clicked => { root.probe-encryption-clicked(); } }
                                            GhostBtn { label: Strings.continue-acquire; clicked => { root.nav-index = 0; } }
                                        }
                                        for line in root.log-rows: LogLineRow { level: line.level; text: line.text; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 2;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 10px;
                                        ZoneCaption { caption: Strings.why-matters-title; }
                                        Text { text: Strings.why-matters-body; color: Theme.readout; font-size: Theme.font-body; font-family: "Avenir Next"; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    // ===== TRIAGE =====
                    if root.nav-index == 3: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-triage-title; body: Strings.shell-triage-body; }
                            PrimaryBtn {
                                label: Strings.run-triage;
                                horizontal-stretch: 0;
                                min-width: 200px;
                                clicked => { root.run-triage-clicked(); }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 6px;
                                    if root.log-rows.length == 0: EmptyHint { title: Strings.triage-empty; body: root.panel-detail; }
                                    for line in root.log-rows: LogLineRow { level: line.level; text: line.text; }
                                }
                            }
                        }
                    }

                    // ===== TOOLS =====
                    if root.nav-index == 4: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-tools-title; body: Strings.shell-tools-body; }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    horizontal-stretch: 3;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 8px;
                                        HorizontalLayout {
                                            ZoneCaption { caption: Strings.last-package; }
                                            Rectangle { horizontal-stretch: 1; }
                                            StatusBadge {
                                                label: root.has-package ? Strings.sealed-label : Strings.unsealed-label;
                                                ok: root.has-package;
                                                warn: !root.has-package;
                                            }
                                        }
                                        if !root.has-package: EmptyHint { title: Strings.tools-empty-package; body: Strings.tools-empty-body; }
                                        if root.has-package: MetaRow { caption: "PATH"; value: root.last-package; copyable: true; copy-clicked => { root.copy-text-clicked(root.last-package); } }
                                        if root.has-package: MetaRow { caption: "SHA-256"; value: root.evidence-sha256; copyable: true; copy-clicked => { root.copy-text-clicked(root.evidence-sha256); } }
                                        if root.has-package: MetaRow { caption: "SHA-512"; value: root.evidence-sha512; copyable: true; copy-clicked => { root.copy-text-clicked(root.evidence-sha512); } }
                                        if root.has-package: MetaRow { caption: Strings.size; value: root.evidence-size; }
                                        ZoneCaption { caption: Strings.custody-timeline; }
                                        for line in root.log-rows: LogLineRow { level: line.level; text: line.text; }
                                        if root.qr-image-path != "": ZoneCaption { caption: Strings.qr-preview; }
                                        if root.qr-image-path != "": Text { text: root.qr-image-path; color: Theme.mute; font-size: Theme.font-body; font-family: "Menlo"; wrap: word-wrap; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 2;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 8px;
                                        ZoneCaption { caption: Strings.tools-actions; }
                                        GhostBtn { label: Strings.browse-package; clicked => { root.browse-package-clicked(); } }
                                        PrimaryBtn { label: Strings.run-verify; clicked => { root.verify-package-clicked(); } }
                                        GhostBtn { label: Strings.run-hash; clicked => { root.hash-only-clicked(); } }
                                        GhostBtn { label: Strings.export-full-coc; clicked => { root.export-full-coc-clicked(); } }
                                        GhostBtn { label: Strings.export-report; clicked => { root.export-report-clicked(); } }
                                        GhostBtn { label: Strings.analysis-lite; clicked => { root.analysis-lite-clicked(); } }
                                        ZoneCaption { caption: Strings.coc-form-label; }
                                        LineEdit { placeholder-text: Strings.coc-device; text <=> root.coc-device; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            LineEdit { placeholder-text: Strings.coc-media; text <=> root.coc-media; }
                                            LineEdit { placeholder-text: Strings.coc-seq; text <=> root.coc-seq; }
                                        }
                                        LineEdit { placeholder-text: Strings.coc-description; text <=> root.coc-description; }
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 8px;
                                    ZoneCaption { caption: Strings.compare-summary; }
                                    LineEdit { placeholder-text: Strings.compare-package-b-ph; text <=> root.compare-package-b; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        GhostBtn { label: Strings.browse-compare; clicked => { root.browse-compare-clicked(); } }
                                        PrimaryBtn { label: Strings.compare-packages; clicked => { root.compare-packages-clicked(); } }
                                    }
                                    for row in root.compare-rows: ResultRow { name: row.name; ok: row.ok; detail: row.detail; }
                                }
                            }
                            if root.recent-rows.length > 0: Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 6px;
                                    ZoneCaption { caption: Strings.recent-packages; }
                                    for row[idx] in root.recent-rows: Rectangle {
                                        height: 44px; border-radius: Theme.radius-sm; background: rta.has-hover ? Theme.raised : transparent;
                                        border-width: 1px;
                                        border-color: rta.has-hover ? Theme.hairline : transparent;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: 10px;
                                            Text { text: row.case-id; width: 140px; color: Theme.copper; font-size: Theme.font-ui; font-weight: 700; font-family: "Menlo"; vertical-alignment: center; }
                                            Text { text: row.package-path; horizontal-stretch: 1; color: Theme.mute; font-size: Theme.font-mono; font-family: "Menlo"; vertical-alignment: center; overflow: elide; }
                                        }
                                        rta := TouchArea { mouse-cursor: pointer; clicked => { root.recent-selected(idx); } }
                                    }
                                }
                            }
                            if root.timeline-rows.length > 0 || root.listing-rows.length > 0: HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 6px;
                                        ZoneCaption { caption: Strings.analysis-timeline; }
                                        for row in root.timeline-rows: Text {
                                            text: row.when + " · " + row.what;
                                            color: Theme.readout; font-size: Theme.font-body; font-family: "Menlo"; wrap: word-wrap;
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                    VerticalLayout {
                                        padding: Theme.space-lg; spacing: 6px;
                                        ZoneCaption { caption: Strings.analysis-listing; }
                                        for row in root.listing-rows: Text {
                                            text: row.path + " · " + row.size;
                                            color: Theme.mute; font-size: Theme.font-caption; font-family: "Menlo"; overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ===== QMS =====
                    if root.nav-index == 5: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-qms-title; body: Strings.shell-qms-body; }
                            PrimaryBtn {
                                label: Strings.run-qms;
                                horizontal-stretch: 0;
                                min-width: 200px;
                                clicked => { root.run-qms-clicked(); }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 8px;
                                    if root.result-rows.length == 0: EmptyHint { title: Strings.qms-empty; body: root.panel-detail; }
                                    for row in root.result-rows: ResultRow { name: row.name; ok: row.ok; detail: row.detail; }
                                }
                            }
                        }
                    }

                    // ===== BOOT =====
                    if root.nav-index == 6: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-boot-title; body: Strings.shell-boot-body; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        LineEdit { placeholder-text: Strings.boot-image-ph; text <=> root.boot-image-path; horizontal-stretch: 1; }
                                        PrimaryBtn { label: Strings.boot-plan; clicked => { root.boot-plan-clicked(); } }
                                    }
                                    if root.log-rows.length == 0: EmptyHint { title: Strings.boot-empty; body: root.panel-detail; }
                                    for line in root.log-rows: LogLineRow { level: line.level; text: line.text; }
                                }
                            }
                        }
                    }

                    // ===== HELP / SETTINGS =====
                    if root.nav-index == 7: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: 14px;
                            PageHeader { title: Strings.shell-help-title; body: Strings.shell-help-body; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: 12px;
                                    ZoneCaption { caption: Strings.settings-label; }
                                    LabCheck {
                                        label: Strings.theme-dark;
                                        checked <=> root.dark-mode;
                                        toggled => { root.theme-toggled(root.dark-mode); }
                                    }
                                    LabCheck { label: Strings.reduced-motion; checked <=> root.reduce-motion; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: Strings.locale-label;
                                            color: Theme.mute;
                                            font-size: Theme.font-body;
                                            font-family: "Avenir Next";
                                            vertical-alignment: center;
                                        }
                                        LocaleChip { label: Strings.lang-en; active: root.locale == "en"; clicked => { root.locale = "en"; root.locale-toggled("en"); } }
                                        LocaleChip { label: Strings.lang-id; active: root.locale == "id"; clicked => { root.locale = "id"; root.locale-toggled("id"); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    LineEdit { placeholder-text: Strings.default-examiner-ph; text <=> root.case-identity; }
                                    GhostBtn {
                                        label: Strings.open-user-guide;
                                        horizontal-stretch: 0;
                                        min-width: 180px;
                                        clicked => { root.open-user-guide-clicked(); }
                                    }
                                }
                            }
                            ZoneCaption { caption: "TOPICS"; }
                            HelpTopic { title: "Write-blocker"; body: Strings.help_wb; }
                            HelpTopic { title: "Out of validation"; body: Strings.help_oov; }
                            HelpTopic { title: "Seal vs signature"; body: Strings.help_seal_vs_sig; }
                            HelpTopic { title: "Formats"; body: Strings.help_formats; }
                            HelpTopic { title: "Shortcuts"; body: Strings.help_shortcuts; }
                        }
                    }

                    // ===== ABOUT =====
                    if root.nav-index == 8: ScrollView {
                        VerticalLayout {
                            padding: Theme.page-pad;
                            spacing: Theme.space-md;
                            PageHeader { title: "TRAREON ACQUIRE"; body: Strings.about-product; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: Theme.space-md;
                                    ZoneCaption { caption: Strings.about-build; }
                                    Text { text: root.about-text; color: Theme.readout; font-size: Theme.font-mono; font-family: "Menlo"; wrap: word-wrap; }
                                    MetaRow { caption: Strings.about-version-label; value: root.app-version; }
                                    MetaRow { caption: Strings.build-label; value: root.app-build == "" ? "—" : root.app-build; }
                                    Text { text: Strings.license-gpl; color: Theme.mute; font-size: Theme.font-body; font-family: "Avenir Next"; wrap: word-wrap; }
                                    Text { text: Strings.alpha-line; color: Theme.faint; font-size: Theme.font-caption; font-family: "Menlo"; }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                drop-shadow-blur: 10px; drop-shadow-color: Theme.card-shadow; drop-shadow-offset-y: 2px;
                                VerticalLayout {
                                    padding: Theme.space-lg; spacing: Theme.space-sm;
                                    ZoneCaption { caption: Strings.session-label; }
                                    MetaRow { caption: Strings.footer-time-label; value: root.footer-time; }
                                    MetaRow { caption: Strings.footer-user-label; value: root.footer-user; }
                                    MetaRow { caption: Strings.footer-host-label; value: root.footer-host; }
                                }
                            }
                        }
                    }

                    // Toast
                    if root.show-toast: Rectangle {
                        height: 48px;
                        background: Theme.ok-mist;
                        border-width: 1px;
                        border-color: Theme.ok-glow;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #2F855A22;
                        drop-shadow-offset-y: -2px;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;
                            Text {
                                text: "OK";
                                color: Theme.ok-glow;
                                font-size: Theme.font-caption;
                                font-weight: 800;
                                font-family: "Menlo";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.toast-text;
                                color: Theme.ok-glow;
                                font-size: Theme.font-ui;
                                font-weight: 700;
                                font-family: "Avenir Next";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // Status strip — hardware-first
                Rectangle {
                    height: Theme.status-h;
                    background: Theme.footer-bg;
                    border-color: Theme.hairline;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 14px;
                        alignment: start;
                        HwStatus {
                            glyph: "D";
                            label: Strings.hw-disks + " " + root.status-evidence-text;
                            ok: root.disk-rows.length > 0;
                            warn: root.disk-rows.length == 0;
                        }
                        HwStatus {
                            glyph: "B";
                            label: Strings.hw-blocker;
                            ok: root.write-blocker-ready;
                            warn: !root.write-blocker-ready && !root.wb-confirmed;
                        }
                        HwStatus {
                            glyph: "I";
                            label: Strings.hw-integrity + " " + root.integrity-status;
                            ok: root.integrity-status == Strings.integrity-sealed || root.integrity-status == Strings.integrity-ready;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: Strings.status-coverage;
                                color: Theme.mute;
                                font-size: Theme.font-body;
                                font-family: "Menlo";
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 88px;
                                height: 10px;
                                border-radius: 5px;
                                background: Theme.raised;
                                border-width: 1px;
                                border-color: Theme.hairline;
                                y: (parent.height - self.height) / 2;
                                if root.busy: Rectangle {
                                    x: 0;
                                    y: 0;
                                    height: 100%;
                                    width: parent.width * root.coverage-ok;
                                    background: Theme.ok-glow;
                                    border-radius: 5px;
                                }
                            }
                            Text {
                                text: root.status-coverage-text;
                                color: Theme.mute;
                                font-size: Theme.font-body;
                                font-family: "Menlo";
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-confirm: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #1E2A3644;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    background: Theme.panel;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    drop-shadow-blur: 28px;
                    drop-shadow-color: Theme.card-shadow;
                    drop-shadow-offset-y: 8px;
                    VerticalLayout {
                        padding: Theme.space-xl;
                        spacing: Theme.space-lg;
                        ZoneCaption { caption: Strings.confirm-heading; }
                        Text {
                            text: root.confirm-message;
                            color: Theme.readout;
                            font-size: Theme.font-ui;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            GhostBtn {
                                label: Strings.confirm-no;
                                horizontal-stretch: 1;
                                clicked => { root.show-confirm = false; root.confirm-cancelled(); }
                            }
                            PrimaryBtn {
                                label: Strings.confirm-yes;
                                horizontal-stretch: 1;
                                clicked => { root.show-confirm = false; root.confirm-accepted(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
