// Remounted ASCII shell — banner + header + rail + safety + zones + status + about.
// Responsive: >=1100px shows 3 zones side-by-side; <1100px stacks in a ScrollView with icon rail.
// All in-out properties and callbacks below are consumed by Rust (src/main.rs) — do not rename.

import { Button, CheckBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export struct DiskLine {
    path: string,
    device: string,
    model: string,
    serial: string,
    size: string,
    bus: string,
}

// -------------------------------------------------------------------- primitives

component NavItem inherits Rectangle {
    in-out property <string> glyph: "·";
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> enabled: true;
    in-out property <bool> compact: false;
    callback clicked;
    height: 36px;
    background: root.active ? Theme.rail-active : transparent;
    border-radius: Theme.radius-sm;
    if !root.compact: HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 3px;
            background: root.active ? Theme.copper : transparent;
            border-radius: 1px;
        }
        Text {
            text: root.glyph;
            width: 18px;
            color: root.active ? Theme.copper : Theme.mute;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.copper : Theme.readout;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            font-family: "Avenir Next";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if root.compact: HorizontalLayout {
        alignment: center;
        Text {
            text: root.glyph;
            color: root.active ? Theme.copper : Theme.mute;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ModeChip inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> locked: false;
    callback clicked;
    height: 26px;
    min-width: 64px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.copper : Theme.hairline;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: 11px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FormatChip inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    in-out property <bool> locked: false;
    callback clicked;
    height: 26px;
    min-width: 56px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : Theme.raised;
    border-width: 1px;
    border-color: root.active ? Theme.copper : Theme.hairline;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: 11px;
            font-weight: 600;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: !root.locked;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LocaleChip inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active;
    callback clicked;
    height: 26px;
    min-width: 34px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.copper : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.copper : Theme.hairline;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.on-copper : Theme.readout;
            font-size: 11px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component StageDot inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> done;
    in-out property <bool> current;
    HorizontalLayout {
        spacing: 5px;
        alignment: center;
        Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: (root.done || root.current) ? Theme.copper : transparent;
            border-width: 1px;
            border-color: (root.done || root.current) ? Theme.copper : Theme.hairline;
        }
        Text {
            text: root.label;
            color: root.current ? Theme.copper : (root.done ? Theme.readout : Theme.mute);
            font-size: 10px;
            font-weight: root.current ? 800 : 600;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
}

component SafetyChip inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <bool> ok: false;
    in-out property <bool> warn: false;
    in-out property <bool> clickable: true;
    callback clicked;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.caption + ":";
            color: Theme.faint;
            font-size: 10px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.readout);
            font-size: 11px;
            font-weight: 600;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
    }
    TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// -------------------------------------------------------------------- zones

component SourceZone inherits Rectangle {
    in-out property <bool> is-guided;
    in-out property <bool> is-expert;
    in-out property <bool> busy;
    in-out property <[DiskLine]> disk-rows;
    in-out property <int> selected-disk;
    in-out property <string> detail-interface: "—";
    in-out property <string> detail-sectors: "—";
    in-out property <string> detail-sector-size: "—";
    in-out property <string> detail-partitions: "—";
    in-out property <string> detail-type: "—";
    in-out property <string> detail-readonly: "—";
    in-out property <bool> detail-readonly-ok: false;
    in-out property <bool> blockish-source;
    in-out property <bool> wb-confirmed;
    in-out property <int> wizard-focus;
    callback refresh-clicked;
    callback browse-source-clicked;
    callback fill-synthetic-clicked;
    callback use-first-disk-clicked;
    callback disk-selected(int);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: Strings.zone-source;
                color: Theme.copper;
                font-size: 11px;
                font-weight: 800;
                font-family: "Avenir Next";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button { text: Strings.refresh-disks; enabled: !root.busy; clicked => { root.refresh-clicked(); } }
        }
        Rectangle { height: 1px; background: Theme.hairline; }

        if root.is-guided: Rectangle {
            background: Theme.unsigned-well;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.unsigned-border;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: Strings.prepare-guided-title;
                    color: Theme.unsigned-text;
                    font-size: 13px;
                    font-weight: 700;
                    font-family: "Avenir Next";
                }
                Text {
                    text: Strings.prepare-guided-body;
                    color: Theme.readout;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
        if root.is-guided: HorizontalLayout {
            spacing: 6px;
            Button { text: Strings.fill-demo; enabled: !root.busy; clicked => { root.fill-synthetic-clicked(); } }
            Button { text: Strings.use-selected-disk; enabled: !root.busy; clicked => { root.use-first-disk-clicked(); root.wizard-focus = 2; } }
        }

        if !root.is-guided: Text {
            text: Strings.disks-label;
            color: Theme.mute;
            font-size: 10px;
            font-weight: 700;
            font-family: "Avenir Next";
        }
        if !root.is-guided: Rectangle {
            height: 24px;
            background: Theme.table-head;
            HorizontalLayout {
                padding-left: 8px;
                spacing: 6px;
                Text { text: ""; width: 18px; }
                Text { text: "DEV"; width: 60px; color: Theme.faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                Text { text: "MODEL"; horizontal-stretch: 1; color: Theme.faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                Text { text: "SIZE"; width: 68px; color: Theme.faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                Text { text: "BUS"; width: 48px; color: Theme.faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
            }
        }
        if !root.is-guided && root.disk-rows.length == 0: VerticalLayout {
            spacing: 6px;
            padding-top: 6px;
            Text {
                text: "No host disks reported. Browse a file source, or use Guided → Fill demo.";
                color: Theme.mute;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Button { text: Strings.browse; enabled: !root.busy; clicked => { root.browse-source-clicked(); } }
                Button { text: Strings.fill-demo; enabled: !root.busy; clicked => { root.fill-synthetic-clicked(); } }
            }
        }
        if !root.is-guided: VerticalLayout {
            spacing: 0;
            for row[idx] in root.disk-rows: Rectangle {
                height: 30px;
                background: root.selected-disk == idx ? Theme.rail-active : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 6px;
                    Text {
                        text: root.selected-disk == idx ? "●" : "○";
                        width: 18px;
                        color: Theme.copper;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text { text: row.device; width: 60px; color: Theme.readout; font-size: 11px; font-family: "Menlo"; vertical-alignment: center; }
                    Text { text: row.model; horizontal-stretch: 1; color: Theme.readout; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    Text { text: row.size; width: 68px; color: Theme.mute; font-size: 11px; font-family: "Menlo"; vertical-alignment: center; }
                    Text { text: row.bus; width: 48px; color: Theme.mute; font-size: 11px; vertical-alignment: center; }
                }
                TouchArea {
                    enabled: !root.busy;
                    mouse-cursor: pointer;
                    clicked => { root.disk-selected(idx); root.wizard-focus = 2; }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.hairline; }
        Text { text: "DEVICE DETAILS"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 2px;
                Text { text: "INTERFACE: " + root.detail-interface; color: Theme.mute; font-size: 10px; font-family: "Menlo"; }
                Text { text: "SECTORS: " + root.detail-sectors; color: Theme.mute; font-size: 10px; font-family: "Menlo"; }
                Text { text: "SECTOR SIZE: " + root.detail-sector-size; color: Theme.mute; font-size: 10px; font-family: "Menlo"; }
            }
            VerticalLayout {
                spacing: 2px;
                Text { text: "PARTITIONS: " + root.detail-partitions; color: Theme.mute; font-size: 10px; font-family: "Menlo"; }
                Text { text: "TYPE: " + root.detail-type; color: Theme.mute; font-size: 10px; font-family: "Menlo"; }
                Text {
                    text: "READ-ONLY: " + root.detail-readonly;
                    color: root.detail-readonly-ok ? Theme.ok-glow : Theme.mute;
                    font-size: 10px;
                    font-family: "Menlo";
                    font-weight: 600;
                }
            }
        }
        if root.blockish-source || root.is-expert: CheckBox {
            text: Strings.confirm-wb;
            checked <=> root.wb-confirmed;
            enabled: !root.busy;
            toggled => { root.wizard-focus = 3; }
        }
    }
}

component PrepareZone inherits Rectangle {
    in-out property <bool> is-guided;
    in-out property <int> mode-index;
    in-out property <bool> busy;
    in-out property <bool> show-advanced;
    in-out property <int> format-index;
    in-out property <string> format-caption;
    in-out property <int> profile-index;
    in-out property <int> source-kind-index;
    in-out property <int> retry-index;
    in-out property <string> segment-mib;
    in-out property <string> multisource-b;
    in-out property <bool> write-sha512;
    in-out property <bool> show-path-editors;
    in-out property <string> source-path;
    in-out property <string> output-dir;
    in-out property <string> case-id;
    in-out property <string> case-verify;
    in-out property <bool> case-verify-ok;
    in-out property <bool> confirmed-synthetic;
    in-out property <int> wizard-focus;
    in-out property <bool> preflight-is-deny;
    in-out property <string> preflight-hint;
    callback mode-changed(int);
    callback format-changed(int);
    callback profile-changed(int);
    callback source-kind-changed(int);
    callback retry-changed(int);
    callback run-profile-clicked;
    callback multisource-clicked;
    callback browse-source-clicked;
    callback browse-output-clicked;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: Strings.zone-prepare;
            color: Theme.copper;
            font-size: 11px;
            font-weight: 800;
            font-family: "Avenir Next";
        }
        Rectangle { height: 1px; background: Theme.hairline; }

        Text { text: Strings.operator-mode; color: Theme.faint; font-size: 9px; font-weight: 700; }
        HorizontalLayout {
            spacing: 4px;
            ModeChip { label: Strings.mode-guided; active: root.mode-index == 0; locked: root.busy; clicked => { root.mode-index = 0; root.mode-changed(0); } }
            ModeChip { label: Strings.mode-standard; active: root.mode-index == 1; locked: root.busy; clicked => { root.mode-index = 1; root.mode-changed(1); } }
            ModeChip { label: Strings.mode-expert; active: root.mode-index == 2; locked: root.busy; clicked => { root.mode-index = 2; root.mode-changed(2); } }
        }

        Text { text: Strings.format-label; color: Theme.faint; font-size: 9px; font-weight: 700; }
        HorizontalLayout {
            spacing: 4px;
            FormatChip { label: "fsnap"; active: root.format-index == 0; locked: root.busy; clicked => { root.format-index = 0; root.format-changed(0); } }
            FormatChip { label: "E01-lite"; active: root.format-index == 1; locked: root.busy; clicked => { root.format-index = 1; root.format-changed(1); } }
            FormatChip { label: "AFF4"; active: root.format-index == 2; locked: root.busy; clicked => { root.format-index = 2; root.format-changed(2); } }
            FormatChip { label: "ZFF"; active: root.format-index == 8; locked: root.busy; clicked => { root.format-index = 8; root.format-changed(8); } }
            if !root.is-guided: FormatChip {
                label: root.show-advanced ? Strings.advanced-hide : Strings.advanced-toggle;
                active: root.show-advanced;
                locked: root.busy;
                clicked => { root.show-advanced = !root.show-advanced; }
            }
        }
        Text {
            text: root.format-index == 0
                ? (Strings.is-id ? "Path A pengadilan — RAW + .fsnap" : "Court path A — RAW + .fsnap")
                : "Compat subset · " + root.format-caption;
            color: Theme.faint;
            font-size: 10px;
        }

        if root.show-advanced && !root.is-guided: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: "VMDK"; active: root.format-index == 3; locked: root.busy; clicked => { root.format-index = 3; root.format-changed(3); } }
                FormatChip { label: "VHD"; active: root.format-index == 4; locked: root.busy; clicked => { root.format-index = 4; root.format-changed(4); } }
                FormatChip { label: "QCOW2"; active: root.format-index == 5; locked: root.busy; clicked => { root.format-index = 5; root.format-changed(5); } }
                FormatChip { label: "DMG"; active: root.format-index == 6; locked: root.busy; clicked => { root.format-index = 6; root.format-changed(6); } }
                FormatChip { label: "Split-RAW"; active: root.format-index == 7; locked: root.busy; clicked => { root.format-index = 7; root.format-changed(7); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: Strings.segment-mib; color: Theme.mute; font-size: 10px; vertical-alignment: center; }
                LineEdit { text <=> root.segment-mib; enabled: !root.busy; horizontal-stretch: 1; }
            }
            Text { text: Strings.profile-label; color: Theme.faint; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.profile-quick; active: root.profile-index == 0; locked: root.busy; clicked => { root.profile-index = 0; root.profile-changed(0); } }
                FormatChip { label: Strings.profile-standard; active: root.profile-index == 1; locked: root.busy; clicked => { root.profile-index = 1; root.profile-changed(1); } }
                FormatChip { label: Strings.profile-deep; active: root.profile-index == 2; locked: root.busy; clicked => { root.profile-index = 2; root.profile-changed(2); } }
                FormatChip { label: Strings.profile-custom; active: root.profile-index == 3; locked: root.busy; clicked => { root.profile-index = 3; root.profile-changed(3); } }
                Button { text: Strings.run-quick-profile; enabled: !root.busy; clicked => { root.run-profile-clicked(); } }
            }
            Text { text: Strings.source-kind-label; color: Theme.faint; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.kind-disk; active: root.source-kind-index == 0; locked: root.busy; clicked => { root.source-kind-index = 0; root.source-kind-changed(0); } }
                FormatChip { label: Strings.kind-file; active: root.source-kind-index == 1; locked: root.busy; clicked => { root.source-kind-index = 1; root.source-kind-changed(1); } }
                FormatChip { label: Strings.kind-ram; active: root.source-kind-index == 2; locked: root.busy; clicked => { root.source-kind-index = 2; root.source-kind-changed(2); } }
                FormatChip { label: Strings.kind-snap; active: root.source-kind-index == 3; locked: root.busy; clicked => { root.source-kind-index = 3; root.source-kind-changed(3); } }
            }
            Text { text: Strings.retry-label; color: Theme.faint; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                spacing: 4px;
                FormatChip { label: Strings.retry-skip; active: root.retry-index == 0; locked: root.busy; clicked => { root.retry-index = 0; root.retry-changed(0); } }
                FormatChip { label: Strings.retry-n; active: root.retry-index == 1; locked: root.busy; clicked => { root.retry-index = 1; root.retry-changed(1); } }
                FormatChip { label: Strings.retry-fail; active: root.retry-index == 2; locked: root.busy; clicked => { root.retry-index = 2; root.retry-changed(2); } }
            }
            Text { text: Strings.multisource-label; color: Theme.faint; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                spacing: 6px;
                LineEdit { placeholder-text: Strings.multisource-b; text <=> root.multisource-b; enabled: !root.busy; horizontal-stretch: 1; }
                Button { text: Strings.run-multisource; enabled: !root.busy; clicked => { root.multisource-clicked(); } }
            }
        }

        CheckBox {
            text: Strings.write-sha512;
            checked <=> root.write-sha512;
            enabled: !root.busy;
        }

        Rectangle { height: 1px; background: Theme.hairline; }

        if root.show-path-editors: Text { text: "SOURCE PATH"; color: Theme.faint; font-size: 9px; font-weight: 700; }
        if root.show-path-editors: HorizontalLayout {
            spacing: 4px;
            LineEdit { text <=> root.source-path; placeholder-text: Strings.source-placeholder; enabled: !root.busy; horizontal-stretch: 1; font-family: "Menlo"; }
            Button { text: "…"; enabled: !root.busy; clicked => { root.browse-source-clicked(); } }
        }
        if root.show-path-editors: Text { text: "OUTPUT PATH"; color: Theme.faint; font-size: 9px; font-weight: 700; }
        if root.show-path-editors: HorizontalLayout {
            spacing: 4px;
            LineEdit { text <=> root.output-dir; placeholder-text: Strings.output-placeholder; enabled: !root.busy; horizontal-stretch: 1; font-family: "Menlo"; }
            Button { text: "…"; enabled: !root.busy; clicked => { root.browse-output-clicked(); } }
        }

        Text { text: Strings.case-id-label + " (VERIFY)"; color: Theme.faint; font-size: 9px; font-weight: 700; }
        LineEdit {
            text <=> root.case-verify;
            enabled: !root.busy && !root.is-guided;
            placeholder-text: root.case-id == "" ? "Matches case ID" : root.case-id;
        }
        if !root.case-verify-ok: Text {
            text: "Case verify does not match case ID.";
            color: Theme.copper;
            font-size: 10px;
            font-weight: 600;
        }
        CheckBox {
            text: Strings.confirm-synthetic;
            checked <=> root.confirmed-synthetic;
            enabled: !root.busy;
            toggled => { root.wizard-focus = 4; }
        }

        if root.preflight-is-deny: Rectangle {
            background: Theme.deny-mist;
            border-radius: Theme.radius-sm;
            HorizontalLayout {
                padding: 8px;
                Text { text: root.preflight-hint; color: Theme.deny; font-size: 11px; font-weight: 700; wrap: word-wrap; }
            }
        }
    }
}

component RunZone inherits Rectangle {
    in-out property <bool> busy;
    in-out property <bool> can-run;
    in-out property <bool> show-post-run;
    in-out property <bool> has-package;
    in-out property <bool> is-guided;
    in-out property <string> start-reason;
    in-out property <string> last-package;
    in-out property <string> evidence-sha256;
    in-out property <string> evidence-sha512;
    in-out property <string> evidence-size;
    in-out property <float> progress-fraction;
    in-out property <string> progress-label;
    in-out property <string> progress-phase;
    in-out property <string> throughput-label;
    in-out property <string> eta-label;
    in-out property <int> wizard-focus;
    in-out property <int> nav-index;
    callback run-clicked;
    callback cancel-clicked;
    callback fill-synthetic-clicked;
    callback verify-package-clicked;
    callback export-coc-clicked;
    callback clear-clicked;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.hairline;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: Strings.zone-run;
            color: Theme.copper;
            font-size: 11px;
            font-weight: 800;
            font-family: "Avenir Next";
        }
        Rectangle { height: 1px; background: Theme.hairline; }

        if !root.busy && !root.show-post-run: Rectangle {
            height: 44px;
            border-radius: Theme.radius-sm;
            background: root.can-run ? Theme.copper : Theme.primary-disabled;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: Strings.start-acquire;
                    color: root.can-run ? Theme.on-copper : Theme.mute;
                    font-size: 13px;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    vertical-alignment: center;
                }
            }
            TouchArea {
                enabled: root.can-run;
                mouse-cursor: pointer;
                clicked => { root.wizard-focus = 5; root.run-clicked(); }
            }
        }
        if !root.busy && !root.show-post-run && root.start-reason != "": Text {
            text: root.start-reason;
            color: Theme.copper;
            font-size: 10px;
            font-weight: 600;
            wrap: word-wrap;
        }
        if !root.busy && !root.show-post-run && root.is-guided: Button {
            text: Strings.fill-demo;
            enabled: !root.busy;
            clicked => { root.fill-synthetic-clicked(); }
        }

        if root.busy: Text {
            text: root.progress-phase + " · " + root.progress-label;
            color: Theme.readout;
            font-size: 11px;
            font-weight: 600;
        }
        if root.busy: Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.raised;
            Rectangle {
                x: 0;
                y: 0;
                height: 100%;
                width: parent.width * root.progress-fraction;
                background: Theme.copper;
                border-radius: 4px;
            }
        }
        if root.busy: HorizontalLayout {
            Text { text: root.throughput-label; color: Theme.mute; font-size: 10px; horizontal-stretch: 1; }
            Text { text: root.eta-label; color: Theme.mute; font-size: 10px; }
        }
        if root.busy: Button { text: Strings.cancel; clicked => { root.cancel-clicked(); } }

        Rectangle { height: 1px; background: Theme.hairline; }
        Text { text: Strings.evidence-seal; color: Theme.faint; font-size: 9px; font-weight: 700; }

        if root.show-post-run: Text { text: Strings.verified; color: Theme.ok-glow; font-size: 12px; font-weight: 800; }
        if root.show-post-run: Text { text: Strings.package + ": " + root.last-package; color: Theme.mute; font-size: 10px; font-family: "Menlo"; wrap: word-wrap; }
        if root.show-post-run: Text { text: Strings.sha-label + ": " + root.evidence-sha256; color: Theme.mute; font-size: 10px; font-family: "Menlo"; wrap: word-wrap; }
        if root.show-post-run && root.evidence-sha512 != "(none)" && root.evidence-sha512 != "": Text {
            text: Strings.sha512-label + ": " + root.evidence-sha512;
            color: Theme.mute; font-size: 10px; font-family: "Menlo"; wrap: word-wrap;
        }
        if root.show-post-run: Text { text: Strings.size + ": " + root.evidence-size; color: Theme.mute; font-size: 10px; }
        if root.show-post-run: HorizontalLayout {
            spacing: 4px;
            Button { text: Strings.run-verify; clicked => { root.nav-index = 4; root.verify-package-clicked(); } }
            Button { text: Strings.export-coc; clicked => { root.export-coc-clicked(); } }
        }
        if root.show-post-run: HorizontalLayout {
            spacing: 4px;
            Button { text: Strings.nav-triage; clicked => { root.nav-index = 3; } }
            Button { text: Strings.clear; clicked => { root.clear-clicked(); } }
        }

        if !root.show-post-run && !root.busy: Text { text: Strings.no-package-yet; color: Theme.mute; font-size: 11px; }
        if !root.show-post-run && !root.busy: Text { text: Strings.seal-empty-body; color: Theme.faint; font-size: 10px; wrap: word-wrap; }
    }
}

// -------------------------------------------------------------------- window

export component AppWindow inherits Window {
    title: "Trareon Acquire";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: Theme.window-min-w;
    min-height: Theme.window-min-h;
    background: Theme.void;

    // ============ Rust wiring surface (do not rename — main.rs depends on these) ============
    in-out property <int> mode-index: 1;
    in-out property <string> mode-guidance: "";
    in-out property <bool> show-path-editors: true;
    in-out property <string> case-identity: "";
    in-out property <string> case-id: "";
    in-out property <string> case-verify: "";
    in-out property <string> source-path: "";
    in-out property <string> output-dir: "";
    in-out property <bool> confirmed-synthetic: false;
    in-out property <string> status-line: "";
    in-out property <string> last-package: "(none)";
    in-out property <string> evidence-sha256: "(none)";
    in-out property <string> evidence-size: "(none)";
    in-out property <string> preflight-hint: "";
    in-out property <bool> preflight-is-deny: false;
    in-out property <bool> busy: false;
    in-out property <bool> dark-mode: false;
    in-out property <string> locale: "en";
    in-out property <int> nav-index: 0;
    in-out property <string> about-text: "";
    in-out property <float> progress-fraction: 0.0;
    in-out property <string> progress-label: "";
    in-out property <string> progress-phase: "";
    in-out property <string> write-blocker-line: "Write-blocker: —";
    in-out property <string> write-blocker-secondary: "";
    in-out property <bool> write-blocker-ready: true;
    in-out property <bool> wb-confirmed: false;
    in-out property <bool> blockish-source: false;
    in-out property <string> panel-detail: "";
    in-out property <string> disk-list: "";
    in-out property <[DiskLine]> disk-rows: [];
    in-out property <int> selected-disk: -1;
    in-out property <string> custody-timeline-text: "";
    in-out property <string> throughput-label: "— MiB/s";
    in-out property <string> eta-label: "ETA —";
    in-out property <float> coverage-ok: 0.0;
    in-out property <float> coverage-err: 0.0;
    in-out property <int> format-index: 0;
    in-out property <string> format-caption: "RAW + .fsnap (court path A)";
    in-out property <bool> write-sha512: true;
    in-out property <string> segment-mib: "4096";
    in-out property <string> evidence-sha512: "(none)";
    in-out property <bool> id-power: false;
    in-out property <bool> id-network: false;
    in-out property <bool> id-encryption: false;
    in-out property <bool> id-anti: false;
    in-out property <bool> id-oov: false;
    in-out property <string> emergency-override: "";
    in-out property <string> case-title: "";
    in-out property <string> boot-image-path: "";
    in-out property <int> profile-index: 1;
    in-out property <string> profile-caption: "";
    in-out property <int> source-kind-index: 0;
    in-out property <string> source-kind-caption: "";
    in-out property <int> retry-index: 0;
    in-out property <string> retry-caption: "";
    in-out property <string> coc-device: "";
    in-out property <string> coc-media: "1";
    in-out property <string> coc-seq: "1";
    in-out property <string> coc-description: "";
    in-out property <string> compare-package-b: "";
    in-out property <string> multisource-b: "";
    in-out property <float> phase-opacity: 1.0;
    in-out property <string> footer-time: "";
    in-out property <string> footer-user: "";
    in-out property <string> footer-host: "";
    in-out property <string> detail-interface: "—";
    in-out property <string> detail-sectors: "—";
    in-out property <string> detail-sector-size: "—";
    in-out property <string> detail-partitions: "—";
    in-out property <string> detail-type: "—";
    in-out property <string> detail-readonly: "—";
    in-out property <bool> detail-readonly-ok: false;
    in-out property <string> case-subtitle: "";
    in-out property <string> app-version: "Version 0.1.0";
    in-out property <string> app-build: "";
    in-out property <bool> show-advanced: false;
    in-out property <int> wizard-focus: 1;

    // ============ New properties for the remounted shell ============
    in-out property <string> search-query: "";
    in-out property <string> status-evidence-text: "0";
    in-out property <string> status-coverage-text: "—";
    in-out property <string> status-mode-text: "Standard";

    // ============ Derived UX ============
    // is-compact is set imperatively from init/changed-width to avoid a reactive
    // binding loop between root.width and child min-widths.
    property <bool> is-compact: false;
    property <bool> is-guided: root.mode-index == 0;
    property <bool> is-expert: root.mode-index == 2;
    property <bool> has-package: root.last-package != "(none)" && root.last-package != "";
    property <bool> case-verify-ok: root.is-guided || root.case-id == "" || root.case-verify == root.case-id;
    property <bool> identify-complete: root.id-power && root.id-network && root.id-encryption && root.id-anti && root.id-oov;
    property <bool> identify-gate: (root.is-expert || root.blockish-source) && !root.identify-complete && root.emergency-override == "";
    property <bool> step-case-done: root.is-guided || root.case-id != "";
    property <bool> step-source-done: root.source-path != "";
    property <bool> step-wb-done: !root.blockish-source || root.wb-confirmed || root.write-blocker-ready;
    property <bool> step-confirm-done: root.confirmed-synthetic && root.case-verify-ok;
    property <bool> paths-ok: root.source-path != "" && root.output-dir != "";
    property <bool> can-start-guided: root.confirmed-synthetic && root.paths-ok && !root.busy;
    property <bool> can-start-std: root.can-start-guided && root.case-id != "" && root.case-verify-ok && root.step-wb-done && !root.preflight-is-deny && !root.identify-gate;
    property <bool> can-run: root.is-guided ? root.can-start-guided : root.can-start-std;
    property <bool> show-post-run: root.has-package && !root.busy;
    property <string> start-reason:
        root.busy ? "Acquisition running…"
        : root.preflight-is-deny ? root.preflight-hint
        : (!root.is-guided && root.case-id == "") ? "Set a case ID (Cases) before start"
        : !root.case-verify-ok ? "Case verify must match case ID"
        : root.source-path == "" ? "Select a source disk or path"
        : root.output-dir == "" ? "Set an output directory"
        : !root.confirmed-synthetic ? "Confirm source and destination"
        : (root.blockish-source && !root.step-wb-done) ? "Confirm write-blocker (step WB)"
        : root.identify-gate ? "Complete Identify checklist (or emergency override)"
        : "";
    property <string> integrity-status:
        root.busy ? Strings.integrity-running
        : (root.evidence-sha256 != "(none)" ? Strings.integrity-sealed : Strings.integrity-ready);
    property <int> stage-current:
        (root.has-package && !root.busy) ? 3
        : (root.busy || root.step-confirm-done) ? 2
        : 1;

    // ============ Callbacks (do not rename) ============
    callback browse-source-clicked();
    callback browse-output-clicked();
    callback run-clicked();
    callback cancel-clicked();
    callback clear-clicked();
    callback fill-synthetic-clicked();
    callback export-coc-clicked();
    callback mode-changed(int);
    callback theme-toggled(bool);
    callback locale-toggled(string);
    callback instrument-refresh();
    callback refresh-disks-clicked();
    callback use-first-disk-clicked();
    callback disk-selected(int);
    callback refresh-cases-clicked();
    callback create-case-clicked();
    callback save-identify-clicked();
    callback probe-encryption-clicked();
    callback verify-package-clicked();
    callback hash-only-clicked();
    callback run-qms-clicked();
    callback run-triage-clicked();
    callback boot-plan-clicked();
    callback analysis-lite-clicked();
    callback format-changed(int);
    callback browse-package-clicked();
    callback profile-changed(int);
    callback source-kind-changed(int);
    callback retry-changed(int);
    callback export-full-coc-clicked();
    callback compare-packages-clicked();
    callback export-report-clicked();
    callback run-profile-clicked();
    callback multisource-clicked();
    callback browse-compare-clicked();
    callback search-submitted();

    init => {
        Theme.apply(root.dark-mode);
        Strings.locale = root.locale;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.is-compact = root.width < 1100px;
    }
    changed dark-mode => {
        Theme.apply(root.dark-mode);
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed locale => { Strings.locale = root.locale; }
    changed width => { root.is-compact = root.width < 1100px; }

    VerticalLayout {
        // ============ Banner 26px ============
        Rectangle {
            height: Theme.banner-h;
            background: Theme.unsigned-well;
            border-color: Theme.unsigned-border;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: start;
                Text {
                    text: Strings.disclosure-banner;
                    color: Theme.unsigned-text;
                    font-size: 11px;
                    font-weight: 700;
                    font-family: "Avenir Next";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // ============ Header 48px ============
        Rectangle {
            height: Theme.header-h;
            background: Theme.ink;
            border-color: Theme.hairline;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;
                // Brand
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 6px;
                    background: Theme.copper;
                    Text { text: "T"; color: white; font-size: 15px; font-weight: 800; font-family: "Avenir Next"; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text {
                    text: "TRAREON";
                    color: Theme.readout;
                    font-size: 12px;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    vertical-alignment: center;
                }
                Text { text: "|"; color: Theme.hairline; font-size: 14px; vertical-alignment: center; }
                Text {
                    text: "ACQUIRE";
                    color: Theme.copper;
                    font-size: 12px;
                    font-weight: 800;
                    font-family: "Avenir Next";
                    vertical-alignment: center;
                }
                Text { text: "|"; color: Theme.hairline; font-size: 14px; vertical-alignment: center; }
                // Case chip
                Rectangle {
                    height: 28px;
                    min-width: 100px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;
                        Text {
                            text: Strings.chip-case + ":";
                            color: Theme.faint;
                            font-size: 10px;
                            font-weight: 700;
                            font-family: "Avenir Next";
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.case-id == "" ? "—" : root.case-id;
                            color: Theme.readout;
                            font-size: 11px;
                            font-weight: 700;
                            font-family: "Menlo";
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { if !root.busy { root.nav-index = 1; } }
                    }
                }
                // Search
                LineEdit {
                    placeholder-text: Strings.search-placeholder;
                    text <=> root.search-query;
                    min-width: root.is-compact ? 120px : 220px;
                    horizontal-stretch: 1;
                    accepted => { root.search-submitted(); }
                }
                // EN | ID
                LocaleChip { label: Strings.lang-en; active: root.locale == "en"; clicked => { root.locale = "en"; root.locale-toggled("en"); } }
                LocaleChip { label: Strings.lang-id; active: root.locale == "id"; clicked => { root.locale = "id"; root.locale-toggled("id"); } }
                // Theme toggle
                Rectangle {
                    width: 34px;
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    Text {
                        text: root.dark-mode ? "☾" : "☀";
                        color: Theme.readout;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dark-mode = !root.dark-mode; root.theme-toggled(root.dark-mode); }
                    }
                }
            }
        }

        // ============ Rail + Main column ============
        HorizontalLayout {
            spacing: 0;

            // ---------- Rail ----------
            Rectangle {
                width: root.is-compact ? Theme.rail-w-compact : Theme.rail-w;
                background: Theme.ink;
                border-color: Theme.hairline;
                border-width: 1px;
                VerticalLayout {
                    padding-left: root.is-compact ? 4px : 10px;
                    padding-right: root.is-compact ? 4px : 10px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 3px;
                    if !root.is-compact: Text { text: Strings.rail-workflow; color: Theme.faint; font-size: 9px; font-weight: 700; font-family: "Avenir Next"; }
                    NavItem { glyph: "▣"; label: Strings.nav-cases; compact: root.is-compact; active: root.nav-index == 1; enabled: !root.busy; clicked => { root.nav-index = 1; } }
                    NavItem { glyph: "◉"; label: Strings.nav-identify; compact: root.is-compact; active: root.nav-index == 2; enabled: !root.busy; clicked => { root.nav-index = 2; } }
                    NavItem { glyph: "↓"; label: Strings.nav-acquire; compact: root.is-compact; active: root.nav-index == 0; enabled: !root.busy; clicked => { root.nav-index = 0; } }
                    NavItem { glyph: "☰"; label: Strings.nav-triage; compact: root.is-compact; active: root.nav-index == 3; enabled: !root.busy; clicked => { root.nav-index = 3; } }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    if !root.is-compact: Text { text: Strings.rail-lab; color: Theme.faint; font-size: 9px; font-weight: 700; font-family: "Avenir Next"; }
                    NavItem { glyph: "⚒"; label: Strings.nav-tools; compact: root.is-compact; active: root.nav-index == 4; enabled: !root.busy; clicked => { root.nav-index = 4; } }
                    NavItem { glyph: "◆"; label: Strings.nav-qms; compact: root.is-compact; active: root.nav-index == 5; enabled: !root.busy; clicked => { root.nav-index = 5; } }
                    NavItem { glyph: "▭"; label: Strings.nav-boot; compact: root.is-compact; active: root.nav-index == 6; enabled: !root.busy; clicked => { root.nav-index = 6; } }
                    Rectangle { height: 1px; background: Theme.hairline; }
                    if !root.is-compact: Text { text: Strings.rail-support; color: Theme.faint; font-size: 9px; font-weight: 700; font-family: "Avenir Next"; }
                    NavItem { glyph: "?"; label: Strings.nav-help; compact: root.is-compact; active: root.nav-index == 7; clicked => { root.nav-index = 7; } }
                    NavItem { glyph: "ⓘ"; label: Strings.nav-about; compact: root.is-compact; active: root.nav-index == 8; clicked => { root.nav-index = 8; } }
                    Rectangle { vertical-stretch: 1; }
                    if !root.is-compact: Text { text: root.app-version; color: Theme.faint; font-size: 10px; font-family: "Avenir Next"; }
                    if !root.is-compact: Text { text: root.app-build; color: Theme.faint; font-size: 9px; font-family: "Avenir Next"; }
                }
            }

            // ---------- Main column ----------
            VerticalLayout {
                // Safety strip 36px
                Rectangle {
                    height: Theme.safety-h;
                    background: Theme.panel;
                    border-color: Theme.hairline;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        SafetyChip {
                            caption: Strings.chip-case;
                            value: root.case-id == "" ? "—" : root.case-id;
                            clickable: !root.busy;
                            clicked => { if !root.busy { root.nav-index = 1; } }
                        }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        SafetyChip {
                            caption: Strings.chip-wb;
                            value: root.write-blocker-ready ? "OK" : (root.wb-confirmed ? "confirmed" : "confirm");
                            ok: root.write-blocker-ready;
                            warn: !root.write-blocker-ready && !root.wb-confirmed;
                            clickable: !root.busy;
                            clicked => { root.instrument-refresh(); root.wizard-focus = 3; if !root.busy { root.nav-index = 0; } }
                        }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        SafetyChip {
                            caption: Strings.chip-integrity;
                            value: root.integrity-status;
                            ok: root.integrity-status == Strings.integrity-sealed || root.integrity-status == Strings.integrity-ready;
                            clickable: root.has-package && !root.busy;
                            clicked => { if root.has-package && !root.busy { root.nav-index = 4; } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Stage machine
                        StageDot { label: Strings.stage-prepare; done: root.stage-current >= 1; current: root.stage-current == 1; }
                        Text { text: "—"; color: Theme.hairline; font-size: 10px; vertical-alignment: center; }
                        StageDot { label: Strings.stage-acquire; done: root.stage-current >= 2; current: root.stage-current == 2; }
                        Text { text: "—"; color: Theme.hairline; font-size: 10px; vertical-alignment: center; }
                        StageDot { label: Strings.stage-seal; done: root.stage-current >= 3; current: root.stage-current == 3; }
                    }
                }

                // Identify-gate banner
                if root.identify-gate: Rectangle {
                    height: 34px;
                    background: Theme.unsigned-well;
                    border-color: Theme.unsigned-border;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: "Identify gate incomplete — checklist required before Expert/blockish acquire.";
                            color: Theme.unsigned-text;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button { text: "Open Identify"; clicked => { root.nav-index = 2; } }
                    }
                }

                // Body
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.void;

                    // ===== ACQUIRE — wide (3 zones) =====
                    if root.nav-index == 0 && !root.is-compact: HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        SourceZone {
                            horizontal-stretch: 42;
                            min-width: Theme.zone-source-min;
                            is-guided: root.is-guided;
                            is-expert: root.is-expert;
                            busy: root.busy;
                            disk-rows: root.disk-rows;
                            selected-disk: root.selected-disk;
                            detail-interface: root.detail-interface;
                            detail-sectors: root.detail-sectors;
                            detail-sector-size: root.detail-sector-size;
                            detail-partitions: root.detail-partitions;
                            detail-type: root.detail-type;
                            detail-readonly: root.detail-readonly;
                            detail-readonly-ok: root.detail-readonly-ok;
                            blockish-source: root.blockish-source;
                            wb-confirmed <=> root.wb-confirmed;
                            wizard-focus <=> root.wizard-focus;
                            refresh-clicked => { root.refresh-disks-clicked(); }
                            browse-source-clicked => { root.browse-source-clicked(); }
                            fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                            use-first-disk-clicked => { root.use-first-disk-clicked(); }
                            disk-selected(i) => { root.disk-selected(i); }
                        }
                        PrepareZone {
                            horizontal-stretch: 33;
                            min-width: Theme.zone-prepare-min;
                            is-guided: root.is-guided;
                            mode-index <=> root.mode-index;
                            busy: root.busy;
                            show-advanced <=> root.show-advanced;
                            format-index <=> root.format-index;
                            format-caption: root.format-caption;
                            profile-index <=> root.profile-index;
                            source-kind-index <=> root.source-kind-index;
                            retry-index <=> root.retry-index;
                            segment-mib <=> root.segment-mib;
                            multisource-b <=> root.multisource-b;
                            write-sha512 <=> root.write-sha512;
                            show-path-editors: root.show-path-editors;
                            source-path <=> root.source-path;
                            output-dir <=> root.output-dir;
                            case-id: root.case-id;
                            case-verify <=> root.case-verify;
                            case-verify-ok: root.case-verify-ok;
                            confirmed-synthetic <=> root.confirmed-synthetic;
                            wizard-focus <=> root.wizard-focus;
                            preflight-is-deny: root.preflight-is-deny;
                            preflight-hint: root.preflight-hint;
                            mode-changed(i) => { root.mode-changed(i); }
                            format-changed(i) => { root.format-changed(i); }
                            profile-changed(i) => { root.profile-changed(i); }
                            source-kind-changed(i) => { root.source-kind-changed(i); }
                            retry-changed(i) => { root.retry-changed(i); }
                            run-profile-clicked => { root.run-profile-clicked(); }
                            multisource-clicked => { root.multisource-clicked(); }
                            browse-source-clicked => { root.browse-source-clicked(); }
                            browse-output-clicked => { root.browse-output-clicked(); }
                        }
                        RunZone {
                            horizontal-stretch: 25;
                            min-width: Theme.zone-run-min;
                            busy: root.busy;
                            can-run: root.can-run;
                            show-post-run: root.show-post-run;
                            has-package: root.has-package;
                            is-guided: root.is-guided;
                            start-reason: root.start-reason;
                            last-package: root.last-package;
                            evidence-sha256: root.evidence-sha256;
                            evidence-sha512: root.evidence-sha512;
                            evidence-size: root.evidence-size;
                            progress-fraction: root.progress-fraction;
                            progress-label: root.progress-label;
                            progress-phase: root.progress-phase;
                            throughput-label: root.throughput-label;
                            eta-label: root.eta-label;
                            wizard-focus <=> root.wizard-focus;
                            nav-index <=> root.nav-index;
                            run-clicked => { root.run-clicked(); }
                            cancel-clicked => { root.cancel-clicked(); }
                            fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                            verify-package-clicked => { root.verify-package-clicked(); }
                            export-coc-clicked => { root.export-coc-clicked(); }
                            clear-clicked => { root.clear-clicked(); }
                        }
                    }

                    // ===== ACQUIRE — compact (stacked) =====
                    if root.nav-index == 0 && root.is-compact: ScrollView {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;
                            SourceZone {
                                is-guided: root.is-guided;
                                is-expert: root.is-expert;
                                busy: root.busy;
                                disk-rows: root.disk-rows;
                                selected-disk: root.selected-disk;
                                detail-interface: root.detail-interface;
                                detail-sectors: root.detail-sectors;
                                detail-sector-size: root.detail-sector-size;
                                detail-partitions: root.detail-partitions;
                                detail-type: root.detail-type;
                                detail-readonly: root.detail-readonly;
                                detail-readonly-ok: root.detail-readonly-ok;
                                blockish-source: root.blockish-source;
                                wb-confirmed <=> root.wb-confirmed;
                                wizard-focus <=> root.wizard-focus;
                                refresh-clicked => { root.refresh-disks-clicked(); }
                                browse-source-clicked => { root.browse-source-clicked(); }
                                fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                                use-first-disk-clicked => { root.use-first-disk-clicked(); }
                                disk-selected(i) => { root.disk-selected(i); }
                            }
                            PrepareZone {
                                is-guided: root.is-guided;
                                mode-index <=> root.mode-index;
                                busy: root.busy;
                                show-advanced <=> root.show-advanced;
                                format-index <=> root.format-index;
                                format-caption: root.format-caption;
                                profile-index <=> root.profile-index;
                                source-kind-index <=> root.source-kind-index;
                                retry-index <=> root.retry-index;
                                segment-mib <=> root.segment-mib;
                                multisource-b <=> root.multisource-b;
                                write-sha512 <=> root.write-sha512;
                                show-path-editors: root.show-path-editors;
                                source-path <=> root.source-path;
                                output-dir <=> root.output-dir;
                                case-id: root.case-id;
                                case-verify <=> root.case-verify;
                                case-verify-ok: root.case-verify-ok;
                                confirmed-synthetic <=> root.confirmed-synthetic;
                                wizard-focus <=> root.wizard-focus;
                                preflight-is-deny: root.preflight-is-deny;
                                preflight-hint: root.preflight-hint;
                                mode-changed(i) => { root.mode-changed(i); }
                                format-changed(i) => { root.format-changed(i); }
                                profile-changed(i) => { root.profile-changed(i); }
                                source-kind-changed(i) => { root.source-kind-changed(i); }
                                retry-changed(i) => { root.retry-changed(i); }
                                run-profile-clicked => { root.run-profile-clicked(); }
                                multisource-clicked => { root.multisource-clicked(); }
                                browse-source-clicked => { root.browse-source-clicked(); }
                                browse-output-clicked => { root.browse-output-clicked(); }
                            }
                            RunZone {
                                busy: root.busy;
                                can-run: root.can-run;
                                show-post-run: root.show-post-run;
                                has-package: root.has-package;
                                is-guided: root.is-guided;
                                start-reason: root.start-reason;
                                last-package: root.last-package;
                                evidence-sha256: root.evidence-sha256;
                                evidence-sha512: root.evidence-sha512;
                                evidence-size: root.evidence-size;
                                progress-fraction: root.progress-fraction;
                                progress-label: root.progress-label;
                                progress-phase: root.progress-phase;
                                throughput-label: root.throughput-label;
                                eta-label: root.eta-label;
                                wizard-focus <=> root.wizard-focus;
                                nav-index <=> root.nav-index;
                                run-clicked => { root.run-clicked(); }
                                cancel-clicked => { root.cancel-clicked(); }
                                fill-synthetic-clicked => { root.fill-synthetic-clicked(); }
                                verify-package-clicked => { root.verify-package-clicked(); }
                                export-coc-clicked => { root.export-coc-clicked(); }
                                clear-clicked => { root.clear-clicked(); }
                            }
                        }
                    }

                    // ===== CASES =====
                    if root.nav-index == 1: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-cases-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Text { text: Strings.shell-cases-body; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "CREATE CASE"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    LineEdit { placeholder-text: "Case title"; text <=> root.case-title; }
                                    LineEdit { placeholder-text: "Examiner"; text <=> root.case-identity; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button { text: Strings.create-case; clicked => { root.create-case-clicked(); } }
                                        Button { text: Strings.refresh-cases; clicked => { root.refresh-cases-clicked(); } }
                                        Button { text: "Continue to Identify"; clicked => { root.nav-index = 2; } }
                                        Button { text: "Open Acquire"; clicked => { root.nav-index = 0; } }
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 6px;
                                    Text { text: "CASE LIST"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    Text { text: root.panel-detail; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== IDENTIFY =====
                    if root.nav-index == 2: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-identify-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Text { text: Strings.shell-identify-body; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 10px;
                                    Text { text: "Case: " + (root.case-id == "" ? "—" : root.case-id); color: Theme.readout; font-size: 13px; font-weight: 700; font-family: "Avenir Next"; }
                                    CheckBox { text: "Power isolated / stable"; checked <=> root.id-power; }
                                    CheckBox { text: "Network isolated"; checked <=> root.id-network; }
                                    CheckBox { text: "Encryption noted"; checked <=> root.id-encryption; }
                                    CheckBox { text: "Anti-forensics considered"; checked <=> root.id-anti; }
                                    CheckBox { text: "Out-of-scope acknowledged (OoV)"; checked <=> root.id-oov; }
                                    Text { text: "Emergency override (optional)"; color: Theme.faint; font-size: 10px; font-weight: 700; }
                                    LineEdit { placeholder-text: "Supervisor reason — audited"; text <=> root.emergency-override; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button { text: Strings.save-identify; clicked => { root.save-identify-clicked(); } }
                                        Button { text: Strings.probe-encryption; clicked => { root.probe-encryption-clicked(); } }
                                        Button { text: "Continue to Acquire"; clicked => { root.nav-index = 0; } }
                                    }
                                    Text { text: root.panel-detail; color: Theme.mute; font-size: 11px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== TRIAGE =====
                    if root.nav-index == 3: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-triage-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Text { text: Strings.shell-triage-body; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
                            Button { text: Strings.run-triage; clicked => { root.run-triage-clicked(); } }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px;
                                    Text { text: root.panel-detail; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== TOOLS =====
                    if root.nav-index == 4: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-tools-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    VerticalLayout {
                                        padding: 14px; spacing: 6px;
                                        Text { text: "LAST PACKAGE"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                        Text { text: root.last-package; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                        Text { text: "SHA-256: " + root.evidence-sha256; color: Theme.mute; font-size: 11px; font-family: "Menlo"; wrap: word-wrap; }
                                        Text { text: "SHA-512: " + root.evidence-sha512; color: Theme.mute; font-size: 11px; font-family: "Menlo"; wrap: word-wrap; }
                                        Text { text: "Size: " + root.evidence-size; color: Theme.mute; font-size: 11px; }
                                        Text { text: root.custody-timeline-text; color: Theme.mute; font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                    VerticalLayout {
                                        padding: 14px; spacing: 8px;
                                        Text { text: "ACTIONS"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                        Button { text: "Browse package"; clicked => { root.browse-package-clicked(); } }
                                        Button { text: Strings.run-verify; clicked => { root.verify-package-clicked(); } }
                                        Button { text: Strings.run-hash; clicked => { root.hash-only-clicked(); } }
                                        LineEdit { placeholder-text: "Compare package B"; text <=> root.compare-package-b; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Button { text: Strings.browse-compare; clicked => { root.browse-compare-clicked(); } }
                                            Button { text: Strings.compare-packages; clicked => { root.compare-packages-clicked(); } }
                                        }
                                        Button { text: Strings.export-coc; clicked => { root.export-coc-clicked(); } }
                                        Button { text: Strings.export-full-coc; clicked => { root.export-full-coc-clicked(); } }
                                        Button { text: Strings.export-report; clicked => { root.export-report-clicked(); } }
                                        Button { text: Strings.analysis-lite; clicked => { root.analysis-lite-clicked(); } }
                                        Text { text: Strings.coc-form-label; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                        LineEdit { placeholder-text: Strings.coc-device; text <=> root.coc-device; }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            LineEdit { placeholder-text: Strings.coc-media; text <=> root.coc-media; }
                                            LineEdit { placeholder-text: Strings.coc-seq; text <=> root.coc-seq; }
                                        }
                                        LineEdit { placeholder-text: Strings.coc-description; text <=> root.coc-description; }
                                    }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px;
                                    Text { text: "LOG / DETAIL"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    Text { text: root.panel-detail == "" ? root.status-line : root.panel-detail; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== QMS =====
                    if root.nav-index == 5: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-qms-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Text { text: Strings.shell-qms-body; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
                            Button { text: Strings.run-qms; clicked => { root.run-qms-clicked(); } }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px;
                                    Text { text: root.panel-detail; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== BOOT =====
                    if root.nav-index == 6: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-boot-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Text { text: Strings.shell-boot-body; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { placeholder-text: "Boot image path"; text <=> root.boot-image-path; horizontal-stretch: 1; }
                                Button { text: Strings.boot-plan; clicked => { root.boot-plan-clicked(); } }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px;
                                    Text { text: root.panel-detail; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== HELP / SETTINGS =====
                    if root.nav-index == 7: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-help-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "SETTINGS"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        CheckBox {
                                            text: Strings.theme-dark;
                                            checked: root.dark-mode;
                                            toggled => {
                                                root.dark-mode = !root.dark-mode;
                                                root.theme-toggled(root.dark-mode);
                                            }
                                        }
                                        LocaleChip { label: Strings.lang-en; active: root.locale == "en"; clicked => { root.locale = "en"; root.locale-toggled("en"); } }
                                        LocaleChip { label: Strings.lang-id; active: root.locale == "id"; clicked => { root.locale = "id"; root.locale-toggled("id"); } }
                                    }
                                    LineEdit { placeholder-text: "Default examiner"; text <=> root.case-identity; }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: "OPERATOR HELP"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    Text { text: Strings.help_wb; color: Theme.readout; font-size: 12px; wrap: word-wrap; }
                                    Text { text: Strings.help_oov; color: Theme.readout; font-size: 12px; wrap: word-wrap; }
                                    Text { text: Strings.help_seal_vs_sig; color: Theme.readout; font-size: 12px; wrap: word-wrap; }
                                    Text { text: Strings.help_formats; color: Theme.readout; font-size: 12px; wrap: word-wrap; }
                                    Text { text: Strings.help_shortcuts; color: Theme.readout; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    // ===== ABOUT =====
                    if root.nav-index == 8: ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text { text: Strings.shell-about-title; color: Theme.readout; font-size: 24px; font-weight: 800; font-family: "Avenir Next"; }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 8px;
                                    Text { text: Strings.about-build; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    Text { text: root.about-text; color: Theme.readout; font-size: 12px; font-family: "Menlo"; wrap: word-wrap; }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    Text { text: root.app-version; color: Theme.mute; font-size: 11px; font-family: "Avenir Next"; }
                                    Text { text: root.app-build; color: Theme.mute; font-size: 11px; font-family: "Avenir Next"; }
                                    Rectangle { height: 1px; background: Theme.hairline; }
                                    Text { text: Strings.hash-seal-not-signature; color: Theme.mute; font-size: 11px; wrap: word-wrap; }
                                    Text { text: Strings.alpha-line; color: Theme.faint; font-size: 10px; font-family: "Menlo"; }
                                }
                            }
                            Rectangle {
                                background: Theme.panel; border-radius: Theme.radius; border-width: 1px; border-color: Theme.hairline;
                                VerticalLayout {
                                    padding: 14px; spacing: 4px;
                                    Text { text: "SESSION"; color: Theme.faint; font-size: 10px; font-weight: 700; font-family: "Avenir Next"; }
                                    Text { text: "Time: " + root.footer-time; color: Theme.mute; font-size: 11px; font-family: "Menlo"; }
                                    Text { text: "User: " + root.footer-user; color: Theme.mute; font-size: 11px; font-family: "Menlo"; }
                                    Text { text: "Workstation: " + root.footer-host; color: Theme.mute; font-size: 11px; font-family: "Menlo"; }
                                }
                            }
                        }
                    }
                }

                // Status strip 28px
                Rectangle {
                    height: Theme.status-h;
                    background: Theme.footer-bg;
                    border-color: Theme.hairline;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        Text { text: Strings.status-evidence + ": " + root.status-evidence-text; color: Theme.mute; font-size: 11px; font-family: "Menlo"; vertical-alignment: center; }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        Text { text: Strings.status-coverage + ": " + root.status-coverage-text; color: Theme.mute; font-size: 11px; font-family: "Menlo"; vertical-alignment: center; }
                        Text { text: "·"; color: Theme.hairline; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: Strings.status-extra + ": " + Strings.acquire-mode-label + ": " + root.status-mode-text;
                            color: Theme.mute; font-size: 11px; font-family: "Menlo"; vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text { text: root.footer-time; color: Theme.faint; font-size: 10px; font-family: "Menlo"; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
