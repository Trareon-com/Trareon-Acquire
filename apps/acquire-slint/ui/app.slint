// Trareon Acquire — foundation shell
// Design plan: .cursor/skills/frontend-design/DESIGN-TRAREON-ACQUIRE.md
// Signature: oversized SHA-256 evidence seal. Everything else quiet.

import { LineEdit, CheckBox } from "std-widgets.slint";

struct Palette {
    graphite: color,
    slate-paper: color,
    porcelain: color,
    case-indigo: color,
    case-ink: color,
    mute: color,
    faint: color,
    line: color,
    deny: color,
    seal: color,
}

global Colors {
    out property <Palette> p: {
        graphite: #161B22,
        slate-paper: #E9EEF2,
        porcelain: #FCFCFD,
        case-indigo: #2A3F5F,
        case-ink: #FFFFFF,
        mute: #66707C,
        faint: #94A0AB,
        line: #D2D9E0,
        deny: #8E2F2F,
        seal: #F7F1E6,
    };
}

component Rule inherits Rectangle {
    height: 1px;
    background: Colors.p.line;
    horizontal-stretch: 1;
}

component Eyebrow inherits Text {
    in property <string> label;
    text: root.label;
    color: Colors.p.faint;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
}

component ModePill inherits Rectangle {
    callback clicked;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    height: 32px;
    min-width: 92px;
    border-radius: 6px;
    background: root.active ? Colors.p.graphite : transparent;
    border-width: root.active ? 0px : 1px;
    border-color: Colors.p.line;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.active ? Colors.p.porcelain : Colors.p.graphite;
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component QuietButton inherits Rectangle {
    callback clicked;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    height: 40px;
    min-width: 112px;
    border-radius: 8px;
    background: !root.enabled
        ? #DDE3E9
        : root.primary ? Colors.p.case-indigo
        : root.ghost ? transparent
        : Colors.p.porcelain;
    border-width: (root.primary || !root.enabled || root.ghost) ? 0px : 1px;
    border-color: Colors.p.line;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: center;
        Text {
            text: root.label;
            color: !root.enabled ? Colors.p.faint
                : root.primary ? Colors.p.case-ink
                : Colors.p.graphite;
            font-size: 13px;
            font-weight: root.primary ? 600 : 500;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Trareon Acquire";
    preferred-width: 880px;
    preferred-height: 760px;
    min-width: 740px;
    min-height: 680px;
    background: Colors.p.slate-paper;

    in-out property <int> mode-index: 0;
    in-out property <string> mode-guidance: "";
    in-out property <bool> show-path-editors: false;
    in-out property <string> case-identity: "";
    in-out property <string> source-path: "";
    in-out property <string> output-dir: "";
    in-out property <bool> confirmed-synthetic: false;
    in-out property <string> status-line: "Ready — Lab Use Only";
    in-out property <string> last-package: "(none)";
    in-out property <string> evidence-sha256: "(none)";
    in-out property <string> evidence-size: "(none)";
    in-out property <string> preflight-hint: "";
    in-out property <bool> preflight-is-deny: false;
    in-out property <bool> busy: false;
    property <bool> can-run: root.confirmed-synthetic && root.source-path != "" && root.output-dir != "" && !root.busy;
    property <bool> has-package: root.last-package != "(none)";
    property <bool> has-hash: root.evidence-sha256 != "(none)";

    callback browse-source-clicked();
    callback browse-output-clicked();
    callback run-clicked();
    callback cancel-clicked();
    callback clear-clicked();
    callback fill-synthetic-clicked();
    callback export-coc-clicked();
    callback mode-changed(int);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Brand thesis — first viewport
        Rectangle {
            background: Colors.p.porcelain;
            VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 26px;
                padding-bottom: 22px;
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: "TRAREON";
                        color: Colors.p.graphite;
                        font-family: "Optima";
                        font-size: 12px;
                        font-weight: 700;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: "Lab Use Only";
                        color: Colors.p.case-indigo;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Acquire";
                    color: Colors.p.graphite;
                    font-family: "Optima";
                    font-size: 40px;
                    font-weight: 700;
                }
                Text {
                    text: "Capture. Hash. Verify.";
                    color: Colors.p.mute;
                    font-size: 15px;
                    font-weight: 400;
                }
            }
        }

        Rule {}

        Rectangle {
            background: Colors.p.slate-paper;
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 20px;

                VerticalLayout {
                    spacing: 10px;
                    Eyebrow { label: "MODE"; }
                    HorizontalLayout {
                        spacing: 8px;
                        ModePill {
                            label: "Guided";
                            active: root.mode-index == 0;
                            enabled: !root.busy;
                            clicked => { root.mode-changed(0); }
                        }
                        ModePill {
                            label: "Standard";
                            active: root.mode-index == 1;
                            enabled: !root.busy;
                            clicked => { root.mode-changed(1); }
                        }
                        ModePill {
                            label: "Expert";
                            active: root.mode-index == 2;
                            enabled: !root.busy;
                            clicked => { root.mode-changed(2); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Text {
                        text: root.mode-guidance;
                        color: Colors.p.mute;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Eyebrow { label: "CASE NOTE"; }
                    LineEdit {
                        text <=> root.case-identity;
                        enabled: !root.busy;
                        placeholder-text: "Operator note — not part of the cryptographic audit";
                        height: 38px;
                    }
                }

                if root.show-path-editors: VerticalLayout {
                    spacing: 12px;
                    Eyebrow { label: "PATHS"; }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Source"; color: Colors.p.mute; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.source-path;
                                enabled: !root.busy;
                                placeholder-text: "Synthetic source file";
                                height: 38px;
                            }
                            QuietButton {
                                label: "Browse";
                                enabled: !root.busy;
                                clicked => { root.browse-source-clicked(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Output"; color: Colors.p.mute; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.output-dir;
                                enabled: !root.busy;
                                placeholder-text: "Output directory";
                                height: 38px;
                            }
                            QuietButton {
                                label: "Browse";
                                enabled: !root.busy;
                                clicked => { root.browse-output-clicked(); }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Source is synthetic or training — not real evidence.";
                        checked <=> root.confirmed-synthetic;
                        enabled: !root.busy;
                    }
                    if root.preflight-hint != "": Text {
                        text: root.preflight-hint;
                        color: root.preflight-is-deny ? Colors.p.deny : Colors.p.case-indigo;
                        font-size: 12px;
                        font-weight: 500;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    QuietButton {
                        label: root.busy ? "Working…" : "Acquire";
                        primary: true;
                        enabled: root.can-run;
                        clicked => { root.run-clicked(); }
                    }
                    QuietButton {
                        label: "Cancel";
                        enabled: root.busy;
                        clicked => { root.cancel-clicked(); }
                    }
                    QuietButton {
                        label: "Fill demo";
                        enabled: !root.busy;
                        clicked => { root.fill-synthetic-clicked(); }
                    }
                    QuietButton {
                        label: "Export CoC";
                        enabled: !root.busy && root.has-package;
                        clicked => { root.export-coc-clicked(); }
                    }
                    QuietButton {
                        label: "Clear";
                        ghost: true;
                        enabled: !root.busy;
                        clicked => { root.clear-clicked(); }
                    }
                }

                // SIGNATURE — evidence seal
                Rectangle {
                    background: Colors.p.seal;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #E2D8C8;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                text: "EVIDENCE SEAL";
                                color: Colors.p.case-indigo;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.6px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text {
                                text: root.has-hash ? "Verified" : "Awaiting acquire";
                                color: root.has-hash ? Colors.p.case-indigo : Colors.p.faint;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "SHA-256";
                            color: Colors.p.faint;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.evidence-sha256;
                            color: Colors.p.graphite;
                            font-family: "Menlo";
                            font-size: root.has-hash ? 15px : 14px;
                            font-weight: 500;
                            wrap: word-wrap;
                        }

                        Rule { background: #E2D8C8; }

                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Status"; color: Colors.p.faint; font-size: 10px; font-weight: 600; }
                                Text { text: root.status-line; color: Colors.p.graphite; font-size: 12px; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "Size"; color: Colors.p.faint; font-size: 10px; font-weight: 600; }
                                Text {
                                    text: root.evidence-size == "(none)" ? "—" : root.evidence-size + " B";
                                    color: Colors.p.graphite;
                                    font-family: "Menlo";
                                    font-size: 12px;
                                }
                            }
                        }
                        Text {
                            text: "Package  " + root.last-package;
                            color: Colors.p.mute;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Text {
                    text: "GPLv3 · unsigned Founder · cancel arms cancel_flag · trust only independent verify";
                    color: Colors.p.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
