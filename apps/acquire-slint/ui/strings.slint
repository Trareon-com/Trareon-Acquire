    out property <string> hint-identify: is-id ? "ISO · kenali sumber" : "ISO · know source";
    out property <string> nav-acquire: is-id ? "Akuisisi" : "Acquire";
    out property <string> hint-acquire: is-id ? "Siapkan · jalankan · segel" : "Prepare · run · seal";
    out property <string> nav-triage: is-id ? "Triage" : "Triage";
    out property <string> hint-triage: is-id ? "Pasca-akuisisi" : "Post-acquire";
    out property <string> nav-tools: is-id ? "Alat" : "Tools";
    out property <string> hint-tools: is-id ? "Verifikasi / utilitas" : "Verify / utilities";
    out property <string> nav-qms: "QMS";
    out property <string> hint-qms: is-id ? "Validasi lab" : "Lab validation";
    out property <string> nav-boot: is-id ? "Boot (preview)" : "Boot (preview)";
    out property <string> hint-boot: is-id ? "Media portabel" : "Portable media";
    out property <string> nav-help: is-id ? "Bantuan" : "Help";
    out property <string> hint-help: is-id ? "SOP singkat" : "Short SOP";
    out property <string> nav-about: is-id ? "Tentang" : "About";
    out property <string> hint-about: is-id ? "Identitas build" : "Build identity";

    out property <string> chip-case: is-id ? "Kasus" : "Case";
    out property <string> chip-wb: is-id ? "Write-blocker" : "Write-blocker";
    out property <string> chip-integrity: is-id ? "Integritas" : "Integrity";
    out property <string> integrity-standby: is-id ? "Siaga" : "Standby";
    out property <string> integrity-ready: is-id ? "Siap akuisisi" : "Ready";
    out property <string> integrity-sealed: is-id ? "Tersegel" : "Sealed";
    out property <string> integrity-running: is-id ? "Berjalan" : "Running";
    out property <string> case-id-label: is-id ? "ID BUKTI / KASUS" : "EVIDENCE / CASE ID";
    out property <string> examiner-label: is-id ? "PEMERIKSA" : "EXAMINER";
    out property <string> confirm-wb: is-id
        ? "Saya konfirmasi write-blocker perangkat keras terpasang (sumber blok)."
        : "I confirm a hardware write-blocker is in place (block device source).";

    out property <string> shell-cases-title: is-id ? "Konteks kasus" : "Case context";
    out property <string> shell-cases-body: is-id
        ? "Tetapkan identitas kasus dan pemeriksa sebelum akuisisi. ISO/IEC 27037: catatan siapa/kapan harus dapat diaudit bersama bukti."
        : "Set case and examiner identity before acquisition. ISO/IEC 27037: who/when must remain auditable with the evidence.";
    out property <string> shell-identify-title: is-id ? "Identifikasi sumber" : "Source identification";
    out property <string> shell-identify-body: is-id
        ? "Catat daya, jaringan, enkripsi, dan checklist di luar pandang. Jangan klaim write-blocker atau HPA tanpa bukti probe."
        : "Record power, network, encryption, and out-of-view checklist. Do not claim write-blocker or HPA without probe evidence.";
    out property <string> shell-triage-title: is-id ? "Triage baca-saja" : "Read-only triage";
    out property <string> shell-triage-body: is-id
        ? "Tinjau hasil setelah segel. Analisis mendalam (gaya Autopsy) bukan pekerjaan meja akuisisi — gunakan Lab terpisah."
        : "Review after seal. Deep analysis (Autopsy-style) is not the acquisition job — use a separate Lab surface.";
    out property <string> shell-tools-title: is-id ? "Alat verifikasi" : "Verification tools";
    out property <string> shell-tools-body: is-id
        ? "Hub verifikasi dan utilitas. Hash segel membuktikan konsistensi byte; verifikasi independen tetap wajib."
        : "Verifier hub and utilities. A hash seal proves byte consistency; independent verification remains required.";
    out property <string> shell-qms-title: is-id ? "Mutu lab (QMS)" : "Lab quality (QMS)";
    out property <string> shell-qms-body: is-id
        ? "Self-test, dataset dikenal, dan matriks validasi. Klaim produk harus sama dengan bukti yang tercatat."
        : "Self-test, known datasets, and validation matrix. Product claims must match recorded evidence.";
    out property <string> shell-boot-title: is-id ? "Media boot / portabel" : "Boot / portable media";
    out property <string> shell-boot-body: is-id
        ? "Paket USB dan distribusi portabel untuk akuisisi di lapangan. Tanda tangan/notarisasi produksi masih di luar jalur lab."
        : "USB pack and portable distribution for field acquisition. Production signing/notarization remains outside the lab track.";
    out property <string> shell-help-title: is-id ? "Bantuan operator" : "Operator help";
    out property <string> shell-help-body: is-id
        ? "SOP singkat: write-blocker, di luar validasi, segel vs tanda tangan, format, dan pintasan keyboard."
        : "Short SOP: write-blocker, out of validation, seal vs signature, formats, and keyboard shortcuts.";
    out property <string> help_wb: is-id
        ? "Write-blocker: gunakan blocker perangkat keras bila tersedia. Jika tidak, catat konfirmasi manual di audit. Jangan klaim terdeteksi tanpa bukti."
        : "Write-blocker: use a hardware blocker when available. Otherwise record manual confirmation in the audit. Do not claim detection without evidence.";
    out property <string> help_oov: is-id
        ? "Sumber di luar validasi: hentikan bila sumber, tujuan, atau metode tidak tercakup kebijakan lab. Buat prosedur baru sebelum melanjutkan."
        : "Out of validation: stop when the source, destination, or method is outside the lab policy. Create a new procedure before proceeding.";
    out property <string> help_seal_vs_sig: is-id
        ? "Segel hash membuktikan konsistensi byte yang diperiksa; bukan tanda tangan digital, otorisasi, atau pengganti verifikasi independen."
        : "A hash seal proves consistency of the checked bytes; it is not a digital signature, authorization, or a substitute for independent verification.";
    out property <string> help_formats: is-id
        ? "Format: .fsnap (Path A kandidat), E01 (ewf-image), ZFF opsional, Split-RAW. Catat verifikasi eksternal di EVIDENCE.md."
        : "Formats: .fsnap (Path A candidate), E01 (ewf-image), optional ZFF, Split-RAW. Record external verification in EVIDENCE.md.";
    out property <string> help_shortcuts: is-id
        ? "Pintasan: Tab memindahkan fokus, Space mengaktifkan kontrol, Esc membatalkan dialog. Gunakan fokus keyboard yang terlihat untuk meninjau sebelum akuisisi."
        : "Shortcuts: Tab moves focus, Space activates controls, Esc cancels dialogs. Use visible keyboard focus to review before acquisition.";

    out property <string> step-prepare: is-id ? "1 · Siapkan" : "1 · Prepare";
    out property <string> step-run: is-id ? "2 · Akuisisi" : "2 · Acquire";
    out property <string> step-seal: is-id ? "3 · Segel" : "3 · Seal";

    out property <string> prepare-guided-title: is-id ? "Siapkan sumber demo" : "Prepare a demo source";
    out property <string> prepare-guided-body: is-id
        ? "Isi jalur sintetis, konfirmasi, lalu akuisisi. Tidak menyentuh disk raw."
        : "Load synthetic paths, confirm, then acquire. Never touches raw disks.";
    out property <string> prepare-paths-title: is-id ? "Tetapkan sumber dan keluaran" : "Set source and output";
    out property <string> prepare-paths-body: is-id
        ? "Pilih berkas sumber dan folder paket. Konfirmasi bahwa ini pelatihan, bukan bukti nyata."
        : "Choose a source file and package folder. Confirm this is training, not real evidence.";

    out property <string> case-note: is-id ? "Catatan kasus (opsional)" : "Case note (optional)";
    out property <string> case-placeholder: is-id ? "Mis. TRN-2026-0001 — tidak masuk audit kriptografis" : "e.g. TRN-2026-0001 — outside the cryptographic audit";
    out property <string> paths: is-id ? "Jalur" : "Paths";
    out property <string> source: is-id ? "Sumber" : "Source";
    out property <string> output: is-id ? "Keluaran" : "Output";
    out property <string> source-placeholder: is-id ? "Berkas sumber sintetis" : "Synthetic source file";
