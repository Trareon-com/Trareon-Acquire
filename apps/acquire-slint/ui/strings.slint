// Chrome copy for EN / ID. User-facing labels live here only.

export global Strings {
    in-out property <string> locale: "en";
    out property <bool> is-id: locale == "id";

    out property <string> brand-product: "Acquire";
    out property <string> evidence-station: is-id ? "Stasiun bukti" : "Evidence station";
    out property <string> operator-mode: is-id ? "MODE OPERATOR" : "OPERATOR MODE";
    out property <string> mode-guided: is-id ? "Terpandu" : "Guided";
    out property <string> mode-standard: is-id ? "Standar" : "Standard";
    out property <string> mode-expert: is-id ? "Ahli" : "Expert";
    out property <string> hint-guided: is-id ? "Demo sintetis" : "Synthetic demo";
    out property <string> hint-standard: is-id ? "Jalur berkas" : "File paths";
    out property <string> hint-expert: is-id ? "Allowlist / raw" : "Allowlist / raw";
    out property <string> lab-only: is-id ? "HANYA LAB" : "LAB USE ONLY";
    out property <string> alpha-line: is-id ? "Engineering Alpha\nv0.1 · GPLv3" : "Engineering Alpha\nv0.1 · GPLv3";
    out property <string> tagline: is-id ? "Tangkap. Hash. Verifikasi." : "Capture. Hash. Verify.";
    out property <string> founder-badge: is-id ? "UNSIGNED · FOUNDER" : "UNSIGNED · FOUNDER";
    out property <string> pipe-capture: is-id ? "Tangkap" : "Capture";
    out property <string> pipe-hash: "Hash";
    out property <string> pipe-verify: is-id ? "Verifikasi" : "Verify";
    out property <string> state-standby: is-id ? "SIAGA" : "STANDBY";
    out property <string> state-running: is-id ? "BERJALAN" : "RUNNING";
    out property <string> state-sealed: is-id ? "TERSEGEL" : "SEALED";
    out property <string> case-note: is-id ? "CATATAN KASUS" : "CASE NOTE";
    out property <string> case-placeholder: is-id ? "Catatan operator — di luar audit kriptografis" : "Operator note — outside the cryptographic audit";
    out property <string> paths: is-id ? "JALUR" : "PATHS";
    out property <string> source: is-id ? "Sumber" : "Source";
    out property <string> output: is-id ? "Keluaran" : "Output";
    out property <string> source-placeholder: is-id ? "Berkas sumber sintetis" : "Synthetic source file";
    out property <string> output-placeholder: is-id ? "Direktori keluaran" : "Output directory";
    out property <string> browse: is-id ? "Jelajah" : "Browse";
    out property <string> confirm-synthetic: is-id ? "Sumber sintetis atau pelatihan — bukan bukti nyata." : "Source is synthetic or training — not real evidence.";
    out property <string> acquire: is-id ? "Akuisisi" : "Acquire";
    out property <string> working: is-id ? "Bekerja…" : "Working…";
    out property <string> cancel: is-id ? "Batal" : "Cancel";
    out property <string> fill-demo: is-id ? "Isi demo" : "Fill demo";
    out property <string> export-coc: is-id ? "Ekspor CoC" : "Export CoC";
    out property <string> clear: is-id ? "Bersihkan" : "Clear";
    out property <string> evidence-seal: is-id ? "SEGEL BUKTI" : "EVIDENCE SEAL";
    out property <string> verified: is-id ? "TERVERIFIKASI" : "VERIFIED";
    out property <string> awaiting: is-id ? "MENUNGGU" : "AWAITING";
    out property <string> sha-label: "SHA-256";
    out property <string> status: is-id ? "STATUS" : "STATUS";
    out property <string> size: is-id ? "UKURAN" : "SIZE";
    out property <string> package: is-id ? "PAKET" : "PACKAGE";
    out property <string> none-label: is-id ? "(tidak ada)" : "(none)";
    out property <string> footer: is-id
        ? "Verifikasi independen wajib · batal menghentikan akuisisi · belum divalidasi untuk bukti produksi"
        : "Independent verify required · cancel interrupts in-flight acquire · not validated for production evidence";
    out property <string> theme-dark: is-id ? "Gelap" : "Dark";
    out property <string> theme-light: is-id ? "Terang" : "Light";
    out property <string> lang-en: "EN";
    out property <string> lang-id: "ID";
}
