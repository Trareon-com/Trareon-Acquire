    out property <string> col-bus: "BUS";
    out property <string> case-verify-mismatch: is-id
        ? "Case verify tidak cocok dengan Case ID."
        : "Case verify does not match case ID.";
    out property <string> identify-gate-banner: is-id
        ? "Identify belum lengkap — checklist wajib sebelum akuisisi Expert/blockish."
        : "Identify gate incomplete — checklist required before Expert/blockish acquire.";
    out property <string> open-identify: is-id ? "Buka Identify" : "Open Identify";
    out property <string> create-case-heading: is-id ? "BUAT KASUS" : "CREATE CASE";
    out property <string> case-title-ph: is-id ? "Judul kasus" : "Case title";
