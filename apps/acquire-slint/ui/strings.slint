// Chrome copy for EN / ID — operator-facing workflow language.

export global Strings {
    in-out property <string> locale: "en";
    out property <bool> is-id: locale == "id";

    out property <string> brand-product: "Acquire";
    out property <string> evidence-station: is-id ? "Meja akuisisi" : "Acquisition bench";
    out property <string> operator-mode: is-id ? "MODE" : "MODE";
    out property <string> mode-guided: is-id ? "Terpandu" : "Guided";
