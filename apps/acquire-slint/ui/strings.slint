    out property <string> why-matters-title: is-id ? "MENGAPA INI PENTING" : "WHY THIS MATTERS";
    out property <string> why-matters-body: is-id
        ? "Identifikasi sumber mendahului akuisisi. ISO/IEC 27037:2012: catat daya, jaringan, dan lingkup sebelum menyalin."
        : "Source identification precedes acquisition. ISO/IEC 27037:2012: record power, network, and scope before copying.";
