// Lab-instrument palette — copper primary, refined neutrals, clear state variants.

export global Theme {
    in-out property <bool> dark: false;
    in-out property <color> void: #F4F6F8;
    in-out property <color> ink: #FFFFFF;
    in-out property <color> panel: #FFFFFF;
    in-out property <color> raised: #EEF1F4;
    in-out property <color> hairline: #D8DDE3;
    in-out property <color> copper: #AF622E;
    in-out property <color> copper-dim: #8F4A24;
    in-out property <color> copper-deep: #8A3F1A;
    in-out property <color> copper-hot: #C96A38;
    in-out property <color> copper-hover: #B85A28;
    in-out property <color> readout: #1E2A36;
    in-out property <color> mute: #5F6F7F;
    in-out property <color> faint: #8A94A0;
    in-out property <color> deny: #B04040;
    in-out property <color> deny-mist: #F8EAEA;
    in-out property <color> ok-mist: #E6F2EA;
    in-out property <color> ok-glow: #2F855A;
    in-out property <color> on-copper: #FFFFFF;
    in-out property <color> seal-well: #FFFFFF;
    in-out property <color> seal-ok: #E8F2EC;
    in-out property <color> rail-active: #FFF4EC;
    in-out property <color> pipeline-bg: #FFFFFF;
    in-out property <color> badge-bg: #F0F3F6;
    in-out property <color> primary-disabled: #E4D2C4;
    in-out property <color> warning: #AF622E;
    in-out property <color> info: #5F6F7F;
    in-out property <color> focus-ring: #C96A38;
    in-out property <color> unsigned-well: #FFF2E8;
    in-out property <color> unsigned-border: #F0DCC8;
    in-out property <color> unsigned-text: #AF622E;
    in-out property <color> footer-bg: #EAEFF3;
    in-out property <color> table-head: #EEF1F4;
    in-out property <color> icon-circle: #FFFFFF;
    in-out property <color> icon-well: #F0F3F6;
    in-out property <color> icon-soft: #A8B4C0;
    in-out property <color> placeholder-line: #C5CDD6;
    in-out property <color> stage-track: #E8ECF0;
    in-out property <length> radius: 8px;
    in-out property <length> radius-sm: 5px;
    in-out property <length> radius-lg: 10px;
    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 14px;
    in-out property <length> space-lg: 18px;
    in-out property <length> space-xl: 22px;
    in-out property <length> page-pad: 20px;

    // ASCII chrome metrics (wide defaults; rail collapses in compact via app.slint)
    out property <length> banner-h: 26px;
    out property <length> header-h: 48px;
    out property <length> safety-h: 40px;
    out property <length> status-h: 30px;
    out property <length> rail-w: 188px;
    out property <length> rail-w-compact: 56px;
    out property <length> zone-source-min: 280px;
    out property <length> zone-prepare-min: 260px;
    out property <length> zone-run-min: 220px;
    out property <length> window-min-w: 920px;
    out property <length> window-min-h: 680px;

    public function apply(is-dark: bool) {
        dark = is-dark;
        if is-dark {
            void = #0C1014;
            ink = #121820;
            panel = #161E26;
            raised = #1C2630;
            hairline = #2A3644;
            copper = #C4845A;
            copper-dim = #8A5E42;
            copper-deep = #A86A42;
            copper-hot = #E0A070;
            copper-hover = #D09060;
            readout = #E8EEF4;
            mute = #8B9AAB;
            faint = #5C6B7A;
            deny = #D16B6B;
            deny-mist = #3A1E1E;
            ok-mist = #2E4A3C;
            ok-glow = #B7D4BE;
            on-copper = #140E0A;
            seal-well = #121820;
            seal-ok = #101C18;
            rail-active = #1A2430;
            pipeline-bg = #121820;
            badge-bg = #1A2430;
            primary-disabled = #2A221C;
            warning = #C4845A;
            info = #8B9AAB;
            focus-ring = #E0A070;
            unsigned-well = #3A2A20;
            unsigned-border = #5A4030;
            unsigned-text = #E0A070;
            footer-bg = #0E141A;
            table-head = #1A2430;
            icon-circle = #1A2430;
            icon-well = #1A2430;
            icon-soft = #5C6B7A;
            placeholder-line = #3A4654;
            stage-track = #1C2630;
        } else {
            void = #F4F6F8;
            ink = #FFFFFF;
            panel = #FFFFFF;
            raised = #EEF1F4;
            hairline = #D8DDE3;
            copper = #AF622E;
            copper-dim = #8F4A24;
            copper-deep = #8A3F1A;
            copper-hot = #C96A38;
            copper-hover = #B85A28;
            readout = #1E2A36;
            mute = #5F6F7F;
            faint = #8A94A0;
            deny = #B04040;
            deny-mist = #F8EAEA;
            ok-mist = #E6F2EA;
            ok-glow = #2F855A;
            on-copper = #FFFFFF;
            seal-well = #FFFFFF;
            seal-ok = #E8F2EC;
            rail-active = #FFF4EC;
            pipeline-bg = #FFFFFF;
            badge-bg = #F0F3F6;
            primary-disabled = #E4D2C4;
            warning = #AF622E;
            info = #5F6F7F;
            focus-ring = #C96A38;
            unsigned-well = #FFF2E8;
            unsigned-border = #F0DCC8;
            unsigned-text = #AF622E;
            footer-bg = #EAEFF3;
            table-head = #EEF1F4;
            icon-circle = #FFFFFF;
            icon-well = #F0F3F6;
            icon-soft = #A8B4C0;
            placeholder-line = #C5CDD6;
            stage-track = #E8ECF0;
        }
    }
}
