// Pixel-sampled from 01-acquire-bench mock (1024×682).
// Copper dominant ≈ rgb(175,98,46) → #AF622E

export global Theme {
    in-out property <bool> dark: false;
    in-out property <color> void: #F8F9FA;
    in-out property <color> ink: #FFFFFF;
    in-out property <color> panel: #FFFFFF;
    in-out property <color> raised: #F3F5F7;
    in-out property <color> hairline: #E0E3E7;
    in-out property <color> copper: #AF622E;
    in-out property <color> copper-dim: #8F4A24;
    in-out property <color> copper-hot: #C96A38;
    in-out property <color> readout: #2C3E50;
    in-out property <color> mute: #718096;
    in-out property <color> faint: #8A94A0;
    in-out property <color> deny: #B04040;
    in-out property <color> deny-mist: #F6E4E4;
    in-out property <color> ok-mist: #E6F2EA;
    in-out property <color> ok-glow: #2F855A;
    in-out property <color> on-copper: #FFFFFF;
    in-out property <color> seal-well: #FFFFFF;
    in-out property <color> seal-ok: #E8F2EC;
    in-out property <color> rail-active: #FFF5EF;
    in-out property <color> pipeline-bg: #FFFFFF;
    in-out property <color> badge-bg: #F7F8FA;
    in-out property <color> primary-disabled: #E8D5C8;
    in-out property <color> warning: #AF622E;
    in-out property <color> info: #718096;
    in-out property <color> focus-ring: #C96A38;
    in-out property <color> unsigned-well: #FFF2E8;
    in-out property <color> unsigned-border: #F0DCC8;
    in-out property <color> unsigned-text: #AF622E;
    in-out property <color> footer-bg: #F3F5F7;
    in-out property <color> table-head: #F3F5F7;
    in-out property <color> icon-circle: #FFFFFF;
    in-out property <length> radius: 6px;
    in-out property <length> radius-sm: 4px;

    // ASCII chrome metrics (wide defaults; rail collapses in compact via app.slint)
    out property <length> banner-h: 26px;
    out property <length> header-h: 48px;
    out property <length> safety-h: 36px;
    out property <length> status-h: 28px;
    out property <length> rail-w: 180px;
    out property <length> rail-w-compact: 56px;
    out property <length> zone-source-min: 280px;
    out property <length> zone-prepare-min: 260px;
    out property <length> zone-run-min: 220px;
    out property <length> window-min-w: 920px;
    out property <length> window-min-h: 680px;

    public function apply(is-dark: bool) {
        dark = is-dark;
        if is-dark {
            void = #0C1014;
            ink = #121820;
            panel = #161E26;
            raised = #1C2630;
            hairline = #2A3644;
            copper = #C4845A;
            copper-dim = #8A5E42;
            copper-hot = #E0A070;
            readout = #E8EEF4;
            mute = #8B9AAB;
            faint = #5C6B7A;
            deny = #D16B6B;
            deny-mist = #3A1E1E;
            ok-mist = #2E4A3C;
            ok-glow = #B7D4BE;
            on-copper = #140E0A;
            seal-well = #121820;
            seal-ok = #101C18;
            rail-active = #1A2430;
            pipeline-bg = #121820;
            badge-bg = #1A2430;
            primary-disabled = #2A221C;
            warning = #C4845A;
            info = #8B9AAB;
            focus-ring = #E0A070;
            unsigned-well = #3A2A20;
            unsigned-border = #5A4030;
            unsigned-text = #E0A070;
            footer-bg = #0E141A;
            table-head = #1A2430;
            icon-circle = #1A2430;
        } else {
            void = #F8F9FA;
            ink = #FFFFFF;
            panel = #FFFFFF;
            raised = #F3F5F7;
            hairline = #E0E3E7;
            copper = #AF622E;
            copper-dim = #8F4A24;
            copper-hot = #C96A38;
            readout = #2C3E50;
            mute = #718096;
            faint = #8A94A0;
            deny = #B04040;
            deny-mist = #F6E4E4;
            ok-mist = #E6F2EA;
            ok-glow = #2F855A;
            on-copper = #FFFFFF;
            seal-well = #FFFFFF;
            seal-ok = #E8F2EC;
            rail-active = #FFF5EF;
            pipeline-bg = #FFFFFF;
            badge-bg = #F7F8FA;
            primary-disabled = #E8D5C8;
            warning = #AF622E;
            info = #718096;
            focus-ring = #C96A38;
            unsigned-well = #FFF2E8;
            unsigned-border = #F0DCC8;
            unsigned-text = #AF622E;
            footer-bg = #F3F5F7;
            table-head = #F3F5F7;
            icon-circle = #FFFFFF;
        }
    }
}
