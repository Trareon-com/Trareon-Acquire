// Shared page chrome for secondary surfaces — Lab instrument copper system.

import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> body: "";
    spacing: 6px;
    Text {
        text: root.title;
        color: Theme.readout;
        font-size: 22px;
        font-weight: 800;
        font-family: "Avenir Next";
    }
    if root.body != "": Text {
        text: root.body;
        color: Theme.mute;
        font-size: 12px;
        font-family: "Avenir Next";
        wrap: word-wrap;
    }
}

export component FieldLabel inherits Text {
    in property <string> caption;
    text: root.caption;
    color: Theme.faint;
    font-size: 9px;
    font-weight: 700;
    font-family: "Avenir Next";
}

export component PrimaryBtn inherits Rectangle {
    in-out property <string> label;
    in-out property <string> glyph: "";
    in-out property <bool> enabled: true;
    callback clicked;
    height: 36px;
    min-width: 120px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.primary-disabled
        : (ta.has-hover ? Theme.copper-hover : Theme.copper);
    border-width: ta.has-hover && root.enabled ? 1px : 0;
    border-color: Theme.focus-ring;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;
        alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            color: root.enabled ? Theme.on-copper : Theme.mute;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.on-copper : Theme.mute;
            font-size: 12px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostBtn inherits Rectangle {
    in-out property <string> label;
    in-out property <string> glyph: "";
    in-out property <bool> enabled: true;
    callback clicked;
    height: 36px;
    min-width: 100px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover && root.enabled ? Theme.badge-bg : Theme.raised;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            color: root.enabled ? Theme.copper : Theme.faint;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.readout : Theme.faint;
            font-size: 11px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component StatusBadge inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> ok: false;
    in-out property <bool> warn: false;
    height: 22px;
    border-radius: 11px;
    background: root.ok ? Theme.ok-mist : (root.warn ? Theme.unsigned-well : Theme.badge-bg);
    border-width: 1px;
    border-color: root.ok ? Theme.ok-glow : (root.warn ? Theme.unsigned-border : Theme.hairline);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.mute);
            font-size: 10px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
}

export component CheckRow inherits Rectangle {
    in-out property <string> label;
    in-out property <string> hint: "";
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled;
    min-height: 44px;
    border-radius: Theme.radius-sm;
    background: root.checked ? Theme.rail-active : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.unsigned-border : transparent;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: 2px;
            border-radius: 4px;
            background: root.checked ? Theme.copper : Theme.raised;
            border-width: 1px;
            border-color: root.checked ? Theme.copper : Theme.hairline;
            Text {
                text: root.checked ? "✓" : "";
                color: Theme.on-copper;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.readout;
                font-size: 12px;
                font-weight: 600;
                font-family: "Avenir Next";
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.mute;
                font-size: 10px;
                font-family: "Avenir Next";
                wrap: word-wrap;
            }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component MetaRow inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <bool> copyable: false;
    in-out property <bool> ok: false;
    callback copy-clicked;
    min-height: 28px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.caption;
            width: 88px;
            color: Theme.faint;
            font-size: 10px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.ok ? Theme.ok-glow : Theme.readout;
            font-size: 11px;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.copyable && root.value != "" && root.value != "(none)": Rectangle {
            width: 28px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: copy-ta.has-hover ? Theme.unsigned-well : Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            Text {
                text: "⧉";
                color: Theme.copper;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            copy-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-clicked(); }
            }
        }
    }
}

export component EmptyHint inherits Rectangle {
    in-out property <string> title;
    in-out property <string> body: "";
    min-height: 120px;
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.title;
            color: Theme.readout;
            font-size: 13px;
            font-weight: 700;
            font-family: "Avenir Next";
            horizontal-alignment: center;
        }
        if root.body != "": Text {
            text: root.body;
            color: Theme.mute;
            font-size: 11px;
            font-family: "Avenir Next";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component HelpTopic inherits Rectangle {
    in-out property <string> title;
    in-out property <string> body;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.copper;
            font-size: 12px;
            font-weight: 800;
            font-family: "Avenir Next";
        }
        Text {
            text: root.body;
            color: Theme.readout;
            font-size: 12px;
            font-family: "Avenir Next";
            wrap: word-wrap;
        }
    }
}

export component CaseRow inherits Rectangle {
    in-out property <string> id;
    in-out property <string> title;
    in-out property <string> examiner;
    in-out property <string> state;
    in-out property <string> updated;
    in-out property <bool> active: false;
    callback clicked;
    height: 40px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.rail-active : (ta.has-hover ? Theme.raised : transparent);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.id;
            width: 140px;
            color: Theme.readout;
            font-size: 11px;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.title;
            horizontal-stretch: 1;
            color: Theme.readout;
            font-size: 11px;
            font-family: "Avenir Next";
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.examiner;
            width: 90px;
            color: Theme.mute;
            font-size: 10px;
            font-family: "Avenir Next";
            vertical-alignment: center;
            overflow: elide;
        }
        StatusBadge {
            label: root.state;
            ok: root.state == "Acquire" || root.state == "Preserve";
            warn: root.state == "Identify";
        }
        Text {
            text: root.updated;
            width: 72px;
            color: Theme.faint;
            font-size: 9px;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ResultRow inherits Rectangle {
    in-out property <string> name;
    in-out property <bool> ok: false;
    in-out property <string> detail: "";
    min-height: 36px;
    border-radius: Theme.radius-sm;
    background: root.ok ? Theme.ok-mist : Theme.deny-mist;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        StatusBadge {
            label: root.ok ? "PASS" : "FAIL";
            ok: root.ok;
            warn: !root.ok;
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Theme.readout;
                font-size: 12px;
                font-weight: 600;
                font-family: "Avenir Next";
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.mute;
                font-size: 10px;
                font-family: "Menlo";
                wrap: word-wrap;
            }
        }
    }
}

export component LogLineRow inherits Rectangle {
    in-out property <string> level: "info";
    in-out property <string> text;
    min-height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.level;
            width: 48px;
            color: root.level == "err" ? Theme.deny : (root.level == "ok" ? Theme.ok-glow : Theme.faint);
            font-size: 9px;
            font-weight: 700;
            font-family: "Menlo";
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.readout;
            font-size: 11px;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
}

export component CoverageBar inherits Rectangle {
    in-out property <float> ok-frac: 0.0;
    in-out property <float> err-frac: 0.0;
    height: 10px;
    border-radius: 5px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.hairline;
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: parent.width * root.ok-frac;
        background: Theme.ok-glow;
        border-radius: 5px;
    }
    Rectangle {
        x: parent.width * root.ok-frac;
        y: 0;
        height: 100%;
        width: parent.width * root.err-frac;
        background: Theme.deny;
        border-radius: 5px;
    }
}

export component DraftBanner inherits Rectangle {
    in-out property <string> summary;
    callback resume-clicked;
    callback discard-clicked;
    background: Theme.unsigned-well;
    border-width: 1px;
    border-color: Theme.unsigned-border;
    border-radius: Theme.radius-sm;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Text {
            text: root.summary;
            color: Theme.unsigned-text;
            font-size: 11px;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        GhostBtn { label: Strings.draft-discard; clicked => { root.discard-clicked(); } }
        PrimaryBtn { label: Strings.draft-resume; clicked => { root.resume-clicked(); } }
    }
}
