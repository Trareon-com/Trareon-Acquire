// Shared page chrome for secondary surfaces — Lab instrument copper system.

import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> body: "";
    spacing: 8px;
    Text {
        text: root.title;
        color: Theme.readout;
        font-size: Theme.font-title;
        font-weight: 800;
        font-family: "Avenir Next";
        letter-spacing: -0.3px;
    }
    if root.body != "": Text {
        text: root.body;
        color: Theme.mute;
        font-size: Theme.font-body;
        font-family: "Avenir Next";
        wrap: word-wrap;
    }
}

export component FieldLabel inherits Text {
    in property <string> caption;
    text: root.caption;
    color: Theme.faint;
    font-size: Theme.font-label;
    font-weight: 700;
    font-family: "Avenir Next";
}

/// Zone / panel section title — copper lab instrument eyebrow.
export component ZoneCaption inherits Text {
    in property <string> caption;
    text: root.caption;
    color: Theme.copper;
    font-size: Theme.font-caption;
    font-weight: 800;
    font-family: "Avenir Next";
    letter-spacing: 0.8px;
}

export component PrimaryBtn inherits Rectangle {
    in-out property <string> label;
    in-out property <string> glyph: "";
    in-out property <bool> enabled: true;
    callback clicked;
    height: Theme.btn-h;
    min-width: Theme.btn-min-w;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.primary-disabled
        : (ta.has-hover ? Theme.copper-hover : Theme.copper);
    border-width: ta.has-hover && root.enabled ? 1px : 0;
    border-color: Theme.focus-ring;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            color: root.enabled ? Theme.on-copper : Theme.mute;
            font-size: Theme.font-label;
            font-weight: 700;
            font-family: "Menlo";
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.on-copper : Theme.mute;
            font-size: Theme.font-ui;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GhostBtn inherits Rectangle {
    in-out property <string> label;
    in-out property <string> glyph: "";
    in-out property <bool> enabled: true;
    callback clicked;
    height: Theme.btn-h;
    min-width: Theme.ghost-min-w;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: ta.has-hover && root.enabled ? Theme.unsigned-well : Theme.raised;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.unsigned-border : Theme.hairline;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            color: root.enabled ? Theme.copper : Theme.faint;
            font-size: Theme.font-label;
            font-weight: 700;
            font-family: "Menlo";
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.readout : Theme.faint;
            font-size: Theme.font-ui;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component StatusBadge inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> ok: false;
    in-out property <bool> warn: false;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: root.ok ? Theme.ok-mist : (root.warn ? Theme.unsigned-well : Theme.badge-bg);
    border-width: 1px;
    border-color: root.ok ? Theme.ok-glow : (root.warn ? Theme.unsigned-border : Theme.hairline);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.ok ? Theme.ok-glow : (root.warn ? Theme.copper : Theme.mute);
            font-size: Theme.font-caption;
            font-weight: 700;
            font-family: "Avenir Next";
            vertical-alignment: center;
        }
    }
}

/// Compact copper checkbox (replaces std CheckBox blue accent).
export component LabCheck inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled;
    min-height: 36px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.copper : Theme.raised;
            border-width: 1px;
            border-color: root.checked ? Theme.copper : Theme.hairline;
            Text {
                text: root.checked ? "x" : "";
                color: Theme.on-copper;
                font-size: Theme.font-label;
                font-weight: 800;
                font-family: "Menlo";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.readout : Theme.faint;
            font-size: Theme.font-body;
            font-family: "Avenir Next";
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component CheckRow inherits Rectangle {
    in-out property <string> label;
    in-out property <string> hint: "";
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled;
    min-height: 52px;
    border-radius: Theme.radius-sm;
    background: root.checked ? Theme.rail-active : (ta.has-hover && root.enabled ? Theme.raised : transparent);
    border-width: 1px;
    border-color: root.checked ? Theme.unsigned-border : transparent;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Rectangle {
            width: 22px;
            height: 22px;
            y: 2px;
            border-radius: 5px;
            background: root.checked ? Theme.copper : Theme.raised;
            border-width: 1px;
            border-color: root.checked ? Theme.copper : Theme.hairline;
            Text {
                text: root.checked ? "x" : "";
                color: Theme.on-copper;
                font-size: Theme.font-label;
                font-weight: 800;
                font-family: "Menlo";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.readout;
                font-size: Theme.font-ui;
                font-weight: 600;
                font-family: "Avenir Next";
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.mute;
                font-size: Theme.font-caption;
                font-family: "Avenir Next";
                wrap: word-wrap;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component MetaRow inherits Rectangle {
    in-out property <string> caption;
    in-out property <string> value;
    in-out property <bool> copyable: false;
    in-out property <bool> ok: false;
    callback copy-clicked;
    min-height: 38px;
    border-radius: Theme.radius-sm;
    background: Theme.raised;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Text {
            text: root.caption;
            width: 96px;
            color: Theme.copper;
            font-size: Theme.font-caption;
            font-weight: 800;
            font-family: "Avenir Next";
            letter-spacing: 0.6px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.ok ? Theme.ok-glow : Theme.readout;
            font-size: Theme.font-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.copyable && root.value != "" && root.value != "(none)": Rectangle {
            width: 36px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: copy-ta.has-hover ? Theme.unsigned-well : Theme.raised;
            border-width: 1px;
            border-color: Theme.hairline;
            Text {
                text: "C";
                color: Theme.copper;
                font-size: Theme.font-label;
                font-weight: 800;
                font-family: "Menlo";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            copy-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.copy-clicked(); }
            }
        }
    }
}

export component EmptyHint inherits Rectangle {
    in-out property <string> title;
    in-out property <string> body: "";
    min-height: 132px;
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 4px;
            background: Theme.copper-dim;
            border-top-left-radius: Theme.radius;
            border-bottom-left-radius: Theme.radius;
        }
        VerticalLayout {
            padding: Theme.space-lg;
            spacing: 10px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.readout;
                font-size: Theme.font-ui;
                font-weight: 700;
                font-family: "Avenir Next";
                horizontal-alignment: center;
            }
            if root.body != "": Text {
                text: root.body;
                color: Theme.mute;
                font-size: Theme.font-body;
                font-family: "Avenir Next";
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

export component HelpTopic inherits Rectangle {
    in-out property <string> title;
    in-out property <string> body;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.card-shadow;
    drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: Theme.space-lg;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.copper;
            font-size: Theme.font-ui;
            font-weight: 800;
            font-family: "Avenir Next";
        }
        Text {
            text: root.body;
            color: Theme.readout;
            font-size: Theme.font-body;
            font-family: "Avenir Next";
            wrap: word-wrap;
        }
    }
}

export component CaseRow inherits Rectangle {
    in-out property <string> id;
    in-out property <string> title;
    in-out property <string> examiner;
    in-out property <string> state;
    in-out property <string> updated;
    in-out property <bool> active: false;
    callback clicked;
    height: 52px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.rail-active : (ta.has-hover ? Theme.raised : transparent);
    border-width: root.active ? 1px : 0;
    border-color: Theme.unsigned-border;
    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 4px;
            background: root.active ? Theme.copper : transparent;
            border-top-left-radius: Theme.radius-sm;
            border-bottom-left-radius: Theme.radius-sm;
        }
        HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        horizontal-stretch: 1;
        Text {
            text: root.id;
            width: 140px;
            color: root.active ? Theme.copper : Theme.readout;
            font-size: Theme.font-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.title;
            horizontal-stretch: 1;
            color: Theme.readout;
            font-size: Theme.font-ui;
            font-family: "Avenir Next";
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.examiner;
            width: 100px;
            color: Theme.mute;
            font-size: Theme.font-caption;
            font-family: "Avenir Next";
            vertical-alignment: center;
            overflow: elide;
        }
        StatusBadge {
            label: root.state;
            ok: root.state == "Acquire" || root.state == "Preserve";
            warn: root.state == "Identify";
        }
        Text {
            text: root.updated;
            width: 80px;
            color: Theme.faint;
            font-size: Theme.font-caption;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ResultRow inherits Rectangle {
    in-out property <string> name;
    in-out property <bool> ok: false;
    in-out property <string> detail: "";
    min-height: 48px;
    border-radius: Theme.radius-sm;
    background: root.ok ? Theme.ok-mist : Theme.deny-mist;
    border-width: 1px;
    border-color: root.ok ? Theme.ok-glow : #E8C4C4;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        StatusBadge {
            label: root.ok ? "PASS" : "FAIL";
            ok: root.ok;
            warn: !root.ok;
        }
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Theme.readout;
                font-size: Theme.font-ui;
                font-weight: 600;
                font-family: "Avenir Next";
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.mute;
                font-size: Theme.font-mono;
                font-family: "Menlo";
                wrap: word-wrap;
            }
        }
    }
}

export component LogLineRow inherits Rectangle {
    in-out property <string> level: "info";
    in-out property <string> text;
    min-height: 34px;
    border-radius: Theme.radius-sm;
    background: root.level == "err" ? Theme.deny-mist : (root.level == "ok" ? Theme.ok-mist : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        Text {
            text: root.level;
            width: 44px;
            color: root.level == "err" ? Theme.deny : (root.level == "ok" ? Theme.ok-glow : Theme.faint);
            font-size: Theme.font-caption;
            font-weight: 800;
            font-family: "Menlo";
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.readout;
            font-size: Theme.font-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
}

export component CoverageBar inherits Rectangle {
    in-out property <float> ok-frac: 0.0;
    in-out property <float> err-frac: 0.0;
    height: 14px;
    border-radius: 7px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.hairline;
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: parent.width * root.ok-frac;
        background: Theme.ok-glow;
        border-radius: 6px;
    }
    Rectangle {
        x: parent.width * root.ok-frac;
        y: 0;
        height: 100%;
        width: parent.width * root.err-frac;
        background: Theme.deny;
        border-radius: 6px;
    }
}

export component DraftBanner inherits Rectangle {
    in-out property <string> summary;
    callback resume-clicked;
    callback discard-clicked;
    background: Theme.unsigned-well;
    border-width: 1px;
    border-color: Theme.unsigned-border;
    border-radius: Theme.radius;
    drop-shadow-blur: 8px;
    drop-shadow-color: #AF622E18;
    drop-shadow-offset-y: 2px;
    HorizontalLayout {
        padding: Theme.space-md;
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            ZoneCaption { caption: Strings.draft-caption; }
            Text {
                text: root.summary;
                color: Theme.unsigned-text;
                font-size: Theme.font-ui;
                font-weight: 700;
                font-family: "Avenir Next";
                wrap: word-wrap;
            }
        }
        GhostBtn {
            label: Strings.draft-discard;
            horizontal-stretch: 0;
            min-width: 120px;
            clicked => { root.discard-clicked(); }
        }
        PrimaryBtn {
            label: Strings.draft-resume;
            horizontal-stretch: 0;
            min-width: 120px;
            clicked => { root.resume-clicked(); }
        }
    }
}
